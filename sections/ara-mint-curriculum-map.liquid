<script>
  (() => {
    const section = document.getElementById('AraMintCurriculum-{{ section.id }}');
    if (!section || section.dataset.ready === 'true') return;
    section.dataset.ready = 'true';

    const tabs = [...section.querySelectorAll('[data-level-target]')];
    const levels = [...section.querySelectorAll('[data-level]')];
    const toggles = [...section.querySelectorAll('[data-level-toggle]')];
    const filters = [...section.querySelectorAll('[data-domain]')];
    const concepts = [...section.querySelectorAll('[data-concept]')];
    const matrixRows = [...section.querySelectorAll('[data-matrix-domain]')];
    const search = section.querySelector('[data-curriculum-search]');

    const activateLevel = id => {
      tabs.forEach(tab => {
        const active = tab.dataset.levelTarget === id;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });

      levels.forEach(level => {
        const active = level.dataset.level === id;
        level.classList.toggle('is-open', active);
        const button = level.querySelector('[data-level-toggle]');
        if (button) button.setAttribute('aria-expanded', String(active));
      });

      const target = section.querySelector(`[data-level="${id}"]`);
      target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    tabs.forEach(tab => tab.addEventListener('click', () => activateLevel(tab.dataset.levelTarget)));

    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const level = toggle.closest('[data-level]');
        const open = !level.classList.contains('is-open');
        level.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      });
    });

    const applyFilters = () => {
      const activeDomain = filters.find(item => item.classList.contains('is-active'))?.dataset.domain || 'all';
      const term = (search?.value || '').trim().toLowerCase();

      concepts.forEach(concept => {
        const domainMatch = activeDomain === 'all' || concept.dataset.concept === activeDomain;
        const termMatch = !term || (concept.dataset.search || '').toLowerCase().includes(term) || (concept.closest('[data-level]')?.dataset.search || '').toLowerCase().includes(term);
        concept.hidden = !(domainMatch && termMatch);
      });

      levels.forEach(level => {
        const levelTermMatch = !term || (level.dataset.search || '').toLowerCase().includes(term);
        const visibleConcepts = [...level.querySelectorAll('[data-concept]')].some(item => !item.hidden);
        level.hidden = !(levelTermMatch || visibleConcepts);
        if (term && !level.hidden) level.classList.add('is-open');
      });

      matrixRows.forEach(row => row.hidden = activeDomain !== 'all' && row.dataset.matrixDomain !== activeDomain);
    };

    filters.forEach(filter => {
      filter.addEventListener('click', () => {
        filters.forEach(item => {
          const active = item === filter;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        applyFilters();
      });
    });

    search?.addEventListener('input', applyFilters);

    if (!tabs.some(tab => tab.classList.contains('is-active')) && tabs[0]) {
      tabs[0].classList.add('is-active');
      tabs[0].setAttribute('aria-selected', 'true');
      levels[0]?.classList.add('is-open');
      levels[0]?.querySelector('[data-level-toggle]')?.setAttribute('aria-expanded', 'true');
    }
  })();
</script>

