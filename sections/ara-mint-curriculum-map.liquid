<section
  id="AraMintCurriculum-{{ section.id }}"
  class="ara-mint-curriculum"
  style="
    --ara-mint-bg: {{ section.settings.background_color }};
    --ara-mint-paper: {{ section.settings.paper_color }};
    --ara-mint-ink: {{ section.settings.text_color }};
    --ara-mint-muted: {{ section.settings.muted_color }};
    --ara-mint-mint: {{ section.settings.mint_color }};
    --ara-mint-gold: {{ section.settings.gold_color }};
    --ara-mint-border: {{ section.settings.border_color }};
    --ara-mint-max: {{ section.settings.max_width }};
    --ara-mint-top: {{ section.settings.padding_top }}px;
    --ara-mint-bottom: {{ section.settings.padding_bottom }}px;
    --ara-mint-heading-desktop: {{ section.settings.desktop_heading_size }}px;
    --ara-mint-level-desktop: {{ section.settings.desktop_level_size }}px;
    --ara-mint-body-desktop: {{ section.settings.desktop_body_size }}px;
    --ara-mint-label-desktop: {{ section.settings.desktop_label_size }}px;
    --ara-mint-heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --ara-mint-level-mobile: {{ section.settings.mobile_level_size }}px;
    --ara-mint-body-mobile: {{ section.settings.mobile_body_size }}px;
    --ara-mint-label-mobile: {{ section.settings.mobile_label_size }}px;
  "
>
  <div class="ara-mint-curriculum__rules" aria-hidden="true"></div>

  <div class="ara-mint-curriculum__inner">
    <div class="ara-mint-curriculum__masthead">
      <img
        src="{{ 'mintmark-wordmark-ink.png' | asset_url }}"
        class="ara-mint-curriculum__wordmark"
        alt="Mintmark"
        width="488"
        height="88"
        loading="eager"
      >

      <div class="ara-mint-curriculum__masthead-center">
        <span>THE MINT</span>
        <small>CURRICULUM · SIX LEVELS · THIRTY-SIX CONCEPTS</small>
      </div>

      <img
        src="{{ 'mintmark-mint-emblem.png' | asset_url }}"
        class="ara-mint-curriculum__mint-emblem"
        alt=""
        width="270"
        height="183"
        loading="eager"
      >
    </div>

    <header class="ara-mint-curriculum__cover">
      <div class="ara-mint-curriculum__cover-copy">
        <div class="ara-mint-curriculum__folio">
          <span>THE MINTMARK CURRICULUM</span>
          <span>EDITION · 01</span>
        </div>

        {% if section.settings.eyebrow != blank %}
          <p class="ara-mint-curriculum__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1>{{ section.settings.heading | escape | newline_to_br }}</h1>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="ara-mint-curriculum__description">{{ section.settings.description }}</div>
        {% endif %}

        <div class="ara-mint-curriculum__strike-path">
          <div>
            <b>01</b>
            <span>{{ section.settings.progress_one | escape }}</span>
          </div>
          <i aria-hidden="true"></i>
          <div>
            <b>02</b>
            <span>{{ section.settings.progress_two | escape }}</span>
          </div>
          <i aria-hidden="true"></i>
          <div>
            <b>03</b>
            <span>{{ section.settings.progress_three | escape }}</span>
          </div>
        </div>
      </div>

      <div class="ara-mint-curriculum__coin-feature">
        <div class="ara-mint-curriculum__coin-head">
          <div>
            <span>THE COIN SYSTEM</span>
            <strong>METALS ARE THE CURRICULUM</strong>
          </div>
          <span class="ara-mint-curriculum__coin-folio">COMPANY COIN · SAMPLE</span>
        </div>

        <div class="ara-mint-curriculum__coin-stage">
          <img
            src="{{ 'mintmark-company-coin-nvda.png' | asset_url }}"
            alt="Mintmark company coin sample for Nvidia"
            class="ara-mint-curriculum__company-coin"
            width="802"
            height="741"
            loading="eager"
          >
          <img
            src="{{ 'mintmark-mark-transparent.png' | asset_url }}"
            alt=""
            class="ara-mint-curriculum__mark-watermark"
            width="250"
            height="251"
            loading="lazy"
          >
        </div>

        <div class="ara-mint-curriculum__coin-key">
          <span>ONE CELL = ONE CONCEPT</span>
          <span>METAL = TOPIC</span>
          <span>TREATMENT = DIFFICULTY</span>
        </div>
      </div>
    </header>

    <section class="ara-mint-curriculum__index" aria-label="Curriculum index">
      <div class="ara-mint-curriculum__section-heading">
        <div>
          <span>THE SIX LEVELS</span>
          <h2>From first principles to the corner office.</h2>
        </div>
        <p>Select a metal plate to open its six concepts. Each level keeps the supplied curriculum intact.</p>
      </div>

      <div class="ara-mint-curriculum__level-tabs" role="tablist" aria-label="Mint curriculum levels">
        {% for block in section.blocks %}
          <button
            type="button"
            class="ara-mint-curriculum__level-tab{% if block.settings.open_by_default %} is-active{% endif %}"
            data-level-target="{{ block.id }}"
            data-index="{{ forloop.index }}"
            role="tab"
            aria-selected="{% if block.settings.open_by_default %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="ara-mint-curriculum__metal-plate" aria-hidden="true">
              <span class="ara-mint-curriculum__metal-inner">
                <small>LEVEL</small>
                <strong>{{ block.settings.number | escape }}</strong>
                <em>{{ block.settings.metal | escape }}</em>
                <img src="{{ 'mintmark-mark-transparent.png' | asset_url }}" alt="" width="250" height="251" loading="lazy">
              </span>
            </span>
            <span class="ara-mint-curriculum__level-tab-copy">
              <small>{{ block.settings.status | escape }}</small>
              <strong>{{ block.settings.title | escape }}</strong>
              <span>{{ block.settings.subtitle | escape }}</span>
            </span>
          </button>
        {% endfor %}
      </div>
    </section>

    <section class="ara-mint-curriculum__tools">
      <div class="ara-mint-curriculum__filters" role="group" aria-label="Filter curriculum by business function">
        <button class="is-active" type="button" data-domain="all" aria-pressed="true">
          <span>ALL</span><small>36 CONCEPTS</small>
        </button>
        <button type="button" data-domain="raise" aria-pressed="false"><span>RAISE</span><small>CAPITAL</small></button>
        <button type="button" data-domain="build" aria-pressed="false"><span>BUILD</span><small>PRODUCT</small></button>
        <button type="button" data-domain="sell" aria-pressed="false"><span>SELL</span><small>CUSTOMER</small></button>
        <button type="button" data-domain="grow" aria-pressed="false"><span>GROW</span><small>TEAM</small></button>
        <button type="button" data-domain="allocate" aria-pressed="false"><span>ALLOCATE</span><small>CAPITAL</small></button>
        <button type="button" data-domain="defend" aria-pressed="false"><span>DEFEND</span><small>ADVANTAGE</small></button>
      </div>

      <label class="ara-mint-curriculum__search">
        <span>{{ section.settings.search_label | escape }}</span>
        <input
          type="search"
          placeholder="{{ section.settings.search_placeholder | escape }}"
          data-curriculum-search
          autocomplete="off"
        >
        {% if section.settings.search_note != blank %}<small>{{ section.settings.search_note | escape }}</small>{% endif %}
      </label>
    </section>

    <div class="ara-mint-curriculum__levels" data-levels>
      {% for block in section.blocks %}
        <article
          class="ara-mint-curriculum__level{% if block.settings.open_by_default %} is-open{% endif %}"
          data-level="{{ block.id }}"
          data-search="{{ block.settings.number | append: ' ' | append: block.settings.metal | append: ' ' | append: block.settings.title | append: ' ' | append: block.settings.subtitle | append: ' ' | append: block.settings.company_list | append: ' ' | append: block.settings.raise_title | append: ' ' | append: block.settings.raise_text | append: ' ' | append: block.settings.build_title | append: ' ' | append: block.settings.build_text | append: ' ' | append: block.settings.sell_title | append: ' ' | append: block.settings.sell_text | append: ' ' | append: block.settings.grow_title | append: ' ' | append: block.settings.grow_text | append: ' ' | append: block.settings.allocate_title | append: ' ' | append: block.settings.allocate_text | append: ' ' | append: block.settings.defend_title | append: ' ' | append: block.settings.defend_text | escape }}"
        >
          <div class="ara-mint-curriculum__level-head">
            <div class="ara-mint-curriculum__level-medal" data-index="{{ forloop.index }}">
              <div>
                <span>LEVEL</span>
                <strong>{{ block.settings.number | escape }}</strong>
                <small>{{ block.settings.metal | escape }}</small>
              </div>
            </div>

            <div class="ara-mint-curriculum__level-title">
              <span>{{ block.settings.status | escape }}</span>
              <h2>{{ block.settings.title | escape }}</h2>
              <p>{{ block.settings.subtitle | escape }}</p>
              {% if block.settings.company_count != blank or block.settings.company_list != blank %}
                <div class="ara-mint-curriculum__companies">
                  {% if block.settings.company_count != blank %}<strong>{{ block.settings.company_count | escape }}</strong>{% endif %}
                  {% if block.settings.company_list != blank %}<span>{{ block.settings.company_list | escape }}</span>{% endif %}
                </div>
              {% endif %}
            </div>

            <button type="button" class="ara-mint-curriculum__level-toggle" data-level-toggle="{{ block.id }}" aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}">
              <span>VIEW CONCEPTS</span>
              <b aria-hidden="true">+</b>
            </button>
          </div>

          <div class="ara-mint-curriculum__concepts">
            {% assign concepts = 'raise,build,sell,grow,allocate,defend' | split: ',' %}
            {% for concept in concepts %}
              {% capture title_key %}{{ concept }}_title{% endcapture %}
              {% capture text_key %}{{ concept }}_text{% endcapture %}
              {% assign concept_title = block.settings[title_key] %}
              {% assign concept_text = block.settings[text_key] %}
              <div class="ara-mint-curriculum__concept" data-concept="{{ concept }}" data-search="{{ concept | append: ' ' | append: concept_title | append: ' ' | append: concept_text | escape }}">
                <div class="ara-mint-curriculum__concept-cell ara-mint-curriculum__concept-cell--{{ concept }}" aria-hidden="true">
                  <span>{{ concept | slice: 0 | upcase }}</span>
                </div>
                <div>
                  <span class="ara-mint-curriculum__concept-label">{{ concept | upcase }}</span>
                  <h3>{{ concept_title | escape }}</h3>
                  <p>{{ concept_text | escape }}</p>
                </div>
              </div>
            {% endfor %}
          </div>
        </article>
      {% endfor %}
    </div>

    <section class="ara-mint-curriculum__matrix">
      <div class="ara-mint-curriculum__section-heading ara-mint-curriculum__section-heading--matrix">
        <div>
          <span>THE COMPLETE MATRIX</span>
          <h2>{{ section.settings.matrix_heading | escape }}</h2>
        </div>
        {% if section.settings.matrix_description != blank %}<p>{{ section.settings.matrix_description | escape }}</p>{% endif %}
      </div>

      <div class="ara-mint-curriculum__matrix-scroll">
        <table>
          <thead>
            <tr>
              <th>FUNCTION</th>
              {% for block in section.blocks %}
                <th><span>{{ block.settings.status | escape }}</span><strong>{{ block.settings.metal | escape }}</strong></th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% assign concepts = 'raise,build,sell,grow,allocate,defend' | split: ',' %}
            {% for concept in concepts %}
              <tr data-matrix-domain="{{ concept }}">
                <th>{{ concept | upcase }}</th>
                {% for block in section.blocks %}
                  {% capture title_key %}{{ concept }}_title{% endcapture %}
                  <td>{{ block.settings[title_key] | escape }}</td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if section.settings.matrix_footer != blank %}
        <p class="ara-mint-curriculum__matrix-footer">{{ section.settings.matrix_footer | escape }}</p>
      {% endif %}
    </section>
  </div>
</section>

<style>
  #AraMintCurriculum-{{ section.id }} {
    position: relative;
    overflow: hidden;
    padding: var(--ara-mint-top) 0 var(--ara-mint-bottom);
    background: var(--ara-mint-bg);
    color: var(--ara-mint-ink);
  }

  #AraMintCurriculum-{{ section.id }} * { box-sizing: border-box; }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__rules {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .62;
    background: repeating-linear-gradient(to bottom, transparent 0 35px, color-mix(in srgb, var(--ara-mint-mint) 46%, transparent) 35px 36px);
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__inner {
    position: relative;
    width: min(100%, var(--ara-mint-max));
    margin: 0 auto;
    padding: 0 38px;
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__masthead {
    display: grid;
    grid-template-columns: minmax(190px, 280px) 1fr minmax(110px, 180px);
    gap: 28px;
    align-items: center;
    min-height: 88px;
    padding: 14px 22px;
    border: 2px solid var(--ara-mint-ink);
    border-radius: 20px 20px 0 0;
    background: var(--ara-mint-paper);
    box-shadow: 7px 7px 0 var(--ara-mint-gold), 12px 12px 0 color-mix(in srgb, var(--ara-mint-mint) 75%, transparent);
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__wordmark {
    display: block;
    width: min(100%, 255px);
    height: auto;
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__masthead-center {
    display: grid;
    justify-items: center;
    gap: 4px;
    text-align: center;
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__masthead-center span,
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__masthead-center small,
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__folio span,
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__eyebrow,
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__section-heading > div > span,
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__concept-label {
    font-family: var(--font-body-family);
    font-size: var(--ara-mint-label-desktop);
    font-weight: 800;
    letter-spacing: .15em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__masthead-center span { color: var(--ara-mint-ink); }
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__masthead-center small { color: var(--ara-mint-muted); }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__mint-emblem {
    justify-self: end;
    display: block;
    width: min(100%, 150px);
    height: auto;
    filter: brightness(.72) saturate(.88);
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__cover {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(420px, 1.1fr);
    gap: 0;
    margin-top: 38px;
    border: 2px solid var(--ara-mint-ink);
    border-radius: 26px;
    overflow: hidden;
    background: var(--ara-mint-paper);
    box-shadow: 10px 10px 0 color-mix(in srgb, var(--ara-mint-mint) 75%, transparent);
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__cover-copy {
    position: relative;
    padding: 48px 46px 44px;
    border-right: 1px solid var(--ara-mint-border);
    background:
      linear-gradient(135deg, transparent 0 90%, color-mix(in srgb, var(--ara-mint-mint) 48%, transparent) 90% 100%),
      var(--ara-mint-paper);
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__cover-copy::after {
    content: "";
    position: absolute;
    right: 24px;
    bottom: 22px;
    width: 70px;
    height: 70px;
    border-right: 5px solid color-mix(in srgb, var(--ara-mint-mint) 85%, var(--ara-mint-ink));
    border-bottom: 5px solid color-mix(in srgb, var(--ara-mint-mint) 85%, var(--ara-mint-ink));
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__folio {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--ara-mint-border);
    color: var(--ara-mint-muted);
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__eyebrow {
    display: inline-flex;
    margin: 30px 0 0;
    padding: 10px 15px;
    border: 2px solid var(--ara-mint-ink);
    border-radius: 14px;
    background: var(--ara-mint-gold);
    box-shadow: 4px 4px 0 var(--ara-mint-ink);
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__cover h1 {
    max-width: 700px;
    margin: 24px 0 0;
    font-family: var(--font-heading-family);
    font-size: var(--ara-mint-heading-desktop);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    letter-spacing: -.055em;
    line-height: .94;
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__description {
    max-width: 620px;
    margin-top: 22px;
    color: var(--ara-mint-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-mint-body-desktop);
    line-height: 1.62;
  }
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__description p { margin: 0; }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__strike-path {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 10px;
    align-items: center;
    margin-top: 38px;
    padding-top: 20px;
    border-top: 1px dashed var(--ara-mint-border);
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__strike-path div { display: grid; gap: 6px; }
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__strike-path b {
    color: color-mix(in srgb, var(--ara-mint-mint) 50%, var(--ara-mint-ink));
    font-family: var(--font-heading-family);
    font-size: 20px;
  }
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__strike-path span {
    font-family: var(--font-body-family);
    font-size: calc(var(--ara-mint-label-desktop) + 1px);
    font-weight: 800;
    letter-spacing: .07em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__strike-path i { width: 28px; height: 1px; background: var(--ara-mint-gold); }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__coin-feature {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-width: 0;
    background: var(--ara-mint-ink);
    color: var(--ara-mint-paper);
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__coin-head {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: end;
    padding: 24px 28px 18px;
    border-bottom: 1px solid color-mix(in srgb, var(--ara-mint-mint) 65%, transparent);
  }
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__coin-head > div { display: grid; gap: 4px; }
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__coin-head span,
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__coin-head strong,
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__coin-key span {
    font-family: var(--font-body-family);
    font-size: var(--ara-mint-label-desktop);
    font-weight: 800;
    letter-spacing: .14em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__coin-head span { color: var(--ara-mint-mint); }
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__coin-head strong { color: var(--ara-mint-paper); }
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__coin-folio { color: var(--ara-mint-gold) !important; }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__coin-stage {
    position: relative;
    display: grid;
    min-height: 520px;
    place-items: center;
    overflow: hidden;
    padding: 32px;
    background:
      repeating-linear-gradient(to bottom, transparent 0 34px, color-mix(in srgb, var(--ara-mint-mint) 12%, transparent) 34px 35px),
      radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--ara-mint-mint) 13%, transparent), transparent 58%);
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__company-coin {
    position: relative;
    z-index: 2;
    display: block;
    width: min(100%, 430px);
    height: auto;
    filter: drop-shadow(0 18px 24px rgba(0,0,0,.28));
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__mark-watermark {
    position: absolute;
    right: -18px;
    bottom: -25px;
    width: 160px;
    height: auto;
    opacity: .10;
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__coin-key {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: color-mix(in srgb, var(--ara-mint-mint) 32%, transparent);
  }
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__coin-key span {
    padding: 14px 12px;
    background: var(--ara-mint-ink);
    color: color-mix(in srgb, var(--ara-mint-paper) 78%, transparent);
    text-align: center;
  }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__index { margin-top: 64px; }

  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, .65fr);
    gap: 44px;
    align-items: end;
    padding: 0 0 18px;
    border-bottom: 3px solid var(--ara-mint-ink);
  }
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__section-heading > div > span { color: color-mix(in srgb, var(--ara-mint-mint) 40%, var(--ara-mint-ink)); }
  #AraMintCurriculum-{{ section.id }} .ara-mint-curriculum__section-heading h2 {
    margin: 7px 0 0;
    font-family: var(--font-heading-family);
    font-size: clamp(34px, 4vw, 58px);
    font-weight: var(--font-heading-weight);
