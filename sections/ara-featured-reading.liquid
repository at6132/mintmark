<script>
  (function () {
    var sectionId = 'AraFeaturedReading-{{ section.id }}';

    function initializeAraFeaturedReading() {
      var section = document.getElementById(sectionId);

      if (!section) {
        return;
      }

      if (typeof section.araFeaturedReadingDestroy === 'function') {
        section.araFeaturedReadingDestroy();
      }

      var slider = section.querySelector('.ara-featured-reading__slider');
      var track = section.querySelector('.ara-featured-reading__track');
      var slides = section.querySelectorAll('.ara-featured-reading__slide');
      var dots = section.querySelectorAll('.ara-featured-reading__dot');
      var topPrevious = section.querySelector('.ara-featured-reading__control--prev');
      var topNext = section.querySelector('.ara-featured-reading__control--next');
      var bottomPrevious = section.querySelector('.ara-featured-reading__nav-button--prev');
      var bottomNext = section.querySelector('.ara-featured-reading__nav-button--next');
      var currentCounter = section.querySelector('.ara-featured-reading__counter b');

      if (!slider || !track || slides.length < 2) {
        return;
      }

      var currentIndex = 0;
      var autoplayTimer = null;
      var touchStartX = 0;
      var touchEndX = 0;
      var totalSlides = slides.length;
      var autoplayEnabled = slider.getAttribute('data-autoplay') === 'true';
      var autoplayDelay = parseInt(slider.getAttribute('data-autoplay-delay'), 10);
      var pauseOnHover = slider.getAttribute('data-pause-on-hover') === 'true';

      if (!autoplayDelay || autoplayDelay < 1000) {
        autoplayDelay = 6000;
      }

      function formatNumber(number) {
        return number < 10 ? '0' + number : String(number);
      }

      function stopAutoplay() {
        if (autoplayTimer !== null) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      function startAutoplay() {
        stopAutoplay();

        if (!autoplayEnabled || document.hidden) {
          return;
        }

        autoplayTimer = window.setInterval(function () {
          showSlide(currentIndex + 1, false);
        }, autoplayDelay);
      }

      function restartAutoplay() {
        if (autoplayEnabled) {
          startAutoplay();
        }
      }

      function showSlide(index, restartTimer) {
        var i;

        if (index < 0) {
          currentIndex = totalSlides - 1;
        } else if (index >= totalSlides) {
          currentIndex = 0;
        } else {
          currentIndex = index;
        }

        track.style.transform = 'translate3d(-' + (currentIndex * 100) + '%, 0, 0)';

        for (i = 0; i < slides.length; i += 1) {
          if (i === currentIndex) {
            slides[i].classList.add('is-active');
            slides[i].setAttribute('aria-hidden', 'false');
          } else {
            slides[i].classList.remove('is-active');
            slides[i].setAttribute('aria-hidden', 'true');
          }
        }

        for (i = 0; i < dots.length; i += 1) {
          if (i === currentIndex) {
            dots[i].classList.add('is-active');
            dots[i].setAttribute('aria-current', 'true');
          } else {
            dots[i].classList.remove('is-active');
            dots[i].setAttribute('aria-current', 'false');
          }
        }

        if (currentCounter) {
          currentCounter.textContent = formatNumber(currentIndex + 1);
        }

        if (restartTimer !== false) {
          restartAutoplay();
        }
      }

      function showPrevious() {
        showSlide(currentIndex - 1, true);
      }

      function showNext() {
        showSlide(currentIndex + 1, true);
      }

      function bindClick(element, callback) {
        if (element) {
          element.addEventListener('click', callback);
        }
      }

      function unbindClick(element, callback) {
        if (element) {
          element.removeEventListener('click', callback);
        }
      }

      bindClick(topPrevious, showPrevious);
      bindClick(topNext, showNext);
      bindClick(bottomPrevious, showPrevious);
      bindClick(bottomNext, showNext);

      var dotHandlers = [];

      for (var dotIndex = 0; dotIndex < dots.length; dotIndex += 1) {
        (function (index) {
          var handler = function () {
            showSlide(index, true);
          };

          dots[index].addEventListener('click', handler);
          dotHandlers.push({
            element: dots[index],
            handler: handler
          });
        })(dotIndex);
      }

      function handleTouchStart(event) {
        if (!event.touches || !event.touches.length) {
          return;
        }

        touchStartX = event.touches[0].clientX;
        touchEndX = touchStartX;
      }

      function handleTouchMove(event) {
        if (!event.touches || !event.touches.length) {
          return;
        }

        touchEndX = event.touches[0].clientX;
      }

      function handleTouchEnd() {
        var distance = touchEndX - touchStartX;

        if (Math.abs(distance) > 50) {
          if (distance < 0) {
            showNext();
          } else {
            showPrevious();
          }
        }

        touchStartX = 0;
        touchEndX = 0;
      }

      slider.addEventListener('touchstart', handleTouchStart, { passive: true });
      slider.addEventListener('touchmove', handleTouchMove, { passive: true });
      slider.addEventListener('touchend', handleTouchEnd);

      function handleMouseEnter() {
        if (pauseOnHover) {
          stopAutoplay();
        }
      }

      function handleMouseLeave() {
        if (pauseOnHover) {
          startAutoplay();
        }
      }

      if (pauseOnHover) {
        slider.addEventListener('mouseenter', handleMouseEnter);
        slider.addEventListener('mouseleave', handleMouseLeave);
      }

      function handleVisibilityChange() {
        if (document.hidden) {
          stopAutoplay();
        } else {
          startAutoplay();
        }
      }

      document.addEventListener('visibilitychange', handleVisibilityChange);

      function handleBlockSelect(event) {
        var selectedSlide = event.target.closest
          ? event.target.closest('.ara-featured-reading__slide')
          : null;

        if (!selectedSlide || !section.contains(selectedSlide)) {
          return;
        }

        stopAutoplay();
        showSlide(parseInt(selectedSlide.getAttribute('data-slide-index'), 10), false);
      }

      function handleBlockDeselect(event) {
        if (section.contains(event.target)) {
          startAutoplay();
        }
      }

      document.addEventListener('shopify:block:select', handleBlockSelect);
      document.addEventListener('shopify:block:deselect', handleBlockDeselect);

      section.araFeaturedReadingDestroy = function () {
        stopAutoplay();

        unbindClick(topPrevious, showPrevious);
        unbindClick(topNext, showNext);
        unbindClick(bottomPrevious, showPrevious);
        unbindClick(bottomNext, showNext);

        for (var i = 0; i < dotHandlers.length; i += 1) {
          dotHandlers[i].element.removeEventListener('click', dotHandlers[i].handler);
        }

        slider.removeEventListener('touchstart', handleTouchStart);
        slider.removeEventListener('touchmove', handleTouchMove);
        slider.removeEventListener('touchend', handleTouchEnd);

        if (pauseOnHover) {
          slider.removeEventListener('mouseenter', handleMouseEnter);
          slider.removeEventListener('mouseleave', handleMouseLeave);
        }

        document.removeEventListener('visibilitychange', handleVisibilityChange);
        document.removeEventListener('shopify:block:select', handleBlockSelect);
        document.removeEventListener('shopify:block:deselect', handleBlockDeselect);
      };

      showSlide(0, false);
      startAutoplay();
    }

    window.AraFeaturedReadingInitializers = window.AraFeaturedReadingInitializers || {};
    window.AraFeaturedReadingInitializers[sectionId] = initializeAraFeaturedReading;

    if (!window.AraFeaturedReadingSectionListenerAdded) {
      document.addEventListener('shopify:section:load', function (event) {
        var sections = [];

        if (
          event.target &&
          event.target.id &&
          event.target.id.indexOf('AraFeaturedReading-') === 0
        ) {
          sections.push(event.target);
        }

        if (event.target && event.target.querySelectorAll) {
          var nestedSections = event.target.querySelectorAll('[id^="AraFeaturedReading-"]');

          for (var i = 0; i < nestedSections.length; i += 1) {
            sections.push(nestedSections[i]);
          }
        }

        for (var sectionIndex = 0; sectionIndex < sections.length; sectionIndex += 1) {
          var loadedSectionId = sections[sectionIndex].id;
          var initializer = window.AraFeaturedReadingInitializers[loadedSectionId];

          if (typeof initializer === 'function') {
            initializer();
          }
        }
      });

      window.AraFeaturedReadingSectionListenerAdded = true;
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeAraFeaturedReading);
    } else {
      initializeAraFeaturedReading();
    }
  })();
</script>

