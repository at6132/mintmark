{% liquid
  assign real_slides = section.blocks.size
  assign min_slides = section.settings.min_slides | default: 0
  assign total_slides = real_slides
  if min_slides > real_slides
    assign total_slides = min_slides
  endif
  assign placeholder_count = total_slides | minus: real_slides
%}
<section
  id="AraFeaturedReading-{{ section.id }}"
  class="ara-featured-reading"
  data-section-id="{{ section.id }}"
  style="
    --ara-reading-bg: {{ section.settings.background_color }};
    --ara-reading-card: {{ section.settings.card_color }};
    --ara-reading-text: {{ section.settings.text_color }};
    --ara-reading-muted: {{ section.settings.muted_text_color }};
    --ara-reading-accent: {{ section.settings.accent_color }};
    --ara-reading-gold: {{ section.settings.gold_color }};
    --ara-reading-border: {{ section.settings.border_color }};
    --ara-reading-line: {{ section.settings.line_color }};
    --ara-reading-max: {{ section.settings.max_width }};
    --ara-reading-top: {{ section.settings.padding_top }}px;
    --ara-reading-bottom: {{ section.settings.padding_bottom }}px;
    --ara-reading-image-bg: {{ section.settings.image_background_color }};
    --ara-reading-card-height: {{ section.settings.card_height }}px;
    --ara-reading-label-size: {{ section.settings.desktop_section_label_size }}px;
    --ara-reading-time-size: {{ section.settings.desktop_reading_time_size }}px;
    --ara-reading-tag-size: {{ section.settings.desktop_tag_size }}px;
    --ara-reading-number-size: {{ section.settings.desktop_article_number_size }}px;
    --ara-reading-heading-size: {{ section.settings.desktop_heading_size }}px;
    --ara-reading-description-size: {{ section.settings.desktop_description_size }}px;
    --ara-reading-link-size: {{ section.settings.desktop_link_size }}px;
    --ara-reading-placeholder-size: {{ section.settings.desktop_placeholder_size }}px;
    --ara-reading-mobile-label-size: {{ section.settings.mobile_section_label_size }}px;
    --ara-reading-mobile-time-size: {{ section.settings.mobile_reading_time_size }}px;
    --ara-reading-mobile-tag-size: {{ section.settings.mobile_tag_size }}px;
    --ara-reading-mobile-number-size: {{ section.settings.mobile_article_number_size }}px;
    --ara-reading-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --ara-reading-mobile-description-size: {{ section.settings.mobile_description_size }}px;
    --ara-reading-mobile-link-size: {{ section.settings.mobile_link_size }}px;
    --ara-reading-mobile-placeholder-size: {{ section.settings.mobile_placeholder_size }}px;
  "
>
  <div class="ara-featured-reading__inner">
    <div class="ara-featured-reading__topbar">
      {% if section.settings.section_label != blank %}
        <p class="ara-featured-reading__section-label">
          {{ section.settings.section_label | escape }}
        </p>
      {% endif %}

      {% if total_slides > 1 %}
        <div class="ara-featured-reading__controls">
          <button
            type="button"
            class="ara-featured-reading__control ara-featured-reading__control--prev"
            aria-label="{{ section.settings.previous_label | escape }}"
          >
            {{ section.settings.previous_label | escape }}
          </button>

          <span class="ara-featured-reading__counter" aria-live="polite">
            <b>01</b>
            <span>/</span>
            <span>{{ total_slides | prepend: '0' | slice: -2, 2 }}</span>
          </span>

          <button
            type="button"
            class="ara-featured-reading__control ara-featured-reading__control--next"
            aria-label="{{ section.settings.next_label | escape }}"
          >
            {{ section.settings.next_label | escape }}
          </button>
        </div>
      {% endif %}
    </div>

    <div
      class="ara-featured-reading__slider"
      role="region"
      aria-label="{{ section.settings.section_label | default: 'Featured reading' | escape }}"
      data-autoplay="{{ section.settings.enable_autoplay }}"
      data-autoplay-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
      data-pause-on-hover="{{ section.settings.pause_on_hover }}"
    >
      <div class="ara-featured-reading__track">
        {% for block in section.blocks %}
          <article
            id="AraFeaturedReadingSlide-{{ block.id }}"
            class="ara-featured-reading__slide{% if forloop.first %} is-active{% endif %}"
            data-slide-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            <div class="ara-featured-reading__slide-meta">
              <span class="ara-featured-reading__slide-position">
                {{ forloop.index | prepend: '0' | slice: -2, 2 }}
              </span>

              {% if block.settings.reading_time != blank %}
                <span class="ara-featured-reading__reading-time">
                  {{ block.settings.reading_time | escape }}
                </span>
              {% endif %}
            </div>

            <div class="ara-featured-reading__card{% if block.settings.image_position == 'left' %} ara-featured-reading__card--image-left{% endif %}">
              <div class="ara-featured-reading__content">
                <div class="ara-featured-reading__tags">
                  {% if block.settings.ticker != blank %}
                    <span>{{ block.settings.ticker | escape }}</span>
                  {% endif %}

                  {% if block.settings.company != blank %}
                    <span>{{ block.settings.company | escape }}</span>
                  {% endif %}

                  {% if block.settings.domain != blank %}
                    <span>{{ block.settings.domain | escape }}</span>
                  {% endif %}
                </div>

                {% if block.settings.article_number != blank %}
                  <p class="ara-featured-reading__number">
                    {{ block.settings.article_number | escape }}
                  </p>
                {% endif %}

                {% if block.settings.heading != blank %}
                  <h2>{{ block.settings.heading | escape }}</h2>
                {% endif %}

                {% if block.settings.description != blank %}
                  <div class="ara-featured-reading__description">
                    {{ block.settings.description }}
                  </div>
                {% endif %}

                {% if block.settings.link_label != blank %}
                  <a
                    class="ara-featured-reading__link"
                    {% if block.settings.link != blank %}
                      href="{{ block.settings.link }}"
                    {% else %}
                      role="link"
                      aria-disabled="true"
                    {% endif %}
                  >
                    {{ block.settings.link_label | escape }}
                  </a>
                {% endif %}
              </div>

              <div class="ara-featured-reading__visual">
                {% if block.settings.image != blank %}
                  <picture>
                    {% if block.settings.mobile_image != blank %}
                      <source
                        media="(max-width: 749px)"
                        srcset="
                          {{ block.settings.mobile_image | image_url: width: 700 }} 700w,
                          {{ block.settings.mobile_image | image_url: width: 1000 }} 1000w,
                          {{ block.settings.mobile_image | image_url: width: 1400 }} 1400w
                        "
                      >
                    {% endif %}

                    {{
                      block.settings.image
                      | image_url: width: 2000
                      | image_tag:
                        widths: '700, 1000, 1300, 1600, 2000',
                        sizes: '(max-width: 899px) calc(100vw - 40px), 58vw',
                        loading: 'lazy',
                        class: 'ara-featured-reading__image',
                        alt: block.settings.image.alt
                    }}
                  </picture>
                {% else %}
                  <div class="ara-featured-reading__placeholder">
                    <span>{{ block.settings.placeholder_label | escape }}</span>
                  </div>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}

        {% if placeholder_count > 0 %}
          {% for i in (1..placeholder_count) %}
            {% assign slot_num = real_slides | plus: forloop.index %}
            <article
              class="ara-featured-reading__slide ara-featured-reading__slide--placeholder{% if real_slides == 0 and forloop.first %} is-active{% endif %}"
              data-slide-index="{{ slot_num | minus: 1 }}"
            >
              <div class="ara-featured-reading__slide-meta">
                <span class="ara-featured-reading__slide-position">{{ slot_num | prepend: '0' | slice: -2, 2 }}</span>
                <span class="ara-featured-reading__reading-time">{{ section.settings.placeholder_reading_time | default: 'Coming soon' | escape }}</span>
              </div>
              <div class="ara-featured-reading__card">
                <div class="ara-featured-reading__content">
                  <div class="ara-featured-reading__tags"><span>{{ section.settings.placeholder_tag | default: 'Reserved' | escape }}</span></div>
                  <p class="ara-featured-reading__number">{{ slot_num | prepend: '0' | slice: -2, 2 }}</p>
                  <h2>{{ section.settings.placeholder_heading | default: 'Featured story coming soon' | escape }}</h2>
                  <div class="ara-featured-reading__description"><p>{{ section.settings.placeholder_text | default: 'This slot is reserved for an upcoming featured read.' | escape }}</p></div>
                </div>
                <div class="ara-featured-reading__visual">
                  <div class="ara-featured-reading__placeholder"><span>{{ section.settings.placeholder_slide_label | default: 'Coming soon' | escape }}</span></div>
                </div>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>

      {% if total_slides > 1 %}
        <div class="ara-featured-reading__navigation">
          <button
            type="button"
            class="ara-featured-reading__nav-button ara-featured-reading__nav-button--prev"
            aria-label="{{ section.settings.previous_label | escape }}"
          >
            <span class="ara-featured-reading__arrow ara-featured-reading__arrow--left" aria-hidden="true"></span>
          </button>

          {% if section.settings.show_pagination %}
            <div class="ara-featured-reading__pagination" aria-label="Featured reading slides">
              {% for block in section.blocks %}
                <button
                  type="button"
                  class="ara-featured-reading__dot{% if forloop.first %} is-active{% endif %}"
                  data-slide-to="{{ forloop.index0 }}"
                  aria-label="Go to slide {{ forloop.index }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                ></button>
              {% endfor %}
              {% if placeholder_count > 0 %}
                {% for i in (1..placeholder_count) %}
                  {% assign dot_idx = real_slides | plus: forloop.index0 %}
                  <button
                    type="button"
                    class="ara-featured-reading__dot{% if real_slides == 0 and forloop.first %} is-active{% endif %}"
                    data-slide-to="{{ dot_idx }}"
                    aria-label="Go to slide {{ real_slides | plus: forloop.index }}"
                    aria-current="{% if real_slides == 0 and forloop.first %}true{% else %}false{% endif %}"
                  ></button>
                {% endfor %}
              {% endif %}
            </div>
          {% endif %}

          <button
            type="button"
            class="ara-featured-reading__nav-button ara-featured-reading__nav-button--next"
            aria-label="{{ section.settings.next_label | escape }}"
          >
            <span class="ara-featured-reading__arrow ara-featured-reading__arrow--right" aria-hidden="true"></span>
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #AraFeaturedReading-{{ section.id }} {
    overflow: hidden;
    border-bottom: 1px solid var(--ara-reading-border);
    background-color: var(--ara-reading-bg);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 34px,
      color-mix(in srgb, var(--ara-reading-line) 18%, transparent) 34px,
      color-mix(in srgb, var(--ara-reading-line) 18%, transparent) 35px
    );
    color: var(--ara-reading-text);
  }

  #AraFeaturedReading-{{ section.id }} * {
    box-sizing: border-box;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__inner {
    width: min(100%, var(--ara-reading-max));
    margin: 0 auto;
    padding: var(--ara-reading-top) 40px var(--ara-reading-bottom);
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__topbar {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    margin-bottom: 18px;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__section-label,
  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__counter,
  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__slide-meta {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    text-transform: uppercase;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__section-label {
    margin: 0;
    color: var(--ara-reading-accent);
    font-size: var(--ara-reading-label-size);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.14em;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__controls {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__control {
    padding: 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: var(--ara-reading-accent);
    cursor: pointer;
    font-size: var(--ara-reading-link-size);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.12em;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__control:hover,
  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__control:focus-visible {
    border-color: currentColor;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__controls {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__control {
    padding: 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: var(--ara-reading-accent);
    cursor: pointer;
    font-family: var(--font-body-family);
    font-size: var(--ara-reading-link-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__control:hover,
  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__control:focus-visible {
    border-color: currentColor;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__counter {
    display: flex;
    gap: 5px;
    align-items: baseline;
    color: var(--ara-reading-muted);
    font-size: var(--ara-reading-time-size);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__counter b {
    color: var(--ara-reading-text);
    font-weight: 800;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__slider {
    position: relative;
    overflow: hidden;
    touch-action: pan-y;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__track {
    display: flex;
    width: 100%;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 0;
    opacity: 0.45;
    transition: opacity 0.35s ease;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__slide.is-active {
    opacity: 1;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__slide-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
    margin-bottom: 12px;
    color: var(--ara-reading-muted);
    font-size: var(--ara-reading-time-size);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.12em;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__slide-position {
    color: var(--ara-reading-gold);
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__card {
    display: grid;
    grid-template-columns: minmax(320px, 0.78fr) minmax(0, 1.22fr);
    min-height: var(--ara-reading-card-height);
    border: 1px solid var(--ara-reading-border);
    border-radius: 14px;
    overflow: hidden;
    background: color-mix(in srgb, var(--ara-reading-card) 95%, transparent);
    box-shadow: 0 12px 30px rgba(22, 27, 46, 0.07);
    transition: box-shadow 0.35s ease, transform 0.35s ease;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__slide.is-active .ara-featured-reading__card {
    box-shadow: 0 20px 46px rgba(22, 27, 46, 0.13);
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__slide--placeholder .ara-featured-reading__card {
    border-style: dashed;
    box-shadow: none;
    background: transparent;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__slide--placeholder h2,
  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__slide--placeholder .ara-featured-reading__number {
    color: var(--ara-reading-muted);
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__card--image-left {
    grid-template-columns: minmax(0, 1.22fr) minmax(320px, 0.78fr);
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__card--image-left .ara-featured-reading__content {
    order: 2;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__card--image-left .ara-featured-reading__visual {
    order: 1;
    border-right: 1px solid var(--ara-reading-border);
    border-left: 0;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(34px, 5vw, 74px);
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    align-items: center;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__tags span {
    padding-right: 9px;
    border-right: 1px solid var(--ara-reading-border);
    color: var(--ara-reading-accent);
    font-family: var(--font-body-family);
    font-size: var(--ara-reading-tag-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__tags span:last-child {
    padding-right: 0;
    border-right: 0;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__number {
    margin: 24px 0 0;
    color: var(--ara-reading-gold);
    font-family: var(--font-body-family);
    font-size: var(--ara-reading-number-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__content h2 {
    max-width: 680px;
    margin: 16px 0 0;
    color: var(--ara-reading-text);
    font-family: var(--font-heading-family);
    font-size: var(--ara-reading-heading-size);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__description {
    max-width: 560px;
    margin-top: 22px;
    color: var(--ara-reading-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-reading-description-size);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.65;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__description p {
    margin: 0;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__link {
    display: inline-flex;
    align-self: flex-start;
    margin-top: 28px;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--ara-reading-accent);
    color: var(--ara-reading-text);
    font-family: var(--font-body-family);
    font-size: var(--ara-reading-link-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.13em;
    text-decoration: none;
    text-transform: uppercase;
    transition: border-bottom-color 0.2s ease, gap 0.2s ease;
    gap: 6px;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__link::after {
    content: '→';
    display: inline-block;
    transition: transform 0.2s ease;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__link:hover {
    border-bottom-color: var(--ara-reading-gold);
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__link:hover::after {
    transform: translateX(5px);
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__visual {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: var(--ara-reading-card-height);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-left: 1px solid var(--ara-reading-border);
    background: var(--ara-reading-image-bg);
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__visual picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: var(--ara-reading-card-height);
    object-fit: cover;
    object-position: center;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__placeholder {
    display: grid;
    width: 100%;
    min-height: var(--ara-reading-card-height);
    place-items: center;
    padding: 24px;
    background:
      radial-gradient(circle at 50% 52%, rgba(23, 109, 92, 0.13), transparent 23%),
      linear-gradient(135deg, rgba(224, 165, 38, 0.12), rgba(23, 109, 92, 0.08)),
      var(--ara-reading-card);
    color: var(--ara-reading-accent);
    font-family: var(--font-body-family);
    font-size: var(--ara-reading-placeholder-size);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__navigation {
    display: flex;
    gap: 18px;
    justify-content: center;
    align-items: center;
    margin-top: 24px;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__pagination {
    display: flex;
    gap: 8px;
    justify-content: center;
    align-items: center;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__nav-button {
    display: grid;
    width: 58px;
    height: 58px;
    flex: 0 0 58px;
    place-items: center;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--ara-reading-border) 88%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--ara-reading-card) 96%, transparent);
    color: var(--ara-reading-text);
    cursor: pointer;
    box-shadow: 0 8px 22px rgba(22, 27, 46, 0.08);
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__arrow {
    display: block;
    width: 12px;
    height: 12px;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__arrow--left {
    margin-left: 5px;
    transform: rotate(-135deg);
  }

  #AraFeaturedReading-{{ section.id }} .ara-featured-reading__arrow--right {
    margin-right: 5px;
