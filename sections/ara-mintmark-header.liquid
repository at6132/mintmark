<header
  id="AraMintmarkHeader-{{ section.id }}"
  class="ara-mintmark-header{% if section.settings.sticky_header %} ara-mintmark-header--sticky{% endif %}"
  style="
    --ara-header-bg: {{ section.settings.background_color }};
    --ara-header-paper: {{ section.settings.paper_color }};
    --ara-header-text: {{ section.settings.text_color }};
    --ara-header-muted: {{ section.settings.subtitle_color }};
    --ara-header-accent: {{ section.settings.accent_color }};
    --ara-header-gold: {{ section.settings.gold_color }};
    --ara-header-blue: {{ section.settings.blue_color }};
    --ara-header-rule: {{ section.settings.rule_color }};
    --ara-header-border: {{ section.settings.border_color }};
    --ara-header-max: {{ section.settings.max_width }};
    --ara-header-padding: {{ section.settings.vertical_padding }}px;
    --ara-logo-width: {{ section.settings.logo_width }}px;
    --ara-logo-mobile-width: {{ section.settings.mobile_logo_width }}px;
    --ara-header-nav-size: {{ section.settings.desktop_nav_size }}px;
    --ara-header-subtitle-size: {{ section.settings.desktop_subtitle_size }}px;
    --ara-header-mobile-nav-size: {{ section.settings.mobile_nav_size }}px;
    --ara-header-mobile-subtitle-size: {{ section.settings.mobile_subtitle_size }}px;
  "
>
  <div class="ara-mintmark-header__inner">
    <a
      href="{{ routes.root_url }}"
      class="ara-mintmark-header__logo"
      aria-label="{{ shop.name | escape }}"
    >
      {% if section.settings.logo != blank %}
        <picture>
          {% if section.settings.mobile_logo != blank %}
            <source
              media="(max-width: 989px)"
              srcset="
                {{ section.settings.mobile_logo | image_url: width: 280 }} 280w,
                {{ section.settings.mobile_logo | image_url: width: 420 }} 420w,
                {{ section.settings.mobile_logo | image_url: width: 620 }} 620w
              "
            >
          {% endif %}

          <img
            src="{{ section.settings.logo | image_url: width: 900 }}"
            srcset="
              {{ section.settings.logo | image_url: width: 220 }} 220w,
              {{ section.settings.logo | image_url: width: 320 }} 320w,
              {{ section.settings.logo | image_url: width: 440 }} 440w,
              {{ section.settings.logo | image_url: width: 620 }} 620w,
              {{ section.settings.logo | image_url: width: 900 }} 900w
            "
            sizes="(max-width: 989px) var(--ara-logo-mobile-width), var(--ara-logo-width)"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            loading="eager"
            fetchpriority="high"
            class="ara-mintmark-header__logo-image"
            alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
          >
        </picture>
      {% else %}
        <span class="ara-mintmark-header__logo-fallback">
          {{ shop.name | escape }}
        </span>
      {% endif %}
    </a>

    <nav
      class="ara-mintmark-header__desktop-nav"
      aria-label="Main navigation"
    >
      {% for block in section.blocks %}
        <a
          class="ara-mintmark-header__nav-link"
          {% if block.settings.link != blank %}
            href="{{ block.settings.link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <span class="ara-mintmark-header__nav-index">
            {{ forloop.index | prepend: '0' }}
          </span>

          <span class="ara-mintmark-header__nav-copy">
            <span class="ara-mintmark-header__nav-title">
              {{ block.settings.title | escape }}
            </span>

            {% if block.settings.subtitle != blank %}
              <span class="ara-mintmark-header__nav-subtitle">
                {{ block.settings.subtitle | escape }}
              </span>
            {% endif %}
          </span>
        </a>
      {% endfor %}
    </nav>

    <div class="ara-mintmark-header__actions">
      {% if section.settings.action_label != blank %}
        <a
          class="ara-mintmark-header__action-link"
          {% if section.settings.action_link != blank %}
            href="{{ section.settings.action_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.action_label | escape }}
        </a>
      {% endif %}

      <a
        href="{{ routes.cart_url }}"
        class="ara-mintmark-header__cart"
        aria-label="Cart"
      >
        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" />
          <line x1="3" y1="6" x2="21" y2="6" />
          <path d="M16 10a4 4 0 01-8 0" />
        </svg>

        {% if cart.item_count > 0 %}
          <span class="ara-mintmark-header__cart-count">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>

      <button
        type="button"
        class="ara-mintmark-header__menu-button"
        aria-expanded="false"
        aria-controls="AraMintmarkMobileMenu-{{ section.id }}"
        aria-label="Open menu"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div
    id="AraMintmarkMobileMenu-{{ section.id }}"
    class="ara-mintmark-header__mobile-menu"
    hidden
  >
    <div class="ara-mintmark-header__mobile-menu-inner">
      <div class="ara-mintmark-header__mobile-topline">
        <span>{{ section.settings.mobile_menu_label | escape }}</span>

        {% if section.settings.mobile_menu_note != blank %}
          <small>{{ section.settings.mobile_menu_note | escape }}</small>
        {% endif %}
      </div>

      <div class="ara-mintmark-header__mobile-links">
        {% for block in section.blocks %}
          <a
            class="ara-mintmark-header__mobile-link"
            {% if block.settings.link != blank %}
              href="{{ block.settings.link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            <span class="ara-mintmark-header__mobile-index">
              {{ forloop.index | prepend: '0' }}
            </span>

            <span class="ara-mintmark-header__mobile-copy">
              <span>{{ block.settings.title | escape }}</span>

              {% if block.settings.subtitle != blank %}
                <small>{{ block.settings.subtitle | escape }}</small>
              {% endif %}
            </span>
          </a>
        {% endfor %}
      </div>

      {% if section.settings.action_label != blank %}
        <a
          class="ara-mintmark-header__mobile-action"
          {% if section.settings.action_link != blank %}
            href="{{ section.settings.action_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.action_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</header>

<style>
  #AraMintmarkHeader-{{ section.id }} {
    position: relative;
    z-index: 40;
    background: var(--ara-header-bg);
    color: var(--ara-header-text);
  }

  #AraMintmarkHeader-{{ section.id }} * {
    box-sizing: border-box;
  }

  #AraMintmarkHeader-{{ section.id }}.ara-mintmark-header--sticky {
    position: sticky;
    top: 0;
  }

  #AraMintmarkHeader-{{ section.id }}::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 4px;
    border-top: 1px solid var(--ara-header-rule);
    border-bottom: 1px solid var(--ara-header-rule);
    pointer-events: none;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__inner {
    display: grid;
    grid-template-columns: minmax(210px, 0.65fr) minmax(560px, 1.55fr) auto;
    gap: clamp(24px, 3vw, 48px);
    align-items: center;
    width: min(100%, var(--ara-header-max));
    margin: 0 auto;
    padding: var(--ara-header-padding) 40px calc(var(--ara-header-padding) + 4px);
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__logo {
    display: inline-flex;
    justify-self: start;
    width: min(100%, var(--ara-logo-width));
    color: inherit;
    text-decoration: none;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__logo picture {
    display: block;
    width: 100%;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__logo-image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 64px;
    object-fit: contain;
    object-position: left center;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__logo-fallback {
    color: var(--ara-header-text);
    font-family: var(--font-heading-family);
    font-size: clamp(31px, 3vw, 48px);
    font-style: var(--font-heading-style);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__desktop-nav {
    display: flex;
    min-width: 0;
    align-items: stretch;
    justify-content: center;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__nav-link {
    position: relative;
    display: grid;
    grid-template-columns: 25px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    min-width: 128px;
    padding: 10px 18px;
    color: var(--ara-header-text);
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__nav-link + .ara-mintmark-header__nav-link {
    border-left: 1px solid var(--ara-header-border);
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__nav-link::after {
    content: "";
    position: absolute;
    right: 18px;
    bottom: 5px;
    left: 53px;
    height: 2px;
    background: var(--ara-header-accent);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__nav-link:hover {
    background: color-mix(in srgb, var(--ara-header-paper) 76%, transparent);
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__nav-link:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__nav-index {
    display: grid;
    width: 25px;
    height: 25px;
    place-items: center;
    border: 1px solid var(--ara-header-accent);
    border-radius: 50%;
    color: var(--ara-header-accent);
    font-family: var(--font-body-family);
    font-size: 8px;
    font-weight: 800;
    line-height: 1;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__nav-copy {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__nav-title {
    font-family: var(--font-body-family);
    font-size: var(--ara-header-nav-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__nav-subtitle {
    overflow: hidden;
    color: var(--ara-header-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-header-subtitle-size);
    font-style: var(--font-body-style);
    font-weight: 700;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__actions {
    display: flex;
    justify-self: end;
    gap: 11px;
    align-items: center;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__action-link {
    display: inline-flex;
    min-height: 41px;
    align-items: center;
    justify-content: center;
    padding: 9px 15px;
    border: 1px solid var(--ara-header-text);
    border-radius: 7px;
    background: var(--ara-header-paper);
    color: var(--ara-header-text);
    font-family: var(--font-body-family);
    font-size: var(--ara-header-nav-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.11em;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 3px 3px 0 var(--ara-header-gold);
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__action-link:hover {
    background: var(--ara-header-gold);
    box-shadow: 3px 3px 0 var(--ara-header-text);
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__cart {
    position: relative;
    display: grid;
    width: 43px;
    height: 43px;
    place-items: center;
    border: 2px solid var(--ara-header-text);
    border-radius: 50%;
    background: var(--ara-header-blue);
    color: #FFFFFF;
    text-decoration: none;
    box-shadow: 3px 3px 0 var(--ara-header-text);
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__cart-count {
    position: absolute;
    top: -6px;
    right: -6px;
    display: grid;
    min-width: 19px;
    height: 19px;
    place-items: center;
    padding: 0 4px;
    border: 1px solid var(--ara-header-text);
    border-radius: 999px;
    background: var(--ara-header-gold);
    color: var(--ara-header-text);
    font-family: var(--font-body-family);
    font-size: 8px;
    font-weight: 800;
    line-height: 1;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__menu-button {
    display: none;
    width: 43px;
    height: 43px;
    padding: 0;
    border: 2px solid var(--ara-header-text);
    border-radius: 8px;
    background: var(--ara-header-gold);
    box-shadow: 3px 3px 0 var(--ara-header-text);
    cursor: pointer;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__menu-button span {
    display: block;
    width: 21px;
    height: 2px;
    margin: 5px auto;
    background: var(--ara-header-text);
    transition: transform 0.2s ease;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__menu-button[aria-expanded="true"] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__menu-button[aria-expanded="true"] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__mobile-menu {
    border-bottom: 2px solid var(--ara-header-rule);
    background:
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 34px,
        color-mix(in srgb, var(--ara-header-rule) 18%, transparent) 34px,
        color-mix(in srgb, var(--ara-header-rule) 18%, transparent) 35px
      ),
      var(--ara-header-bg);
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__mobile-menu-inner {
    display: grid;
    gap: 22px;
    padding: 24px 20px 32px;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__mobile-topline {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-start;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--ara-header-border);
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__mobile-topline span,
  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__mobile-topline small {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    line-height: 1.2;
    text-transform: uppercase;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__mobile-topline span {
    font-size: var(--ara-header-mobile-subtitle-size);
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__mobile-topline small {
    color: var(--ara-header-muted);
    font-size: var(--ara-header-mobile-subtitle-size);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: right;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__mobile-links {
    display: grid;
    border-top: 1px solid var(--ara-header-border);
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__mobile-link {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding: 17px 0;
    border-bottom: 1px solid var(--ara-header-border);
    color: var(--ara-header-text);
    text-decoration: none;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__mobile-index {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid var(--ara-header-accent);
    border-radius: 50%;
    color: var(--ara-header-accent);
    font-family: var(--font-body-family);
    font-size: var(--ara-header-mobile-subtitle-size);
    font-weight: 800;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__mobile-copy {
    display: grid;
    gap: 5px;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__mobile-copy > span {
    font-family: var(--font-heading-family);
    font-size: var(--ara-header-mobile-nav-size);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 1;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__mobile-copy small {
    color: var(--ara-header-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-header-mobile-subtitle-size);
    font-style: var(--font-body-style);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__mobile-action {
    display: inline-flex;
    width: 100%;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border: 2px solid var(--ara-header-text);
    border-radius: 8px;
    background: var(--ara-header-gold);
    color: var(--ara-header-text);
    font-family: var(--font-body-family);
    font-size: var(--ara-header-mobile-subtitle-size);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 var(--ara-header-text);
  }

  @media screen and (max-width: 1320px) {
    #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__inner {
      grid-template-columns: minmax(195px, 0.55fr) minmax(0, 1fr) auto;
      gap: 18px;
    }

    #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__nav-link {
      min-width: 110px;
      padding-right: 12px;
      padding-left: 12px;
    }

    #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__action-link {
      display: none;
    }
  }

  @media screen and (max-width: 989px) {
    #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 16px;
      padding-right: 20px;
      padding-left: 20px;
    }

    #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__logo {
      width: min(100%, var(--ara-logo-mobile-width));
    }

    #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__logo-image {
      max-height: 52px;
    }

    #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__desktop-nav {
      display: none;
    }

    #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__actions {
      gap: 8px;
    }

    #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__menu-button {
      display: block;
    }
  }

  @media screen and (max-width: 480px) {
    #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__cart,
    #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__menu-button {
      width: 39px;
      height: 39px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__nav-link,
    #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__nav-link::after,
    #AraMintmarkHeader-{{ section.id }} .ara-mintmark-header__menu-button span {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const header = document.getElementById('AraMintmarkHeader-{{ section.id }}');

    if (!header || header.dataset.ready === 'true') return;

    header.dataset.ready = 'true';

    const button = header.querySelector('.ara-mintmark-header__menu-button');
    const menu = header.querySelector('.ara-mintmark-header__mobile-menu');
    const links = header.querySelectorAll(
      '.ara-mintmark-header__mobile-link, .ara-mintmark-header__mobile-action'
    );

    if (!button || !menu) return;

    const closeMenu = () => {
      button.setAttribute('aria-expanded', 'false');
      button.setAttribute('aria-label', 'Open menu');
      menu.hidden = true;
    };

    button.addEventListener('click', () => {
      const isOpen = button.getAttribute('aria-expanded') === 'true';

      button.setAttribute('aria-expanded', String(!isOpen));
      button.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
      menu.hidden = isOpen;
    });

    links.forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') closeMenu();
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 989) closeMenu();
    });
  })();
</script>

{% schema %}
{
  "name": "Ara Mintmark Header",
  "max_blocks": 6,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Sticky header",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Desktop main logo"
    },
    {
      "type": "image_picker",
      "id": "mobile_logo",
      "label": "Mobile stacked logo"
    },
    {
      "type": "text",
      "id": "action_label",
      "label": "Header button text",
      "default": "EXPLORE MINTMARK"
    },
    {
      "type": "url",
      "id": "action_link",
      "label": "Header button link"
