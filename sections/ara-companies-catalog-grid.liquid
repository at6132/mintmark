<section
  id="AraCompanyCatalog-{{ section.id }}"
  class="ara-company-catalog"
  style="
    --ara-cc-bg: {{ section.settings.background_color }};
    --ara-cc-card: {{ section.settings.card_color }};
    --ara-cc-text: {{ section.settings.text_color }};
    --ara-cc-muted: {{ section.settings.muted_text_color }};
    --ara-cc-line: {{ section.settings.line_color }};
    --ara-cc-border: {{ section.settings.border_color }};
    --ara-cc-positive: {{ section.settings.positive_color }};
    --ara-cc-negative: {{ section.settings.negative_color }};
    --ara-cc-neutral: {{ section.settings.neutral_color }};
    --ara-cc-gold: {{ section.settings.gold_color }};
    --ara-cc-max: {{ section.settings.max_width }};
    --ara-cc-columns: {{ section.settings.desktop_columns }};
    --ara-cc-top: {{ section.settings.padding_top }}px;
    --ara-cc-bottom: {{ section.settings.padding_bottom }}px;
    --ara-cc-heading-desktop: {{ section.settings.desktop_heading_size }}px;
    --ara-cc-category-desktop: {{ section.settings.desktop_category_size }}px;
    --ara-cc-company-desktop: {{ section.settings.desktop_company_size }}px;
    --ara-cc-meta-desktop: {{ section.settings.desktop_meta_size }}px;
    --ara-cc-heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --ara-cc-category-mobile: {{ section.settings.mobile_category_size }}px;
    --ara-cc-company-mobile: {{ section.settings.mobile_company_size }}px;
    --ara-cc-meta-mobile: {{ section.settings.mobile_meta_size }}px;
  "
>
  <div class="ara-company-catalog__inner">
    <div class="ara-company-catalog__brand-masthead">
      <div class="ara-company-catalog__brand-lockup">
        <img
          src="{{ 'mintmark-wordmark-ink.png' | asset_url }}"
          alt="Mintmark"
          width="488"
          height="88"
          loading="eager"
        >
      </div>
      <div class="ara-company-catalog__brand-index">
        <span>COMPANY CATALOG</span>
        <small>REAL COMPANIES · COMPANY FILES · PHYSICAL DIGESTS</small>
      </div>
      <img
        class="ara-company-catalog__brand-mark"
        src="{{ 'mintmark-mark-app.png' | asset_url }}"
        alt=""
        width="285"
        height="285"
        loading="eager"
      >
    </div>
    {% if section.settings.show_intro %}
      <div class="ara-company-catalog__intro">
        <div>
          {% if section.settings.eyebrow != blank %}
            <span class="ara-company-catalog__eyebrow">
              {{ section.settings.eyebrow | escape }}
            </span>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h1>{{ section.settings.heading | escape | newline_to_br }}</h1>
          {% endif %}
        </div>

        {% if section.settings.description != blank %}
          <div class="ara-company-catalog__description">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.show_search or section.settings.show_filters %}
      <div class="ara-company-catalog__tools">
        {% if section.settings.show_search %}
          <label class="ara-company-catalog__search">
            <span>{{ section.settings.search_label | escape }}</span>
            <input
              type="search"
              placeholder="{{ section.settings.search_placeholder | escape }}"
              autocomplete="off"
              data-company-search
            >
          </label>
        {% endif %}

        {% if section.settings.show_filters %}
          <div class="ara-company-catalog__filters" aria-label="Company category filters">
            <button
              type="button"
              class="ara-company-catalog__filter is-active"
              data-company-filter="all"
              aria-pressed="true"
            >
              {{ section.settings.all_filter_label | escape }}
            </button>

            {% assign filter_values = 'classics,technology,consumer,industrials,food-beverage,financials,healthcare,energy,retail,other' | split: ',' %}

            {% for filter_value in filter_values %}
              {% assign filter_count = 0 %}

              {% for block in section.blocks %}
                {% if block.settings.sector == filter_value %}
                  {% assign filter_count = filter_count | plus: 1 %}
                {% endif %}
              {% endfor %}

              {% if filter_count > 0 %}
                {% case filter_value %}
                  {% when 'classics' %}
                    {% assign filter_label = section.settings.classics_label %}
                  {% when 'technology' %}
                    {% assign filter_label = section.settings.technology_label %}
                  {% when 'consumer' %}
                    {% assign filter_label = section.settings.consumer_label %}
                  {% when 'industrials' %}
                    {% assign filter_label = section.settings.industrials_label %}
                  {% when 'food-beverage' %}
                    {% assign filter_label = section.settings.food_beverage_label %}
                  {% when 'financials' %}
                    {% assign filter_label = section.settings.financials_label %}
                  {% when 'healthcare' %}
                    {% assign filter_label = section.settings.healthcare_label %}
                  {% when 'energy' %}
                    {% assign filter_label = section.settings.energy_label %}
                  {% when 'retail' %}
                    {% assign filter_label = section.settings.retail_label %}
                  {% else %}
                    {% assign filter_label = section.settings.other_label %}
                {% endcase %}

                <button
                  type="button"
                  class="ara-company-catalog__filter"
                  data-company-filter="{{ filter_value }}"
                  aria-pressed="false"
                >
                  {{ filter_label | escape }}
                </button>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        <p class="ara-company-catalog__count">
          <strong data-visible-count>{{ section.blocks.size }}</strong>
          <span>{{ section.settings.visible_count_label | escape }}</span>
        </p>
      </div>
    {% endif %}

    {% assign category_values = 'classics,technology,consumer,industrials,food-beverage,financials,healthcare,energy,retail,other' | split: ',' %}

    <div class="ara-company-catalog__groups">
      {% for category_value in category_values %}
        {% assign category_count = 0 %}

        {% for block in section.blocks %}
          {% if block.settings.sector == category_value %}
            {% assign category_count = category_count | plus: 1 %}
          {% endif %}
        {% endfor %}

        {% if category_count > 0 %}
          {% case category_value %}
            {% when 'classics' %}
              {% assign category_label = section.settings.classics_label %}
            {% when 'technology' %}
              {% assign category_label = section.settings.technology_label %}
            {% when 'consumer' %}
              {% assign category_label = section.settings.consumer_label %}
            {% when 'industrials' %}
              {% assign category_label = section.settings.industrials_label %}
            {% when 'food-beverage' %}
              {% assign category_label = section.settings.food_beverage_label %}
            {% when 'financials' %}
              {% assign category_label = section.settings.financials_label %}
            {% when 'healthcare' %}
              {% assign category_label = section.settings.healthcare_label %}
            {% when 'energy' %}
              {% assign category_label = section.settings.energy_label %}
            {% when 'retail' %}
              {% assign category_label = section.settings.retail_label %}
            {% else %}
              {% assign category_label = section.settings.other_label %}
          {% endcase %}

          <section
            class="ara-company-catalog__group"
            data-company-group
            data-company-group-sector="{{ category_value }}"
          >
            <div class="ara-company-catalog__group-heading">
              <h2>{{ category_label | escape }}</h2>
              <span aria-hidden="true"></span>
              <small>{{ category_count }}</small>
            </div>

            <div class="ara-company-catalog__grid">
              {% for block in section.blocks %}
                {% if block.settings.sector == category_value %}
                  {% assign search_text = block.settings.company_name | append: ' ' | append: block.settings.ticker | append: ' ' | append: block.settings.sector_label | append: ' ' | append: block.settings.business_model | append: ' ' | append: block.settings.headquarters | append: ' ' | append: block.settings.keywords | downcase %}

                  {% liquid
                    assign module_url = block.settings.module_link
                    assign company_handle = block.settings.company_name | handleize
                    assign company_status = block.settings.status | downcase
                    assign available_module_handles = section.settings.available_module_handles | downcase | replace: ' ', '' | split: ','
                    assign module_is_available = false
                    assign effective_status = block.settings.status

                    if available_module_handles contains company_handle
                      assign module_is_available = true
                    endif

                    unless module_is_available
                      assign module_url = blank
                      assign effective_status = 'COMING SOON'
                    endunless

                    if module_url == blank and section.settings.enable_automatic_module_links and module_is_available
                      assign module_url = routes.root_url | append: section.settings.module_path_prefix | append: company_handle
                    endif

                    assign popup_product = block.settings.popup_product
                    assign popup_image = block.settings.popup_image
                    assign popup_product_url = blank
                    assign popup_price = block.settings.popup_price
                    assign popup_tagline = block.settings.popup_tagline
                    assign popup_chapter = block.settings.popup_chapter
                    assign popup_cover_color = block.settings.popup_cover_color | default: block.settings.accent_color
                    assign popup_cover_text = block.settings.popup_cover_text_color
                    assign popup_level = block.settings.popup_level | default: 1

                    if popup_tagline == blank
                      assign popup_tagline = block.settings.business_model | capitalize
                    endif

                    if popup_chapter == blank
                      assign popup_chapter = 'The company behind the numbers'
                    endif

                    if popup_product != blank
                      assign popup_product_url = popup_product.url

                      if popup_product.featured_image != blank
                        assign popup_image = popup_product.featured_image
                      endif

                      if popup_price == blank
                        assign popup_price = popup_product.price | money
                      endif
                    endif
                  %}

                  {% assign chart_path = 'M2 43 C20 39 31 42 46 36 C62 30 75 38 91 31 C107 25 121 29 137 23 C154 17 170 24 187 18 C205 12 222 17 238 10' %}

                  {% case block.settings.sparkline_style %}
                    {% when 'steady-up' %}
                      {% assign chart_path = 'M2 46 C24 43 43 39 61 35 C82 30 101 31 121 25 C143 19 164 21 184 15 C205 10 222 11 238 7' %}
                    {% when 'wave-up' %}
                      {% assign chart_path = 'M2 42 C21 28 37 30 53 38 C69 46 82 25 99 28 C116 31 130 39 147 30 C165 21 181 25 198 19 C214 13 228 18 238 9' %}
                    {% when 'volatile-up' %}
                      {% assign chart_path = 'M2 48 C14 19 26 34 38 15 C51 35 63 24 76 42 C90 19 104 27 118 13 C132 33 147 18 161 25 C178 9 194 22 211 8 C224 19 232 13 238 5' %}
                    {% when 'steady-down' %}
                      {% assign chart_path = 'M2 10 C24 14 43 17 62 21 C82 26 102 24 122 31 C143 35 162 34 182 40 C203 44 222 46 238 50' %}
                    {% when 'wave-down' %}
                      {% assign chart_path = 'M2 12 C20 20 36 11 53 19 C70 28 84 18 101 27 C119 36 134 24 152 34 C171 43 185 31 203 40 C220 48 230 40 238 50' %}
                    {% when 'volatile-down' %}
                      {% assign chart_path = 'M2 7 C15 29 27 15 40 36 C53 20 66 44 79 27 C93 47 108 32 123 51 C139 34 154 50 170 39 C186 54 203 42 219 52 C230 44 235 48 238 54' %}
                    {% when 'flat' %}
                      {% assign chart_path = 'M2 31 C22 28 39 34 58 30 C78 27 97 34 116 29 C137 26 157 33 177 28 C198 25 218 31 238 26' %}
                  {% endcase %}

                  <a
                    class="ara-company-catalog__card ara-company-catalog__card--{{ block.settings.direction }}"
                    data-company-card
                    data-company-sector="{{ block.settings.sector }}"
                    data-company-search-text="{{ search_text | escape }}"
                    style="--ara-company-marker: {{ block.settings.accent_color }};"
                    {% if section.settings.enable_company_popup %}
                      href="#AraCompanyPopup-{{ section.id }}"
                      data-company-popup-trigger="{{ block.id }}"
                      aria-haspopup="dialog"
                    {% elsif module_url != blank %}
                      href="{{ module_url }}"
                    {% else %}
                      role="link"
                      aria-disabled="true"
                    {% endif %}
                    {{ block.shopify_attributes }}
                  >
                    <div class="ara-company-catalog__card-heading">
                      <span class="ara-company-catalog__marker" aria-hidden="true"></span>

                      <div>
                        <strong>{{ block.settings.company_name | escape }}</strong>

                        {% if section.settings.show_business_model and block.settings.business_model != blank %}
                          <small>{{ block.settings.business_model | escape }}</small>
                        {% endif %}
                      </div>

                      {% if section.settings.show_ticker and block.settings.ticker != blank %}
                        <span class="ara-company-catalog__ticker">
                          {{ block.settings.ticker | escape }}
                        </span>
                      {% endif %}
                    </div>

                    <div class="ara-company-catalog__chart" aria-hidden="true">
                      <svg viewBox="0 0 240 62" preserveAspectRatio="none">
                        <defs>
                          <linearGradient
                            id="AraChartGradient-{{ block.id }}"
                            x1="0"
                            y1="0"
                            x2="0"
                            y2="1"
                          >
                            <stop offset="0%" stop-color="currentColor" stop-opacity="0.22"/>
                            <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
                          </linearGradient>
                        </defs>

                        <line x1="0" y1="20" x2="240" y2="20" class="ara-company-catalog__guide"/>
                        <line x1="0" y1="42" x2="240" y2="42" class="ara-company-catalog__guide"/>

                        <path
                          d="{{ chart_path }} L238 62 L2 62 Z"
                          fill="url(#AraChartGradient-{{ block.id }})"
                        ></path>

                        <path
                          d="{{ chart_path }}"
                          class="ara-company-catalog__line"
                        ></path>

                        <circle
                          cx="238"
                          cy="{% if block.settings.direction == 'down' %}50{% elsif block.settings.direction == 'flat' %}26{% else %}9{% endif %}"
                          r="2.8"
                          class="ara-company-catalog__dot"
                        ></circle>
                      </svg>
                    </div>

                    <div class="ara-company-catalog__card-footer">
                      <span class="ara-company-catalog__change">
                        {{ block.settings.change | escape }}
                      </span>

                      {% if section.settings.show_status and block.settings.status != blank %}
                        <span class="ara-company-catalog__status">
                          {{ effective_status | escape }}
                        </span>
                      {% endif %}

                      <span class="ara-company-catalog__period">
                        {{ block.settings.period | escape }}
                      </span>
                    </div>

                    <div class="ara-company-catalog__open">
                      <span>{{ section.settings.open_label | escape }}</span>
                      <span aria-hidden="true">↗</span>
                    </div>
                  </a>

                  {% if section.settings.enable_company_popup %}
                    <template data-company-popup-template="{{ block.id }}">
                      <article
                        class="ara-company-catalog__popup-card"
                        style="
                          --ara-popup-accent: {{ block.settings.accent_color }};
                          --ara-popup-cover: {{ popup_cover_color }};
                          --ara-popup-cover-text: {{ popup_cover_text }};
                        "
                      >
                        <div class="ara-company-catalog__popup-folio">
                          <span>{{ block.settings.company_name | escape }}</span>
                          <span>{{ block.settings.ticker | escape }}</span>
                        </div>

                        <div class="ara-company-catalog__popup-layout">
                          <div class="ara-company-catalog__popup-visual">
                            <div class="ara-company-catalog__popup-book">
                              {% if popup_image != blank %}
                                {{
                                  popup_image
                                  | image_url: width: 900
                                  | image_tag:
                                    widths: '360, 540, 720, 900',
                                    sizes: '(max-width: 749px) 72vw, 310px',
                                    loading: 'lazy',
                                    class: 'ara-company-catalog__popup-product-image',
                                    alt: popup_image.alt
                                }}
                              {% else %}
                                <div class="ara-company-catalog__popup-cover">
                                  <span class="ara-company-catalog__popup-cover-kicker">
                                    {{ section.settings.popup_cover_kicker | escape }}
                                  </span>

                                  <i aria-hidden="true"></i>

                                  <strong>{{ block.settings.company_name | escape }}</strong>

                                  <p>
                                    {{ popup_tagline | escape }}
                                  </p>

                                  <img
                                    class="ara-company-catalog__popup-cover-mark"
                                    src="{{ 'mintmark-wordmark-mint.png' | asset_url }}"
                                    alt=""
                                    width="487"
                                    height="88"
                                    loading="lazy"
                                  >
                                </div>
                              {% endif %}
                            </div>

                            <div
                              class="ara-company-catalog__popup-chart ara-company-catalog__popup-chart--{{ block.settings.direction }}"
                              aria-hidden="true"
                            >
                              <svg viewBox="0 0 240 62" preserveAspectRatio="none">
                                <path
                                  d="{{ chart_path }}"
                                  class="ara-company-catalog__popup-chart-line"
                                ></path>
                                <circle
                                  cx="238"
                                  cy="{% if block.settings.direction == 'down' %}50{% elsif block.settings.direction == 'flat' %}26{% else %}9{% endif %}"
                                  r="3"
                                ></circle>
                              </svg>
                            </div>
                          </div>

                          <div class="ara-company-catalog__popup-copy">
                            <div class="ara-company-catalog__popup-meta">
                              <span>{{ block.settings.sector_label | escape }}</span>
                              <span>{{ block.settings.headquarters | escape }}</span>
                              <span>{{ effective_status | escape }}</span>
                            </div>

                            <img
                              class="ara-company-catalog__popup-bookplate"
                              src="{{ 'mintmark-bookplate.png' | asset_url }}"
                              alt=""
                              width="535"
                              height="325"
                              loading="lazy"
                            >

                            <p class="ara-company-catalog__popup-eyebrow">
                              {{ section.settings.popup_eyebrow | escape }}
                            </p>

                            <h3>{{ block.settings.company_name | escape }}</h3>

                            <p class="ara-company-catalog__popup-tagline">
                              {{ popup_tagline | escape }}
                            </p>

                            <div class="ara-company-catalog__popup-chapter">
                              <span>{{ section.settings.popup_chapter_label | escape }}</span>
                              <strong>{{ popup_chapter | escape }}</strong>
                            </div>

                            <div class="ara-company-catalog__popup-index">
                              <span>{{ section.settings.popup_level_label | escape }}</span>

                              <div aria-label="Reading index {{ popup_level }} of 10">
                                {% for level_index in (1..10) %}
                                  <i
                                    class="{% if level_index <= popup_level %}is-active{% endif %}"
                                    aria-hidden="true"
                                  ></i>
                                {% endfor %}
                              </div>

                              {% if popup_price != blank %}
                                <strong>{{ popup_price | escape }}</strong>
                              {% endif %}
                            </div>

                            <div class="ara-company-catalog__popup-actions">
                              {% if module_url != blank %}
                                <a
                                  class="ara-company-catalog__popup-button ara-company-catalog__popup-button--module"
                                  href="{{ module_url }}"
                                >
                                  {{ section.settings.popup_module_label | escape }}
                                  <span aria-hidden="true">→</span>
                                </a>
                              {% else %}
                                <span
                                  class="ara-company-catalog__popup-button ara-company-catalog__popup-button--disabled"
                                >
                                  {{ section.settings.popup_module_unavailable_label | escape }}
                                </span>
                              {% endif %}

                              {% if popup_product_url != blank %}
                                <a
                                  class="ara-company-catalog__popup-button ara-company-catalog__popup-button--product"
                                  href="{{ popup_product_url }}"
                                >
                                  {{ section.settings.popup_product_label | escape }}
                                  {% if popup_price != blank %}
                                    — {{ popup_price | escape }}
                                  {% endif %}
                                </a>
                              {% else %}
                                <span
                                  class="ara-company-catalog__popup-button ara-company-catalog__popup-button--disabled"
                                >
                                  {{ section.settings.popup_product_unavailable_label | escape }}
                                </span>
                              {% endif %}
                            </div>
                          </div>
                        </div>
                      </article>
                    </template>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          </section>
        {% endif %}
      {% endfor %}
    </div>

    <p class="ara-company-catalog__empty" data-empty-message hidden>
      {{ section.settings.empty_message | escape }}
    </p>
  </div>

  {% if section.settings.enable_company_popup %}
    <div
      id="AraCompanyPopup-{{ section.id }}"
      class="ara-company-catalog__popup"
      data-company-popup
      hidden
    >
      <button
        type="button"
        class="ara-company-catalog__popup-backdrop"
        data-company-popup-close
        aria-label="{{ section.settings.popup_close_label | escape }}"
      ></button>

      <div
        class="ara-company-catalog__popup-dialog"
        role="dialog"
        aria-modal="true"
        aria-label="{{ section.settings.popup_dialog_label | escape }}"
      >
        <button
          type="button"
          class="ara-company-catalog__popup-close"
          data-company-popup-close
          aria-label="{{ section.settings.popup_close_label | escape }}"
        >
          <span aria-hidden="true">×</span>
        </button>

        <div data-company-popup-content></div>
      </div>
    </div>
  {% endif %}
</section>

<style>
  #AraCompanyCatalog-{{ section.id }} {
    overflow: hidden;
    padding: var(--ara-cc-top) 0 var(--ara-cc-bottom);
    background-color: var(--ara-cc-bg);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 35px,
      color-mix(in srgb, var(--ara-cc-line) 42%, transparent) 35px,
      color-mix(in srgb, var(--ara-cc-line) 42%, transparent) 37px
    );
    color: var(--ara-cc-text);
  }

  #AraCompanyCatalog-{{ section.id }} * {
    box-sizing: border-box;
  }

  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__inner {
    width: min(100%, var(--ara-cc-max));
    margin: 0 auto;
    padding: 0 40px;
  }

  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(300px, 0.55fr);
    gap: 50px;
    align-items: end;
    margin-bottom: 38px;
  }

  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__eyebrow,
  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__search > span,
  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__filter,
  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__count,
  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__group-heading small,
  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__card-heading,
  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__card-footer,
  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__open {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
  }

  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__eyebrow {
    color: var(--ara-cc-neutral);
    font-size: var(--ara-cc-meta-desktop);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__intro h1 {
    margin: 13px 0 0;
    font-family: var(--font-heading-family);
    font-size: var(--ara-cc-heading-desktop);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 0.96;
    letter-spacing: -0.05em;
  }

  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__description {
    color: var(--ara-cc-muted);
    font-family: var(--font-body-family);
    font-size: 15px;
    line-height: 1.6;
  }

  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__description p {
    margin: 0;
  }

  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__tools {
    display: grid;
    grid-template-columns: minmax(250px, 0.72fr) minmax(0, 1.4fr) auto;
    gap: 16px;
    align-items: end;
    margin-bottom: 47px;
    padding: 15px;
    border: 1px solid var(--ara-cc-border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--ara-cc-card) 94%, transparent);
    box-shadow: 0 8px 26px rgba(22, 27, 46, 0.055);
  }

  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__search {
    display: grid;
    gap: 7px;
  }

  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__search > span,
  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__filter,
  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__count {
    font-size: var(--ara-cc-meta-desktop);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #AraCompanyCatalog-{{ section.id }} .ara-company-catalog__search input {
    width: 100%;
    min-height: 42px;
    padding: 10px 12px;
