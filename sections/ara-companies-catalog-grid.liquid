<script>
  (() => {
    const section = document.getElementById('AraCompanyCatalog-{{ section.id }}');

    if (!section || section.dataset.catalogReady === 'true') return;

    section.dataset.catalogReady = 'true';

    const search = section.querySelector('[data-company-search]');
    const filters = [...section.querySelectorAll('[data-company-filter]')];
    const cards = [...section.querySelectorAll('[data-company-card]')];
    const groups = [...section.querySelectorAll('[data-company-group]')];
    const count = section.querySelector('[data-visible-count]');
    const empty = section.querySelector('[data-empty-message]');

    let activeFilter = 'all';
    let searchTerm = '';

    const update = () => {
      let visibleCount = 0;

      cards.forEach(card => {
        const sectorMatch =
          activeFilter === 'all' ||
          card.dataset.companySector === activeFilter;

        const searchText = card.dataset.companySearchText || '';
        const searchMatch =
          searchTerm === '' ||
          searchText.includes(searchTerm);

        const visible = sectorMatch && searchMatch;

        card.hidden = !visible;

        if (visible) visibleCount += 1;
      });

      groups.forEach(group => {
        const hasVisibleCard = [...group.querySelectorAll('[data-company-card]')]
          .some(card => !card.hidden);

        group.hidden = !hasVisibleCard;
      });

      if (count) {
        count.textContent = String(visibleCount);
      }

      if (empty) {
        empty.hidden = visibleCount > 0;
      }
    };

    filters.forEach(filter => {
      filter.addEventListener('click', () => {
        activeFilter = filter.dataset.companyFilter || 'all';

        filters.forEach(item => {
          const active = item === filter;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });

        update();
      });
    });

    if (search) {
      search.addEventListener('input', event => {
        searchTerm = event.target.value.trim().toLowerCase();
        update();
      });
    }

    const popup = section.querySelector('[data-company-popup]');
    const popupContent = popup?.querySelector('[data-company-popup-content]');
    const popupCloseButtons = popup
      ? [...popup.querySelectorAll('[data-company-popup-close]')]
      : [];
    const popupTriggers = [
      ...section.querySelectorAll('[data-company-popup-trigger]')
    ];

    let lastPopupTrigger = null;

    const closePopup = () => {
      if (!popup || popup.hidden) return;

      popup.hidden = true;

      if (popupContent) {
        popupContent.innerHTML = '';
      }

      document.body.classList.remove('ara-company-popup-open');

      if (lastPopupTrigger) {
        lastPopupTrigger.focus();
      }
    };

    const openPopup = trigger => {
      if (!popup || !popupContent) return;

      const blockId = trigger.dataset.companyPopupTrigger;
      const template = section.querySelector(
        `[data-company-popup-template="${blockId}"]`
      );

      if (!template) return;

      lastPopupTrigger = trigger;
      popupContent.innerHTML = '';
      popupContent.appendChild(template.content.cloneNode(true));
      popup.hidden = false;
      document.body.classList.add('ara-company-popup-open');

      window.requestAnimationFrame(() => {
        popup.querySelector('.ara-company-catalog__popup-close')?.focus();
      });
    };

    popupTriggers.forEach(trigger => {
      trigger.addEventListener('click', event => {
        event.preventDefault();
        openPopup(trigger);
      });
    });

    popupCloseButtons.forEach(button => {
      button.addEventListener('click', closePopup);
    });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && popup && !popup.hidden) {
        closePopup();
      }
    });

    update();
  })();
</script>


