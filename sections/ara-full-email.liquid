<section
  id="AraFullEmail-{{ section.id }}"
  class="ara-full-email"
  style="
    --ara-email-bg: {{ section.settings.background_color }};
    --ara-email-text: {{ section.settings.text_color }};
    --ara-email-muted: {{ section.settings.muted_text_color }};
    --ara-email-accent: {{ section.settings.accent_color }};
    --ara-email-gold: {{ section.settings.gold_color }};
    --ara-email-border: {{ section.settings.border_color }};
    --ara-email-field: {{ section.settings.field_color }};
    --ara-email-button: {{ section.settings.button_color }};
    --ara-email-button-text: {{ section.settings.button_text_color }};
    --ara-email-max: {{ section.settings.max_width }};
    --ara-email-top: {{ section.settings.padding_top }}px;
    --ara-email-bottom: {{ section.settings.padding_bottom }}px;
    --ara-email-eyebrow-size: {{ section.settings.desktop_eyebrow_size }}px;
    --ara-email-heading-size: {{ section.settings.desktop_heading_size }}px;
    --ara-email-description-size: {{ section.settings.desktop_description_size }}px;
    --ara-email-input-size: {{ section.settings.desktop_input_size }}px;
    --ara-email-button-size: {{ section.settings.desktop_button_size }}px;
    --ara-email-message-size: {{ section.settings.desktop_message_size }}px;
    --ara-email-note-size: {{ section.settings.desktop_note_size }}px;
    --ara-email-mobile-eyebrow-size: {{ section.settings.mobile_eyebrow_size }}px;
    --ara-email-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --ara-email-mobile-description-size: {{ section.settings.mobile_description_size }}px;
    --ara-email-mobile-input-size: {{ section.settings.mobile_input_size }}px;
    --ara-email-mobile-button-size: {{ section.settings.mobile_button_size }}px;
    --ara-email-mobile-message-size: {{ section.settings.mobile_message_size }}px;
    --ara-email-mobile-note-size: {{ section.settings.mobile_note_size }}px;
  "
>
  <div class="ara-full-email__inner">
    <div class="ara-full-email__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="ara-full-email__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="ara-full-email__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    <div class="ara-full-email__form-wrap">
      {% form 'customer', class: 'ara-full-email__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">

        <label
          class="visually-hidden"
          for="AraFullEmailField-{{ section.id }}"
        >
          Email address
        </label>

        <input
          id="AraFullEmailField-{{ section.id }}"
          class="ara-full-email__input"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ section.settings.placeholder | escape }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
        >

        <button
          type="submit"
          class="ara-full-email__button"
          name="commit"
        >
          {{ section.settings.button_label | escape }}
        </button>

        {% if form.posted_successfully? %}
          <p class="ara-full-email__message">
            {{ section.settings.success_message | escape }}
          </p>
        {% endif %}

        {% if form.errors %}
          <div class="ara-full-email__message ara-full-email__message--error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
      {% endform %}

      {% if section.settings.note != blank %}
        <p class="ara-full-email__note">
          {{ section.settings.note | escape }}
        </p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #AraFullEmail-{{ section.id }} {
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--ara-email-accent) 9%, transparent),
        transparent 42%
      ),
      var(--ara-email-bg);
    color: var(--ara-email-text);
  }

  #AraFullEmail-{{ section.id }} .ara-full-email__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(440px, 0.82fr);
    gap: clamp(50px, 7vw, 110px);
    align-items: end;
    width: min(100%, var(--ara-email-max));
    margin: 0 auto;
    padding: var(--ara-email-top) 40px var(--ara-email-bottom);
  }

  #AraFullEmail-{{ section.id }} .ara-full-email__eyebrow {
    margin: 0 0 14px;
    color: var(--ara-email-gold);
    font-family: var(--font-body-family);
    font-size: var(--ara-email-eyebrow-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  #AraFullEmail-{{ section.id }} .ara-full-email__copy h2 {
    max-width: 920px;
    margin: 0;
    color: var(--ara-email-text);
    font-family: var(--font-heading-family);
    font-size: var(--ara-email-heading-size);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 0.96;
    letter-spacing: -0.05em;
  }

  #AraFullEmail-{{ section.id }} .ara-full-email__description {
    max-width: 650px;
    margin-top: 24px;
    color: var(--ara-email-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-email-description-size);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.65;
  }

  #AraFullEmail-{{ section.id }} .ara-full-email__description p {
    margin: 0;
  }

  #AraFullEmail-{{ section.id }} .ara-full-email__form-wrap {
    position: relative;
    padding: 34px 32px 28px;
    border: 1px solid var(--ara-email-border);
    background: color-mix(in srgb, var(--ara-email-field) 22%, transparent);
  }

  #AraFullEmail-{{ section.id }} .ara-full-email__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
  }

  #AraFullEmail-{{ section.id }} .ara-full-email__input {
    min-height: 56px;
    padding: 13px 16px;
    border: 1px solid var(--ara-email-border);
    border-radius: 0;
    outline: 0;
    background: var(--ara-email-field);
    color: var(--ara-email-text);
    font-family: var(--font-body-family);
    font-size: var(--ara-email-input-size);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
  }

  #AraFullEmail-{{ section.id }} .ara-full-email__input::placeholder {
    color: var(--ara-email-muted);
  }

  #AraFullEmail-{{ section.id }} .ara-full-email__input:focus {
    border-color: var(--ara-email-accent);
    box-shadow: 0 0 0 1px var(--ara-email-accent);
  }

  #AraFullEmail-{{ section.id }} .ara-full-email__button {
    min-width: 180px;
    min-height: 56px;
    padding: 13px 24px;
    border: 1px solid var(--ara-email-button);
    border-radius: 0;
    background: var(--ara-email-button);
    color: var(--ara-email-button-text);
    cursor: pointer;
    font-family: var(--font-body-family);
    font-size: var(--ara-email-button-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  #AraFullEmail-{{ section.id }} .ara-full-email__message {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--ara-email-gold);
    font-family: var(--font-body-family);
    font-size: var(--ara-email-message-size);
    font-style: var(--font-body-style);
    line-height: 1.5;
  }

  #AraFullEmail-{{ section.id }} .ara-full-email__message--error {
    color: #FF8A7B;
  }

  #AraFullEmail-{{ section.id }} .ara-full-email__note {
    margin: 14px 0 0;
    color: var(--ara-email-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-email-note-size);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.5;
  }

  @media screen and (max-width: 949px) {
    #AraFullEmail-{{ section.id }} .ara-full-email__inner {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media screen and (max-width: 749px) {
    #AraFullEmail-{{ section.id }} .ara-full-email__inner {
      padding-right: 20px;
      padding-left: 20px;
    }

    #AraFullEmail-{{ section.id }} .ara-full-email__eyebrow {
      font-size: var(--ara-email-mobile-eyebrow-size);
    }

    #AraFullEmail-{{ section.id }} .ara-full-email__copy h2 {
      font-size: var(--ara-email-mobile-heading-size);
    }

    #AraFullEmail-{{ section.id }} .ara-full-email__description {
      font-size: var(--ara-email-mobile-description-size);
    }

    #AraFullEmail-{{ section.id }} .ara-full-email__input {
      font-size: var(--ara-email-mobile-input-size);
    }

    #AraFullEmail-{{ section.id }} .ara-full-email__button {
      font-size: var(--ara-email-mobile-button-size);
    }

    #AraFullEmail-{{ section.id }} .ara-full-email__message {
      font-size: var(--ara-email-mobile-message-size);
    }

    #AraFullEmail-{{ section.id }} .ara-full-email__note {
      font-size: var(--ara-email-mobile-note-size);
    }

    #AraFullEmail-{{ section.id }} .ara-full-email__form-wrap {
      padding: 32px 20px 24px;
    }

    #AraFullEmail-{{ section.id }} .ara-full-email__form {
      grid-template-columns: 1fr;
    }

    #AraFullEmail-{{ section.id }} .ara-full-email__button {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Ara Full Email",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "THE PAPER, DELIVERED"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main heading",
      "default": "A clearer way to\nunderstand companies."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>New company stories, short takes and physical digest releases—written with clarity and delivered calmly.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "JOIN THE PAPER"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you. Your paper is on the way."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small note",
      "default": "Relevant updates only. Unsubscribe at any time."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "desktop_eyebrow_size",
      "min": 8,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Desktop small heading size",
      "default": 10
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "min": 36,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Desktop main heading size",
      "default": 72
    },
    {
      "type": "range",
      "id": "desktop_description_size",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Desktop description size",
      "default": 14
    },
    {
      "type": "range",
      "id": "desktop_input_size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Desktop input text size",
      "default": 13
    },
    {
      "type": "range",
      "id": "desktop_button_size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Desktop button text size",
      "default": 10
    },
    {
      "type": "range",
      "id": "desktop_message_size",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Desktop message size",
      "default": 11
    },
    {
      "type": "range",
      "id": "desktop_note_size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Desktop note size",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_eyebrow_size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Mobile small heading size",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 34,
      "max": 70,
      "step": 2,
      "unit": "px",
      "label": "Mobile main heading size",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_description_size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Mobile description size",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_input_size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Mobile input text size",
      "default": 13
    },
    {
      "type": "range",
      "id": "mobile_button_size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Mobile button text size",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_message_size",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Mobile message size",
      "default": 11
    },
    {
      "type": "range",
      "id": "mobile_note_size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Mobile note size",
      "default": 10
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "1700px",
      "options": [
        {
          "value": "1300px",
          "label": "Narrow"
        },
        {
          "value": "1500px",
          "label": "Medium"
        },
        {
          "value": "1700px",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 100
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#161B2E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#F2F8F6"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Secondary text",
      "default": "#C6C3BA"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Mint accent",
      "default": "#1FA88F"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold accent",
      "default": "#E0A526"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#45506A"
    },
    {
      "type": "color",
      "id": "field_color",
      "label": "Field background",
      "default": "#20273B"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#E0A526"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#161B2E"
    }
  ],
  "presets": [
    {
      "name": "Ara Full Email"
    }
  ]
}
{% endschema %}
