<script>
  (() => {
    const section = document.getElementById('AraBookshelfCatalog-{{ section.id }}');

    if (!section || section.dataset.araBookshelfReady === 'true') return;

    section.dataset.araBookshelfReady = 'true';

    const track = section.querySelector('[data-ara-track]');
    const container = section.querySelector('[data-ara-container]');
    const books = [...section.querySelectorAll('[data-ara-book]')];
    const filters = [...section.querySelectorAll('[data-ara-filter]')];
    const sort = section.querySelector('[data-ara-sort]');
    const progress = section.querySelector('[data-ara-progress]');
    const empty = section.querySelector('[data-ara-empty]');
    const selectedVolume = section.querySelector('[data-ara-selected-volume]');
    const selectedSector = section.querySelector('[data-ara-selected-sector]');
    const selectedMonogram = section.querySelector('[data-ara-selected-monogram]');
    const selectedName = section.querySelector('[data-ara-selected-name]');
    const selectedTicker = section.querySelector('[data-ara-selected-ticker]');
    const selectedHeadquarters = section.querySelector('[data-ara-selected-hq]');
    const selectedSummary = section.querySelector('[data-ara-selected-summary]');
    const selectedAction = section.querySelector('[data-ara-selected-action]');
    const originalOrder = new Map(books.map((book, index) => [book, index]));

    const visibleBooks = () => books.filter(book => !book.hidden);

    const selectBook = book => {
      if (!book) return;

      books.forEach(item => {
        item.classList.toggle('is-selected', item === book);
      });

      selectedVolume.textContent = book.dataset.araVolume || '';
      selectedSector.textContent = (book.dataset.araSector || 'other').replaceAll('-', ' ');
      selectedMonogram.textContent = book.dataset.araMonogram || '';
      selectedName.textContent = book.dataset.araName || '';
      selectedTicker.textContent = book.dataset.araTicker || '';
      selectedHeadquarters.textContent = book.dataset.araHeadquarters || '';
      selectedSummary.textContent = book.dataset.araSummary || '';

      selectedAction.innerHTML = '';

      if (book.dataset.araUrl) {
        const link = document.createElement('a');
        link.href = book.dataset.araUrl;
        link.textContent = book.dataset.araLinkLabel || '';
        selectedAction.appendChild(link);
      } else {
        const unavailable = document.createElement('span');
        unavailable.textContent = book.dataset.araLinkLabel || '';
        unavailable.setAttribute('aria-disabled', 'true');
        selectedAction.appendChild(unavailable);
      }
    };

    const updateProgress = () => {
      if (!track || !progress) return;

      const maximum = track.scrollWidth - track.clientWidth;
      const ratio = maximum > 0 ? track.scrollLeft / maximum : 0;
      const thumb = Math.min(1, track.clientWidth / Math.max(track.scrollWidth, 1));
      const travel = Math.max(0, 1 - thumb);

      progress.style.width = `${Math.max(thumb * 100, 14)}%`;
      progress.style.transform = `translateX(${thumb > 0 ? (ratio * travel * 100) / thumb : 0}%)`;
    };

    const applySort = value => {
      const ordered = [...books];

      ordered.sort((a, b) => {
        if (value === 'height') {
          return Number(b.dataset.araHeight) - Number(a.dataset.araHeight);
        }

        if (value === 'width') {
          return Number(b.dataset.araWidth) - Number(a.dataset.araWidth);
        }

        if (value === 'name') {
          return (a.dataset.araName || '').localeCompare(b.dataset.araName || '');
        }

        return originalOrder.get(a) - originalOrder.get(b);
      });

      ordered.forEach(book => container.appendChild(book));

      const first = visibleBooks()[0];

      if (first) {
        selectBook(first);
      }

      track?.scrollTo({ left: 0, behavior: 'smooth' });
      requestAnimationFrame(updateProgress);
    };

    books.forEach(book => {
      const update = () => selectBook(book);

      book.addEventListener('mouseenter', update);
      book.addEventListener('focus', update);

      if (book.tagName === 'BUTTON') {
        book.addEventListener('click', update);
      }
    });

    filters.forEach(filter => {
      filter.addEventListener('click', () => {
        const selected = filter.dataset.araFilter;

        filters.forEach(item => {
          const active = item === filter;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });

        books.forEach(book => {
          book.hidden =
            selected !== 'all' &&
            book.dataset.araSector !== selected;
        });

        const first = visibleBooks()[0];

        if (empty) {
          empty.hidden = Boolean(first);
        }

        if (first) {
          selectBook(first);
        }

        track?.scrollTo({ left: 0, behavior: 'smooth' });
        requestAnimationFrame(updateProgress);
      });
    });

    sort?.addEventListener('change', event => {
      applySort(event.target.value);
    });

    section.querySelectorAll('[data-ara-scroll]').forEach(button => {
      button.addEventListener('click', () => {
        if (!track) return;

        track.scrollBy({
          left: Number(button.dataset.araScroll) * track.clientWidth * 0.76,
          behavior: 'smooth'
        });
      });
    });

    track?.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);

    const first = visibleBooks()[0];

    if (first) {
      selectBook(first);
    }

    requestAnimationFrame(updateProgress);
  })();
</script>

