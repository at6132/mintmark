{% liquid
  assign use_collection = false

  if section.settings.source_mode == 'collection' and section.settings.book_collection != blank
    assign use_collection = true
  endif

  assign book_count = section.blocks.size

  if use_collection
    assign book_count = section.settings.max_products
    if section.settings.book_collection.products_count < book_count
      assign book_count = section.settings.book_collection.products_count
    endif
  endif
%}

<section
  id="AraBookshelfCatalog-{{ section.id }}"
  class="ara-bookshelf-wall"
  style="
    --ara-bw-bg: {{ section.settings.background_color }};
    --ara-bw-paper: {{ section.settings.paper_color }};
    --ara-bw-ink: {{ section.settings.text_color }};
    --ara-bw-muted: {{ section.settings.muted_text_color }};
    --ara-bw-mint: {{ section.settings.mint_color }};
    --ara-bw-gold: {{ section.settings.gold_color }};
    --ara-bw-trim: {{ section.settings.trim_color }};
    --ara-bw-trim-secondary: {{ section.settings.trim_secondary_color }};
    --ara-bw-radius: {{ section.settings.corner_rounding }}px;
    --ara-bw-blue: {{ section.settings.blue_color }};
    --ara-bw-deep: {{ section.settings.blue_deep_color }};
    --ara-bw-frame: {{ section.settings.cabinet_color }};
    --ara-bw-frame-dark: {{ section.settings.cabinet_edge_color }};
    --ara-bw-stage: {{ section.settings.shelf_back_color }};
    --ara-bw-max: {{ section.settings.max_width }};
    --ara-bw-top: {{ section.settings.padding_top }}px;
    --ara-bw-bottom: {{ section.settings.padding_bottom }}px;
    --ara-bw-heading-desktop: {{ section.settings.desktop_heading_size }}px;
    --ara-bw-body-desktop: {{ section.settings.desktop_body_size }}px;
    --ara-bw-label-desktop: {{ section.settings.desktop_label_size }}px;
    --ara-bw-title-desktop: {{ section.settings.desktop_detail_title_size }}px;
    --ara-bw-heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --ara-bw-body-mobile: {{ section.settings.mobile_body_size }}px;
    --ara-bw-label-mobile: {{ section.settings.mobile_label_size }}px;
    --ara-bw-title-mobile: {{ section.settings.mobile_detail_title_size }}px;
  "
>
  <div class="ara-bookshelf-wall__rules" aria-hidden="true"></div>

  <div class="ara-bookshelf-wall__inner">
    <header class="ara-bookshelf-wall__intro">
      <div class="ara-bookshelf-wall__intro-main">
        {% if section.settings.eyebrow != blank %}
          <p class="ara-bookshelf-wall__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
        {% endif %}
      </div>

      <div class="ara-bookshelf-wall__intro-side">
        {% if section.settings.description != blank %}
          <div class="ara-bookshelf-wall__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        <div class="ara-bookshelf-wall__count">
          <strong>{{ book_count | prepend: '0' | slice: -2, 2 }}</strong>
          <span>{{ section.settings.volume_count_label | escape }}</span>
        </div>
      </div>
    </header>

    <div class="ara-bookshelf-wall__toolbar">
      {% if section.settings.show_filters %}
        <div
          class="ara-bookshelf-wall__filters"
          role="group"
          aria-label="{{ section.settings.filter_accessibility_label | escape }}"
        >
          <button
            type="button"
            class="is-active"
            data-ara-filter="all"
            aria-pressed="true"
          >
            {{ section.settings.filter_all_label | escape }}
          </button>

          <button type="button" data-ara-filter="technology" aria-pressed="false">
            {{ section.settings.filter_technology_label | escape }}
          </button>

          <button type="button" data-ara-filter="financials" aria-pressed="false">
            {{ section.settings.filter_financials_label | escape }}
          </button>

          <button type="button" data-ara-filter="consumer" aria-pressed="false">
            {{ section.settings.filter_consumer_label | escape }}
          </button>

          <button type="button" data-ara-filter="other" aria-pressed="false">
            {{ section.settings.filter_other_label | escape }}
          </button>
        </div>
      {% endif %}

      <label class="ara-bookshelf-wall__sort">
        <span>SORT</span>
        <select data-ara-sort>
          <option value="original">CURATED ORDER</option>
          <option value="height">MARKET VALUE</option>
          <option value="width">COMPANY AGE</option>
          <option value="name">COMPANY A–Z</option>
        </select>
      </label>
    </div>

    <div class="ara-bookshelf-wall__display">
      <aside class="ara-bookshelf-wall__selected" aria-live="polite">
        <div class="ara-bookshelf-wall__selected-top">
          <span data-ara-selected-volume>VOL. 01</span>
          <span data-ara-selected-sector>TECHNOLOGY</span>
        </div>

        <div class="ara-bookshelf-wall__selected-monogram" data-ara-selected-monogram>
          A
        </div>

        <p class="ara-bookshelf-wall__selected-label">
          {{ section.settings.detail_eyebrow | escape }}
        </p>

        <h3 data-ara-selected-name>Apple</h3>

        <div class="ara-bookshelf-wall__selected-meta">
          <span data-ara-selected-ticker>NASDAQ: AAPL</span>
          <span data-ara-selected-hq>CUPERTINO · USA</span>
        </div>

        <p class="ara-bookshelf-wall__selected-summary" data-ara-selected-summary>
          Understand how Apple combines hardware, software and services into one connected economic system.
        </p>

        <div class="ara-bookshelf-wall__selected-action" data-ara-selected-action>
          <a href="/pages/apple">OPEN COMPANY MODULE</a>
        </div>

        <div class="ara-bookshelf-wall__measure-key">
          <div>
            <span class="ara-bookshelf-wall__measure-line ara-bookshelf-wall__measure-line--height"></span>
            <p>
              <strong>{{ section.settings.shelf_one_label | escape }}</strong>
              <small>{{ section.settings.shelf_two_note | escape }}</small>
            </p>
          </div>

          <div>
            <span class="ara-bookshelf-wall__measure-line ara-bookshelf-wall__measure-line--width"></span>
            <p>
              <strong>{{ section.settings.shelf_one_note | escape }}</strong>
              <small>{{ section.settings.shelf_three_note | escape }}</small>
            </p>
          </div>
        </div>
      </aside>

      <div class="ara-bookshelf-wall__frame">
        <div class="ara-bookshelf-wall__frame-head">
          <div class="ara-bookshelf-wall__brand-mark">
            {% if section.settings.emblem != blank %}
              {{
                section.settings.emblem
                | image_url: width: 360
                | image_tag:
                  widths: '80, 120, 180, 260, 360',
                  sizes: '48px',
                  loading: 'lazy',
                  class: 'ara-bookshelf-wall__brand-image',
                  alt: section.settings.emblem.alt
              }}
            {% else %}
              <span>M</span>
            {% endif %}
          </div>

          <div class="ara-bookshelf-wall__frame-title">
            <span>{{ section.settings.cabinet_heading | escape }}</span>
            <small>{{ section.settings.cabinet_note | escape }}</small>
          </div>

          <div class="ara-bookshelf-wall__frame-index">
            <span>{{ book_count | prepend: '0' | slice: -2, 2 }}</span>
            <small>VOLUMES</small>
          </div>
        </div>

        <div class="ara-bookshelf-wall__stage">
          <div class="ara-bookshelf-wall__stage-grid" aria-hidden="true"></div>

          <div class="ara-bookshelf-wall__stage-labels">
            <span>MARKET VALUE ↑</span>
            <span>COMPANY AGE →</span>
          </div>

          <div class="ara-bookshelf-wall__viewport" data-ara-track>
            <div class="ara-bookshelf-wall__books" data-ara-container role="list">
              {% if use_collection %}
                {% for product in section.settings.book_collection.products limit: section.settings.max_products %}
                  {% liquid
                    assign company_name = product.metafields.custom.company_name.value | default: product.title
                    assign spine_title = product.metafields.custom.spine_title.value | default: company_name
                    assign ticker = product.metafields.custom.company_ticker.value
                    assign sector = product.metafields.custom.company_sector.value | default: 'other' | handleize
                    assign headquarters = product.metafields.custom.company_headquarters.value
                    assign summary = product.metafields.custom.company_summary.value | default: product.description | strip_html | truncatewords: 30
                    assign module_url = product.metafields.custom.company_module_url.value
                    assign book_height = product.metafields.custom.bookshelf_height.value | default: 350
                    assign book_width = product.metafields.custom.bookshelf_width.value | default: 66
                    assign color_style = product.metafields.custom.bookshelf_color.value | default: 'navy' | handleize
                    assign volume = product.metafields.custom.volume_number.value | default: forloop.index | prepend: 'VOL. 0'
                    assign primary_url = product.url
                    assign primary_label = section.settings.default_product_label

                    if section.settings.collection_click_target == 'module' and module_url != blank
                      assign primary_url = module_url
                      assign primary_label = section.settings.default_module_label
                    endif

                    assign mobile_height = book_height | times: 0.76 | round
                    assign mobile_width = book_width | times: 0.9 | round
                    assign monogram = company_name | slice: 0, 1
                  %}

                  <a
                    href="{{ primary_url }}"
                    class="ara-bookshelf-wall__book ara-bookshelf-wall__book--{{ color_style }}{% if forloop.first %} is-selected{% endif %}"
                    style="
                      --ara-book-height: {{ book_height }}px;
                      --ara-book-width: {{ book_width }}px;
                      --ara-book-height-mobile: {{ mobile_height }}px;
                      --ara-book-width-mobile: {{ mobile_width }}px;
                    "
                    data-ara-book
                    data-ara-sector="{{ sector }}"
                    data-ara-name="{{ company_name | escape }}"
                    data-ara-height="{{ book_height }}"
                    data-ara-width="{{ book_width }}"
                    data-ara-volume="{{ volume | escape }}"
                    data-ara-status="{{ section.settings.available_label | escape }}"
                    data-ara-ticker="{{ ticker | escape }}"
                    data-ara-headquarters="{{ headquarters | escape }}"
                    data-ara-summary="{{ summary | escape }}"
                    data-ara-url="{{ primary_url }}"
                    data-ara-link-label="{{ primary_label | escape }}"
                    data-ara-monogram="{{ monogram | escape }}"
                    role="listitem"
                    aria-label="{{ primary_label | escape }}: {{ company_name | escape }}"
                  >
                    <span class="ara-bookshelf-wall__book-cap" aria-hidden="true"></span>
                    <span class="ara-bookshelf-wall__book-volume">{{ volume | escape }}</span>
                    <span class="ara-bookshelf-wall__book-name">{{ spine_title | escape }}</span>
                    <span class="ara-bookshelf-wall__book-monogram">{{ monogram | escape }}</span>
                    <span class="ara-bookshelf-wall__book-status">{{ section.settings.available_label | escape }}</span>
                  </a>
                {% endfor %}
              {% else %}
                {% for block in section.blocks %}
                  {% liquid
                    assign digest_url = block.settings.digest_link

                    if block.settings.digest_product != blank and digest_url == blank
                      assign digest_url = block.settings.digest_product.url
                    endif

                    assign primary_url = digest_url
                    assign primary_label = block.settings.digest_button_label

                    if block.settings.primary_destination == 'module'
                      assign primary_url = block.settings.module_link
                      assign primary_label = block.settings.module_button_label
                    endif

                    if primary_url == blank and block.settings.module_link != blank
                      assign primary_url = block.settings.module_link
                      assign primary_label = block.settings.module_button_label
                    elsif primary_url == blank and digest_url != blank
                      assign primary_url = digest_url
                      assign primary_label = block.settings.digest_button_label
                    endif

                    assign effective_status = block.settings.status
                    assign available = false

                    if primary_url != blank
                      assign available = true
                    else
                      assign effective_status = section.settings.coming_soon_label
                    endif

                    assign mobile_height = block.settings.spine_height | times: 0.76 | round
                    assign mobile_width = block.settings.spine_width | times: 0.9 | round
                    assign monogram = block.settings.company_name | slice: 0, 1
                  %}

                  {% if available %}
                    <a
                      href="{{ primary_url }}"
                      class="ara-bookshelf-wall__book ara-bookshelf-wall__book--{{ block.settings.color }}{% if forloop.first %} is-selected{% endif %}"
                      style="
                        --ara-book-height: {{ block.settings.spine_height }}px;
                        --ara-book-width: {{ block.settings.spine_width }}px;
                        --ara-book-height-mobile: {{ mobile_height }}px;
                        --ara-book-width-mobile: {{ mobile_width }}px;
                      "
                      data-ara-book
                      data-ara-sector="{{ block.settings.sector }}"
                      data-ara-name="{{ block.settings.company_name | escape }}"
                      data-ara-height="{{ block.settings.spine_height }}"
                      data-ara-width="{{ block.settings.spine_width }}"
                      data-ara-volume="{{ block.settings.volume | escape }}"
                      data-ara-status="{{ effective_status | escape }}"
                      data-ara-ticker="{{ block.settings.ticker | escape }}"
                      data-ara-headquarters="{{ block.settings.headquarters | escape }}"
                      data-ara-summary="{{ block.settings.summary | escape }}"
                      data-ara-url="{{ primary_url }}"
                      data-ara-link-label="{{ primary_label | escape }}"
                      data-ara-monogram="{{ monogram | escape }}"
                      role="listitem"
                      aria-label="{{ primary_label | escape }}: {{ block.settings.company_name | escape }}"
                      {{ block.shopify_attributes }}
                    >
                  {% else %}
                    <button
                      type="button"
                      class="ara-bookshelf-wall__book ara-bookshelf-wall__book--{{ block.settings.color }} ara-bookshelf-wall__book--unavailable{% if forloop.first %} is-selected{% endif %}"
                      style="
                        --ara-book-height: {{ block.settings.spine_height }}px;
                        --ara-book-width: {{ block.settings.spine_width }}px;
                        --ara-book-height-mobile: {{ mobile_height }}px;
                        --ara-book-width-mobile: {{ mobile_width }}px;
                      "
                      data-ara-book
                      data-ara-sector="{{ block.settings.sector }}"
                      data-ara-name="{{ block.settings.company_name | escape }}"
                      data-ara-height="{{ block.settings.spine_height }}"
                      data-ara-width="{{ block.settings.spine_width }}"
                      data-ara-volume="{{ block.settings.volume | escape }}"
                      data-ara-status="{{ effective_status | escape }}"
                      data-ara-ticker="{{ block.settings.ticker | escape }}"
                      data-ara-headquarters="{{ block.settings.headquarters | escape }}"
                      data-ara-summary="{{ block.settings.summary | escape }}"
                      data-ara-url=""
                      data-ara-link-label="{{ section.settings.coming_soon_label | escape }}"
                      data-ara-monogram="{{ monogram | escape }}"
                      role="listitem"
                      aria-label="{{ block.settings.company_name | escape }} — {{ effective_status | escape }}"
                      {{ block.shopify_attributes }}
                    >
                  {% endif %}

                    <span class="ara-bookshelf-wall__book-cap" aria-hidden="true"></span>
                    <span class="ara-bookshelf-wall__book-volume">{{ block.settings.volume | escape }}</span>

                    {% if block.settings.spine_image != blank %}
                      <span class="ara-bookshelf-wall__book-art" aria-hidden="true">
                        {{
                          block.settings.spine_image
                          | image_url: width: 180
                          | image_tag:
                            widths: '60, 90, 120, 180',
                            sizes: '48px',
                            loading: 'lazy',
                            alt: ''
                        }}
                      </span>
                    {% endif %}

                    <span class="ara-bookshelf-wall__book-name">
                      {{ block.settings.spine_title | default: block.settings.company_name | escape }}
                    </span>

                    <span class="ara-bookshelf-wall__book-monogram">{{ monogram | escape }}</span>
                    <span class="ara-bookshelf-wall__book-status">{{ effective_status | escape }}</span>

                  {% if available %}
                    </a>
                  {% else %}
                    </button>
                  {% endif %}
                {% endfor %}
              {% endif %}
            </div>
          </div>

          <p class="ara-bookshelf-wall__empty" data-ara-empty hidden>
            {{ section.settings.empty_message | escape }}
          </p>

          <div class="ara-bookshelf-wall__shelf" aria-hidden="true">
            <span></span>
          </div>
        </div>

        <div class="ara-bookshelf-wall__frame-foot">
          <button
            type="button"
            data-ara-scroll="-1"
            aria-label="{{ section.settings.previous_label | escape }}"
          >
            ←
          </button>

          <div class="ara-bookshelf-wall__progress" aria-hidden="true">
            <span data-ara-progress></span>
          </div>

          <div class="ara-bookshelf-wall__foot-note">
            <span>{{ section.settings.base_label | escape }}</span>
          </div>

          <button
            type="button"
            data-ara-scroll="1"
            aria-label="{{ section.settings.next_label | escape }}"
          >
            →
          </button>
        </div>
      </div>
    </div>

    <footer class="ara-bookshelf-wall__pathway">
      <div>
        <span>{{ section.settings.pathway_eyebrow | escape }}</span>
        <h3>{{ section.settings.pathway_heading | escape }}</h3>
        <p>{{ section.settings.pathway_text | escape }}</p>
      </div>

      <div class="ara-bookshelf-wall__pathway-links">
        {% if section.settings.module_path_label != blank %}
          <a
            {% if section.settings.module_path_link != blank %}
              href="{{ section.settings.module_path_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            {{ section.settings.module_path_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}

        {% if section.settings.mint_path_label != blank %}
          <a
            class="ara-bookshelf-wall__pathway-link--secondary"
            {% if section.settings.mint_path_link != blank %}
              href="{{ section.settings.mint_path_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            {{ section.settings.mint_path_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>
    </footer>
  </div>
</section>

<style>
  #AraBookshelfCatalog-{{ section.id }} {
    position: relative;
    overflow: hidden;
    padding: var(--ara-bw-top) 0 var(--ara-bw-bottom);
    background: var(--ara-bw-bg);
    color: var(--ara-bw-ink);
  }

  #AraBookshelfCatalog-{{ section.id }} * {
    box-sizing: border-box;
  }

  #AraBookshelfCatalog-{{ section.id }} a {
    color: inherit;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__rules {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(
        to bottom,
        transparent 0 35px,
        color-mix(in srgb, var(--ara-bw-mint) 10%, transparent) 35px 36px
      );
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__inner {
    position: relative;
    width: min(100%, var(--ara-bw-max));
    margin: 0 auto;
    padding: 0 40px;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(340px, 0.85fr);
    gap: 56px;
    align-items: end;
    padding: 26px 0 31px;
    border-top: 4px solid var(--ara-bw-ink);
    border-bottom: 1px solid var(--ara-bw-ink);
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__eyebrow,
  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__pathway > div > span {
    margin: 0;
    color: var(--ara-bw-mint);
    font-family: var(--font-body-family);
    font-size: var(--ara-bw-label-desktop);
    font-weight: 900;
    letter-spacing: 0.17em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__intro h2 {
    margin: 12px 0 0;
    font-family: var(--font-heading-family);
    font-size: var(--ara-bw-heading-desktop);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    letter-spacing: -0.055em;
    line-height: 0.93;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__intro-side {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: end;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__description {
    color: var(--ara-bw-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-bw-body-desktop);
    line-height: 1.62;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__description p {
    margin: 0;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__count {
    display: grid;
    justify-items: end;
    gap: 5px;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__count strong {
    font-family: var(--font-heading-family);
    font-size: 45px;
    font-style: italic;
    font-weight: 600;
    line-height: 0.8;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__count span {
    max-width: 130px;
    color: var(--ara-bw-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-bw-label-desktop);
    font-weight: 900;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-align: right;
    text-transform: uppercase;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__toolbar {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    padding: 18px 0 12px;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__filters button,
  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__sort select {
    min-height: 36px;
    padding: 8px 12px;
    border: 1px solid var(--ara-bw-ink);
    border-radius: 0;
    background: var(--ara-bw-paper);
    color: var(--ara-bw-ink);
    font-family: var(--font-body-family);
    font-size: var(--ara-bw-label-desktop);
    font-weight: 900;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__filters button {
    cursor: pointer;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__filters button.is-active {
    background: var(--ara-bw-gold);
    box-shadow: 3px 3px 0 var(--ara-bw-ink);
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__sort {
    display: flex;
    gap: 9px;
    align-items: center;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__sort > span {
    color: var(--ara-bw-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-bw-label-desktop);
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__display {
    display: grid;
    grid-template-columns: minmax(280px, 0.34fr) minmax(0, 1.66fr);
    gap: 22px;
    align-items: stretch;
    margin-top: 26px;
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__selected {
    display: flex;
    min-height: 610px;
    flex-direction: column;
    overflow: hidden;
    padding: 25px;
    border: 1px solid var(--ara-bw-ink);
    border-radius: var(--ara-bw-radius);
    background: var(--ara-bw-paper);
    box-shadow: 8px 8px 0 color-mix(in srgb, var(--ara-bw-trim-secondary) 25%, transparent);
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__selected-top {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 15px;
    border-bottom: 1px solid var(--ara-bw-ink);
  }

  #AraBookshelfCatalog-{{ section.id }} .ara-bookshelf-wall__selected-top span,
