<section
  id="AraMintmarkHero-{{ section.id }}"
  class="ara-mintmark-hero"
  style="
    --ara-hero-bg: {{ section.settings.background_color }};
    --ara-hero-text: {{ section.settings.text_color }};
    --ara-hero-muted: {{ section.settings.muted_text_color }};
    --ara-hero-accent: {{ section.settings.accent_color }};
    --ara-hero-gold: {{ section.settings.gold_color }};
    --ara-hero-border: {{ section.settings.border_color }};
    --ara-hero-panel: {{ section.settings.panel_color }};
    --ara-hero-deep-bg: {{ section.settings.deep_background_color }};
    --ara-hero-blue: {{ section.settings.blue_color }};
    --ara-hero-blue-deep: {{ section.settings.blue_deep_color }};
    --ara-hero-line: {{ section.settings.line_color }};
    --ara-hero-overlay: {{ section.settings.overlay_strength | divided_by: 100.0 }};
    --ara-hero-max: {{ section.settings.max_width }};
    --ara-hero-min-height: {{ section.settings.minimum_height }}px;
    --ara-hero-padding-top: {{ section.settings.padding_top }}px;
    --ara-hero-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ara-hero-image-position: {{ section.settings.image_position }};
    --ara-hero-mobile-image-position: {{ section.settings.mobile_image_position }};
    --ara-hero-mobile-min-height: {{ section.settings.mobile_minimum_height }}px;
    --ara-hero-eyebrow-size: {{ section.settings.desktop_eyebrow_size }}px;
    --ara-hero-heading-size: {{ section.settings.desktop_heading_size }}px;
    --ara-hero-description-size: {{ section.settings.desktop_description_size }}px;
    --ara-hero-button-size: {{ section.settings.desktop_button_size }}px;
    --ara-hero-folio-size: {{ section.settings.desktop_folio_size }}px;
    --ara-hero-market-heading-size: {{ section.settings.desktop_market_heading_size }}px;
    --ara-hero-market-item-size: {{ section.settings.desktop_market_item_size }}px;
    --ara-hero-market-note-size: {{ section.settings.desktop_market_note_size }}px;
    --ara-hero-mobile-eyebrow-size: {{ section.settings.mobile_eyebrow_size }}px;
    --ara-hero-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --ara-hero-mobile-description-size: {{ section.settings.mobile_description_size }}px;
    --ara-hero-mobile-button-size: {{ section.settings.mobile_button_size }}px;
    --ara-hero-mobile-folio-size: {{ section.settings.mobile_folio_size }}px;
    --ara-hero-mobile-market-heading-size: {{ section.settings.mobile_market_heading_size }}px;
    --ara-hero-mobile-market-item-size: {{ section.settings.mobile_market_item_size }}px;
    --ara-hero-mobile-market-note-size: {{ section.settings.mobile_market_note_size }}px;
  "
>
  <div class="ara-mintmark-hero__media">
    {% if section.settings.background_image != blank %}
      <picture>
        {% if section.settings.mobile_background_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.mobile_background_image | image_url: width: 750 }} 750w,
              {{ section.settings.mobile_background_image | image_url: width: 1100 }} 1100w
            "
          >
        {% endif %}

        {{
          section.settings.background_image
          | image_url: width: 2600
          | image_tag:
            widths: '900, 1200, 1600, 2000, 2600',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'ara-mintmark-hero__background-image',
            alt: section.settings.background_image.alt
        }}
      </picture>
    {% else %}
      <div class="ara-mintmark-hero__placeholder">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'ara-mintmark-hero__placeholder-svg' }}
      </div>
    {% endif %}
  </div>

  <div class="ara-mintmark-hero__paper-lines" aria-hidden="true"></div>
  <div class="ara-mintmark-hero__overlay" aria-hidden="true"></div>

  {% if section.settings.image_caption != blank %}
    <span class="ara-mintmark-hero__image-caption">
      {{ section.settings.image_caption | escape }}
    </span>
  {% endif %}

  <div class="ara-mintmark-hero__inner">
    <div class="ara-mintmark-hero__content-frame">
      <div class="ara-mintmark-hero__content">
        <div class="ara-mintmark-hero__meta">
          {% if section.settings.eyebrow != blank %}
            <p class="ara-mintmark-hero__eyebrow">
              {{ section.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if section.settings.folio_text != blank %}
            <span class="ara-mintmark-hero__folio">
              {{ section.settings.folio_text | escape }}
            </span>
          {% endif %}
        </div>

      {% if section.settings.heading != blank %}
        <h1 class="ara-mintmark-hero__heading">
          {% assign highlighted_heading = section.settings.heading | escape | replace: 'read', '<mark>read</mark>' %}
          {{ highlighted_heading | newline_to_br }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="ara-mintmark-hero__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class="ara-mintmark-hero__buttons">
        {% if section.settings.primary_button_label != blank %}
          <a
            class="ara-mintmark-hero__button ara-mintmark-hero__button--primary"
            {% if section.settings.primary_button_link != blank %}
              href="{{ section.settings.primary_button_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            {{ section.settings.primary_button_label | escape }}
          </a>
        {% endif %}

        {% if section.settings.secondary_button_label != blank %}
          <a
            class="ara-mintmark-hero__button ara-mintmark-hero__button--secondary"
            {% if section.settings.secondary_button_link != blank %}
              href="{{ section.settings.secondary_button_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            {{ section.settings.secondary_button_label | escape }}
          </a>
        {% endif %}
      </div>

        {% if section.settings.bottom_note != blank %}
          <span class="ara-mintmark-hero__bottom-note">
            {{ section.settings.bottom_note | escape }}
          </span>
        {% endif %}
      </div>
    </div>

    {% if section.settings.show_market_snapshot %}
      <div class="ara-mintmark-hero__market-frame">
        <aside class="ara-mintmark-hero__market">
        <div class="ara-mintmark-hero__market-head">
          <div>
            <span>{{ section.settings.market_heading | escape }}</span>

            {% if section.settings.show_current_date %}
              <small>{{ 'now' | date: section.settings.date_format }}</small>
            {% elsif section.settings.custom_date != blank %}
              <small>{{ section.settings.custom_date | escape }}</small>
            {% endif %}
          </div>

          {% if section.settings.market_badge != blank %}
            <span class="ara-mintmark-hero__market-badge">
              {{ section.settings.market_badge | escape }}
            </span>
          {% endif %}
        </div>

        {% assign news_blocks = section.blocks | where: 'type', 'market_news' %}
        {% assign item_blocks = section.blocks | where: 'type', 'market_item' %}

        {% if news_blocks.size > 0 %}
          <div class="ara-mintmark-hero__market-news">
            {% for block in news_blocks %}
              <div class="ara-mintmark-hero__market-news-strip" {{ block.shopify_attributes }}>
                <div class="ara-mintmark-hero__market-news-strip-inner">
                  <div class="ara-mintmark-hero__market-news-front">
                    <strong>{{ block.settings.market_name | escape }}</strong>
                    <p>{{ block.settings.headline | escape }}</p>
                  </div>
                  <div class="ara-mintmark-hero__market-news-back">
                    <strong>{{ block.settings.market_name | escape }}</strong>
                    <span>{{ block.settings.market_value | escape }}</span>
                    <em class="ara-mintmark-hero__market-change ara-mintmark-hero__market-change--{{ block.settings.direction }}">
                      {% case block.settings.direction %}
                        {% when 'up' %}▲
                        {% when 'down' %}▼
                        {% else %}—
                      {% endcase %}
                      {{ block.settings.change | escape }}
                    </em>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if item_blocks.size > 0 %}
          <div class="ara-mintmark-hero__market-list">
            {% for block in item_blocks %}
              <div class="ara-mintmark-hero__market-item" {{ block.shopify_attributes }}>
                <div>
                  <strong>{{ block.settings.market_name | escape }}</strong>
                  {% if block.settings.market_value != blank %}
                    <span>{{ block.settings.market_value | escape }}</span>
                  {% endif %}
                </div>
                <em class="ara-mintmark-hero__market-change ara-mintmark-hero__market-change--{{ block.settings.direction }}">
                  {% case block.settings.direction %}
                    {% when 'up' %}▲
                    {% when 'down' %}▼
                    {% else %}—
                  {% endcase %}
                  {{ block.settings.change | escape }}
                </em>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.market_note != blank %}
          <p class="ara-mintmark-hero__market-note">
            {{ section.settings.market_note | escape }}
          </p>
        {% endif %}
        </aside>
      </div>
    {% endif %}
  </div>
</section>

<style>
  #AraMintmarkHero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    min-height: var(--ara-hero-min-height);
    border-bottom: 1px solid var(--ara-hero-border);
    background: var(--ara-hero-bg);
    color: var(--ara-hero-text);
    isolation: isolate;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__media,
  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__overlay,
  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__paper-lines {
    position: absolute;
    inset: 0;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__media {
    z-index: -4;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__media picture,
  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__background-image,
  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__placeholder,
  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__background-image {
    object-fit: cover;
    object-position: var(--ara-hero-image-position);
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__placeholder-svg {
    background: var(--ara-hero-bg);
    object-fit: cover;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__overlay {
    z-index: -3;
    background:
      linear-gradient(
        90deg,
        rgba(242, 251, 247, 0.98) 0%,
        rgba(242, 251, 247, 0.94) 25%,
        rgba(230, 247, 239, calc(var(--ara-hero-overlay) + 0.2)) 47%,
        rgba(230, 247, 239, var(--ara-hero-overlay)) 64%,
        rgba(220, 243, 233, 0.12) 100%
      );
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__paper-lines {
    z-index: -2;
    opacity: 0.78;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 34px,
      color-mix(in srgb, var(--ara-hero-line) 10%, transparent) 34px 35px,
      color-mix(in srgb, var(--ara-hero-line) 24%, transparent) 35px 38px,
      transparent 38px 40px
    );
    pointer-events: none;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(220px, 0.4fr);
    gap: clamp(32px, 5vw, 84px);
    align-items: stretch;
    width: min(100%, var(--ara-hero-max));
    min-height: var(--ara-hero-min-height);
    margin: 0 auto;
    padding: var(--ara-hero-padding-top) 40px var(--ara-hero-padding-bottom);
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__content {
    position: relative;
    z-index: 2;
    max-width: 760px;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__eyebrow {
    margin: 0 0 18px;
    color: var(--ara-hero-accent);
    font-family: var(--font-body-family);
    font-size: var(--ara-hero-eyebrow-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__heading {
    max-width: 760px;
    margin: 0;
    color: var(--ara-hero-text);
    font-family: var(--font-heading-family);
    font-size: var(--ara-hero-heading-size);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 0.94;
    letter-spacing: -0.055em;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__description {
    max-width: 560px;
    margin-top: 26px;
    color: var(--ara-hero-text);
    font-family: var(--font-body-family);
    font-size: var(--ara-hero-description-size);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.58;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__description p {
    margin: 0;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 30px;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__button {
    display: inline-flex;
    min-width: 190px;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 13px 24px;
    border: 1px solid var(--ara-hero-accent);
    font-family: var(--font-body-family);
    font-size: var(--ara-hero-button-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.13em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__button:hover {
    transform: translateY(-2px);
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__button--primary {
    background: var(--ara-hero-accent);
    color: #FFFFFF;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__button--secondary {
    background: color-mix(in srgb, var(--ara-hero-bg) 90%, transparent);
    color: var(--ara-hero-text);
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market {
    position: relative;
    z-index: 3;
    align-self: center;
    justify-self: end;
    width: min(100%, 280px);
    padding: 22px 20px;
    border: 1px solid var(--ara-hero-gold);
    background: color-mix(in srgb, var(--ara-hero-panel) 92%, transparent);
    box-shadow: 0 15px 30px rgba(22, 27, 46, 0.08);
    backdrop-filter: blur(2px);
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-head {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: flex-start;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--ara-hero-border);
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-head > div {
    display: grid;
    gap: 4px;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-head span,
  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-head small,
  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-badge {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    line-height: 1.25;
    text-transform: uppercase;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-head span {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-head small {
    color: var(--ara-hero-muted);
    font-size: 8px;
    font-weight: var(--font-body-weight);
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-badge {
    color: var(--ara-hero-gold);
    font-size: 7px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-news {
    display: grid;
    margin-bottom: 12px;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-news-strip {
    position: relative;
    width: 100%;
    min-height: 48px;
    perspective: 1000px;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.26);
    cursor: default;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-news-strip-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-news-strip:hover .ara-mintmark-hero__market-news-strip-inner {
    transform: rotateX(180deg);
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-news-front,
  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-news-back {
    position: absolute;
    inset: 0;
    display: grid;
    align-items: center;
    backface-visibility: hidden;
    padding: 12px 0;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-news-front {
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-news-back {
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 12px;
    transform: rotateX(180deg);
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-news-front strong,
  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-news-back strong {
    color: var(--ara-hero-gold);
    font-family: var(--font-body-family);
    font-size: 10px;
    font-weight: 900;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-news-front p {
    margin: 0;
    color: #FFFFFF;
    font-family: var(--font-body-family);
    font-size: var(--ara-hero-market-item-size);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-news-back span {
    color: #FFFFFF;
    font-family: var(--font-body-family);
    font-size: var(--ara-hero-market-item-size);
    line-height: 1.2;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-list {
    display: grid;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    align-items: end;
    padding: 12px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ara-hero-border) 65%, transparent);
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-item > div {
    display: grid;
    gap: 3px;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-item strong,
  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-item span,
  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-change {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    line-height: 1.2;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-item strong {
    font-size: 9px;
    font-weight: 800;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-item span {
    color: var(--ara-hero-muted);
    font-size: 8px;
    font-weight: 600;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-change {
    font-size: 9px;
    font-weight: 800;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-change--up {
    color: #00C805;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-change--down {
    color: #FF5000;
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-change--flat {
    color: var(--ara-hero-muted);
  }

  #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-note {
    margin: 16px 0 0;
    color: var(--ara-hero-accent);
    font-family: var(--font-body-family);
    font-size: 9px;
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.5;
  }
@media screen and (max-width: 1199px) {
    #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(210px, 0.35fr);
    }

  }

  @media screen and (max-width: 899px) {
    #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__overlay {
      background:
        linear-gradient(
          90deg,
          rgba(242, 251, 247, 0.98) 0%,
          rgba(242, 251, 247, 0.94) 38%,
          rgba(230, 247, 239, 0.72) 68%,
          rgba(220, 243, 233, 0.34) 100%
        );
    }

    #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__inner {
      grid-template-columns: 1fr;
      align-content: center;
    }

    #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market {
      justify-self: start;
      width: min(100%, 520px);
    }

    #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__market-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 18px;
    }
}

  @media screen and (max-width: 749px) {
    #AraMintmarkHero-{{ section.id }} {
      min-height: auto;
    }

    #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__media {
      position: relative;
      z-index: -1;
      height: 390px;
      order: 2;
    }

    #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__background-image {
      object-position: center center;
    }

    #AraMintmarkHero-{{ section.id }} .ara-mintmark-hero__overlay {
      display: none;
    }

