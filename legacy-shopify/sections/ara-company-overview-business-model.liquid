    }

    #AraCompanyOverview-{{ section.id }} .ara-company-overview__profile-frame,
    #AraCompanyOverview-{{ section.id }} .ara-company-overview__model-frame {
      padding: 5px;
    }

    #AraCompanyOverview-{{ section.id }} .ara-company-overview__profile-frame {
      box-shadow:
        5px 5px 0 var(--ara-overview-gold),
        10px 10px 0 color-mix(in srgb, var(--ara-overview-mint) 66%, transparent);
    }

    #AraCompanyOverview-{{ section.id }} .ara-company-overview__model-frame {
      box-shadow:
        5px 5px 0 var(--ara-overview-blue-deep),
