    border-radius: 7px;
  }
</style>


<style>
  #AraCompanyOverview-{{ section.id }} .ara-company-file__brand-rule {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    margin-bottom: clamp(24px, 3vw, 38px);
    padding: 10px 0 12px;
    border-top: 2px solid #161B2E;
    border-bottom: 1px solid #161B2E;
  }

  #AraCompanyOverview-{{ section.id }} .ara-company-file__brand-rule img {
    display: block;
    width: min(100%, 170px);
    height: auto;
  }

  #AraCompanyOverview-{{ section.id }} .ara-company-file__brand-rule span {
    color: #161B2E;
    font-family: var(--font-body-family);
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .16em;
    text-align: right;
  }

  #AraCompanyOverview-{{ section.id }} [class*="__card"],
  #AraCompanyOverview-{{ section.id }} [class*="__frame"],
  #AraCompanyOverview-{{ section.id }} [class*="__panel"] {
