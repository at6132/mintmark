    #AraCompanyOverview-{{ section.id }} .ara-company-overview__model {
      padding: 22px 18px;
    }

    #AraCompanyOverview-{{ section.id }} .ara-company-overview__profile-head,
    #AraCompanyOverview-{{ section.id }} .ara-company-overview__model-head,
    #AraCompanyOverview-{{ section.id }} .ara-company-overview__model-summary {
      align-items: flex-start;
      flex-direction: column;
    }

    #AraCompanyOverview-{{ section.id }} .ara-company-overview__profile-head small {
      text-align: left;
    }

    #AraCompanyOverview-{{ section.id }} .ara-company-overview__facts,
    #AraCompanyOverview-{{ section.id }} .ara-company-overview__steps {
      grid-template-columns: 1fr;
    }

    #AraCompanyOverview-{{ section.id }} .ara-company-overview__fact strong {
      font-size: var(--ara-overview-fact-title-mobile);
    }

    #AraCompanyOverview-{{ section.id }} .ara-company-overview__fact p,
    #AraCompanyOverview-{{ section.id }} .ara-company-overview__step p {
      font-size: var(--ara-overview-step-text-mobile);
    }

    #AraCompanyOverview-{{ section.id }} .ara-company-overview__step {
      min-height: 0;
    }

    #AraCompanyOverview-{{ section.id }} .ara-company-overview__step h3 {
      font-size: var(--ara-overview-step-title-mobile);
    }

    #AraCompanyOverview-{{ section.id }} .ara-company-overview__model-summary span {
      flex-basis: auto;
    }
