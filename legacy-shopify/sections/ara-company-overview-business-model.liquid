    #AraCompanyOverview-{{ section.id }} .ara-company-overview__fact span,
    #AraCompanyOverview-{{ section.id }} .ara-company-overview__model-head span,
    #AraCompanyOverview-{{ section.id }} .ara-company-overview__model-head small,
    #AraCompanyOverview-{{ section.id }} .ara-company-overview__model-badge,
