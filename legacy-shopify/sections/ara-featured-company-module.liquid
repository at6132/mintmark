<script>
(function () {
  var companies = [
    { folio: 'FILE 01', ticker: 'AAPL', exchange: 'NASDAQ', name: 'Apple', subtitle: 'THE MACHINE THAT PRINTS VALUE', summary: 'See how Apple connects hardware, software, services and capital into one of the world\u2019s most durable business systems.', sector: 'Technology', hq: 'Cupertino, CA' },
    { folio: 'FILE 02', ticker: 'NVDA', exchange: 'NASDAQ', name: 'NVIDIA', subtitle: 'THE COMPUTE PLATFORM BEHIND AI', summary: 'See how NVIDIA turned graphics chips into the core infrastructure powering the entire AI buildout.', sector: 'Technology', hq: 'Santa Clara, CA' },
    { folio: 'FILE 03', ticker: 'GOOGL', exchange: 'NASDAQ', name: 'Alphabet', subtitle: 'THE ATTENTION AND SEARCH MACHINE', summary: 'See how Alphabet turns search, advertising, cloud and data into one of the most profitable systems ever built.', sector: 'Technology', hq: 'Mountain View, CA' },
    { folio: 'FILE 04', ticker: 'RBLX', exchange: 'NYSE', name: 'Roblox', subtitle: 'THE PLATFORM WHERE KIDS BUILD THE ECONOMY', summary: 'See how Roblox turns user-generated games and virtual currency into a self-sustaining creator economy.', sector: 'Technology', hq: 'San Mateo, CA' },
    { folio: 'FILE 05', ticker: 'AMZN', exchange: 'NASDAQ', name: 'Amazon', subtitle: 'THE EVERYTHING STORE, BUILT ON LOGISTICS', summary: 'See how Amazon connects marketplace, logistics, subscriptions and cloud computing into one company.', sector: 'Technology', hq: 'Seattle, WA' },
    { folio: 'FILE 06', ticker: 'MSFT', exchange: 'NASDAQ', name: 'Microsoft', subtitle: 'SOFTWARE, CLOUD AND THE ENTERPRISE MOAT', summary: 'See how Microsoft turned enterprise software into a recurring subscription and cloud infrastructure empire.', sector: 'Technology', hq: 'Redmond, WA' },
    { folio: 'FILE 07', ticker: 'TSLA', exchange: 'NASDAQ', name: 'Tesla', subtitle: 'THE FACTORY BEHIND THE BRAND', summary: 'See how Tesla combines manufacturing, software and energy products into one integrated system.', sector: 'Consumer', hq: 'Austin, TX' },
    { folio: 'FILE 08', ticker: 'NFLX', exchange: 'NASDAQ', name: 'Netflix', subtitle: 'THE SUBSCRIPTION ATTENTION MACHINE', summary: 'See how Netflix turns content spending and global subscriptions into a durable recurring-revenue business.', sector: 'Media', hq: 'Los Gatos, CA' },
    { folio: 'FILE 09', ticker: 'COST', exchange: 'NASDAQ', name: 'Costco', subtitle: 'THE MEMBERSHIP MACHINE', summary: 'See how Costco turns membership fees and thin margins into an unusually durable retail business.', sector: 'Retail', hq: 'Issaquah, WA' },
    { folio: 'FILE 10', ticker: 'DIS', exchange: 'NYSE', name: 'Disney', subtitle: 'THE STORY-TO-EXPERIENCE MACHINE', summary: 'See how Disney turns stories into films, products, streaming and theme park experiences.', sector: 'Media', hq: 'Burbank, CA' }
  ];

  var root = document.getElementById('AraFeaturedCompany-{{ section.id }}');
  if (!root) return;

  var body = root.querySelector('[data-ara-fc="body"]');
  var els = {
    folio: root.querySelector('[data-ara-fc="folio-number"]'),
    logo: root.querySelector('[data-ara-fc="logo"]'),
    ticker: root.querySelector('[data-ara-fc="ticker"]'),
    exchange: root.querySelector('[data-ara-fc="exchange"]'),
    name: root.querySelector('[data-ara-fc="name"]'),
    subtitle: root.querySelector('[data-ara-fc="subtitle"]'),
    summary: root.querySelector('[data-ara-fc="summary"]'),
    sector: root.querySelector('[data-ara-fc="sector"]'),
    hq: root.querySelector('[data-ara-fc="hq"]')
  };

  var index = 0;

  function paint(c) {
    if (els.folio) els.folio.textContent = c.folio;
    if (els.logo) els.logo.innerHTML = '<div class="ara-featured-company__logo-badge">' + c.ticker.slice(0, 4) + '</div>';
    if (els.ticker) els.ticker.textContent = c.ticker;
    if (els.exchange) els.exchange.textContent = c.exchange;
    if (els.name) els.name.textContent = c.name;
    if (els.subtitle) els.subtitle.textContent = c.subtitle;
    if (els.summary) els.summary.innerHTML = '<p>' + c.summary + '</p>';
    if (els.sector) els.sector.textContent = c.sector;
    if (els.hq) els.hq.textContent = c.hq;
  }

  paint(companies[0]);

  setInterval(function () {
    index = (index + 1) % companies.length;

    if (body) {
      body.classList.add('ara-fc-fading');

      setTimeout(function () {
        paint(companies[index]);
        body.classList.remove('ara-fc-fading');
      }, 380);
    } else {
      paint(companies[index]);
    }
  }, 4000);
})();
</script>

