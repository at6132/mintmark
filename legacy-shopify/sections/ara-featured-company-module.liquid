{% liquid
  assign selected_product = section.settings.book_product
  assign selected_blog = section.settings.blog
  assign company_tag = section.settings.company_tag | strip
  assign company_tag_handle = company_tag | handleize

  assign book_title = section.settings.custom_book_title
  assign book_cover = section.settings.custom_book_cover
  assign book_link = section.settings.custom_book_link

  if selected_product != blank
    if book_title == blank
      assign book_title = selected_product.title
    endif

    if book_cover == blank
      assign book_cover = selected_product.featured_image
    endif

    if book_link == blank
      assign book_link = selected_product.url
    endif
  endif

  assign archive_url = section.settings.archive_link

  if archive_url == blank and selected_blog != blank
    assign archive_url = selected_blog.url

    if company_tag != blank
      assign archive_url = selected_blog.url | append: '/tagged/' | append: company_tag_handle
    endif
  endif
%}

<section
  id="AraFeaturedCompany-{{ section.id }}"
  class="ara-featured-company"
  style="
    --ara-fc-bg: {{ section.settings.background_color }};
    --ara-fc-paper: {{ section.settings.paper_color }};
    --ara-fc-deep: {{ section.settings.deep_color }};
    --ara-fc-text: {{ section.settings.text_color }};
    --ara-fc-muted: {{ section.settings.muted_text_color }};
    --ara-fc-mint: {{ section.settings.mint_color }};
    --ara-fc-gold: {{ section.settings.gold_color }};
    --ara-fc-blue: {{ section.settings.blue_color }};
    --ara-fc-border: {{ section.settings.border_color }};
    --ara-fc-line: {{ section.settings.line_color }};
    --ara-fc-max: {{ section.settings.max_width }};
    --ara-fc-top: {{ section.settings.padding_top }}px;
    --ara-fc-bottom: {{ section.settings.padding_bottom }}px;
    --ara-fc-heading-desktop: {{ section.settings.desktop_heading_size }}px;
    --ara-fc-company-desktop: {{ section.settings.desktop_company_size }}px;
    --ara-fc-story-desktop: {{ section.settings.desktop_story_size }}px;
    --ara-fc-body-desktop: {{ section.settings.desktop_body_size }}px;
    --ara-fc-label-desktop: {{ section.settings.desktop_label_size }}px;
    --ara-fc-heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --ara-fc-company-mobile: {{ section.settings.mobile_company_size }}px;
    --ara-fc-story-mobile: {{ section.settings.mobile_story_size }}px;
    --ara-fc-body-mobile: {{ section.settings.mobile_body_size }}px;
    --ara-fc-label-mobile: {{ section.settings.mobile_label_size }}px;
  "
>
  <div class="ara-featured-company__inner">
    <div class="ara-featured-company__topline">
      <div>
        {% if section.settings.eyebrow != blank %}
          <span class="ara-featured-company__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>

      {% if section.settings.top_note != blank %}
        <p>{{ section.settings.top_note | escape }}</p>
      {% endif %}
    </div>

    <div class="ara-featured-company__frame">
      <div class="ara-featured-company__company-panel">
        <div class="ara-featured-company__company-body" data-ara-fc="body">
          <div class="ara-featured-company__panel-folio">
            <span>{{ section.settings.company_folio | escape }}</span>
            <span data-ara-fc="folio-number">{{ section.settings.company_number | escape }}</span>
          </div>

          <div class="ara-featured-company__company-header">
            <div class="ara-featured-company__logo" data-ara-fc="logo">
              {% if section.settings.company_logo != blank %}
                {{
                  section.settings.company_logo
                  | image_url: width: 360
                  | image_tag:
                    widths: '120, 180, 240, 360',
                    sizes: '90px',
                    loading: 'lazy',
                    class: 'ara-featured-company__logo-image',
                    alt: section.settings.company_logo.alt
                }}
              {% endif %}
            </div>

            <div class="ara-featured-company__ticker">
              <span data-ara-fc="ticker">{{ section.settings.ticker | escape }}</span>
              <small data-ara-fc="exchange">{{ section.settings.exchange | escape }}</small>
            </div>
          </div>

          <h3 data-ara-fc="name">{{ section.settings.company_name | escape }}</h3>

          <p class="ara-featured-company__company-subtitle" data-ara-fc="subtitle">
            {{ section.settings.company_subtitle | escape }}
          </p>

          <div class="ara-featured-company__company-summary" data-ara-fc="summary">
            {{ section.settings.company_summary }}
          </div>

          <div class="ara-featured-company__company-meta">
            <span>
              <small>{{ section.settings.sector_label | escape }}</small>
              <b data-ara-fc="sector">{{ section.settings.sector | escape }}</b>
            </span>

            <span>
              <small>{{ section.settings.headquarters_label | escape }}</small>
              <b data-ara-fc="hq">{{ section.settings.headquarters | escape }}</b>
            </span>
          </div>
        </div>

        {% if section.settings.module_button_label != blank %}
          <a
            class="ara-featured-company__button ara-featured-company__button--primary"
            {% if section.settings.module_button_link != blank %}
              href="{{ section.settings.module_button_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            {{ section.settings.module_button_label | escape }}
          </a>
        {% endif %}
      </div>

      <div class="ara-featured-company__book-panel">
        <div class="ara-featured-company__panel-folio">
          <span>{{ section.settings.book_folio | escape }}</span>
          <span>{{ section.settings.book_issue | escape }}</span>
        </div>

        <div class="ara-featured-company__book-visual">
          {% if book_cover != blank %}
            {{
              book_cover
              | image_url: width: 1000
              | image_tag:
                widths: '320, 480, 640, 800, 1000',
                sizes: '(max-width: 749px) 68vw, 270px',
                loading: 'lazy',
                class: 'ara-featured-company__book-image',
                alt: book_cover.alt
            }}
          {% else %}
            <div class="ara-featured-company__book-placeholder">
              <span>{{ section.settings.book_placeholder | escape }}</span>
            </div>
          {% endif %}
        </div>

        <div class="ara-featured-company__book-copy">
          <span>{{ section.settings.book_label | escape }}</span>

          {% if book_title != blank %}
            <h3>{{ book_title | escape }}</h3>
          {% endif %}

          {% if section.settings.book_description != blank %}
            <p>{{ section.settings.book_description | escape }}</p>
          {% endif %}

          {% if section.settings.show_product_price and selected_product != blank %}
            <strong>{{ selected_product.price | money }}</strong>
          {% elsif section.settings.custom_price != blank %}
            <strong>{{ section.settings.custom_price | escape }}</strong>
          {% endif %}

          {% if section.settings.book_button_label != blank %}
            <a
              class="ara-featured-company__book-link"
              {% if book_link != blank %}
                href="{{ book_link }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              {{ section.settings.book_button_label | escape }}
            </a>
          {% endif %}
        </div>
      </div>

      <div class="ara-featured-company__stories-panel">
        <div class="ara-featured-company__stories-heading">
          <div>
            <span>{{ section.settings.stories_label | escape }}</span>

            {% if section.settings.stories_heading != blank %}
              <h3>{{ section.settings.stories_heading | escape }}</h3>
            {% endif %}
          </div>

          {% if company_tag != blank %}
            <small>{{ company_tag | escape }}</small>
          {% endif %}
        </div>

        <div class="ara-featured-company__stories">
          {% assign shown_articles = 0 %}

          {% if selected_blog != blank %}
            {% for story in selected_blog.articles limit: 50 %}
              {% assign story_matches = false %}

              {% if company_tag == blank %}
                {% assign story_matches = true %}
              {% elsif story.tags contains company_tag %}
                {% assign story_matches = true %}
              {% endif %}

              {% if story_matches %}
                {% assign shown_articles = shown_articles | plus: 1 %}

                <article class="ara-featured-company__story">
                  <a
                    href="{{ story.url }}"
                    class="ara-featured-company__story-image-wrap"
                    aria-label="{{ story.title | escape }}"
                  >
                    {% if story.image != blank %}
                      {{
                        story.image
                        | image_url: width: 800
                        | image_tag:
                          widths: '240, 360, 520, 680, 800',
                          sizes: '(max-width: 749px) 36vw, 170px',
                          loading: 'lazy',
                          class: 'ara-featured-company__story-image',
                          alt: story.image.alt
                      }}
                    {% else %}
                      <div class="ara-featured-company__story-placeholder">
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'ara-featured-company__story-placeholder-svg' }}
                      </div>
                    {% endif %}
                  </a>

                  <div class="ara-featured-company__story-copy">
                    <div class="ara-featured-company__story-meta">
                      <span>
                        {{ shown_articles | prepend: '0' | slice: -2, 2 }}
                      </span>
                      <small>{{ story.published_at | date: section.settings.date_format }}</small>
                    </div>

                    <h4>
                      <a href="{{ story.url }}">{{ story.title | escape }}</a>
                    </h4>

                    <p>
                      {{ story.excerpt_or_content | strip_html | truncate: 125 }}
                    </p>

                    <a class="ara-featured-company__story-link" href="{{ story.url }}">
                      {{ section.settings.story_link_label | escape }}
                    </a>
                  </div>
                </article>

                {% if shown_articles >= section.settings.articles_limit %}
                  {% break %}
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endif %}

          {% if shown_articles == 0 %}
            <div class="ara-featured-company__empty">
              <span>{{ section.settings.empty_heading | escape }}</span>
              <p>{{ section.settings.empty_text | escape }}</p>
            </div>
          {% endif %}
        </div>

        {% if section.settings.archive_button_label != blank %}
          <a
            class="ara-featured-company__archive-link"
            {% if archive_url != blank %}
              href="{{ archive_url }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            <span>{{ section.settings.archive_button_label | escape }}</span>
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ara-featured-company__bottomline">
      <span>{{ section.settings.bottom_left | escape }}</span>
      <span>{{ section.settings.bottom_center | escape }}</span>
      <span>{{ section.settings.bottom_right | escape }}</span>
    </div>
  </div>
</section>

<style>
  #AraFeaturedCompany-{{ section.id }} {
    overflow: hidden;
    border-top: 1px solid var(--ara-fc-border);
    border-bottom: 1px solid var(--ara-fc-border);
    background-color: var(--ara-fc-bg);
    background-image:
      linear-gradient(
        90deg,
        transparent 0,
        transparent 39px,
        color-mix(in srgb, var(--ara-fc-line) 10%, transparent) 39px,
        color-mix(in srgb, var(--ara-fc-line) 10%, transparent) 40px
      ),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 34px,
        color-mix(in srgb, var(--ara-fc-line) 17%, transparent) 34px,
        color-mix(in srgb, var(--ara-fc-line) 17%, transparent) 35px
      );
    color: var(--ara-fc-text);
  }

  #AraFeaturedCompany-{{ section.id }} * {
    box-sizing: border-box;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__inner {
    width: min(100%, var(--ara-fc-max));
    margin: 0 auto;
    padding: var(--ara-fc-top) 40px var(--ara-fc-bottom);
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__topline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.55fr);
    gap: 40px;
    align-items: end;
    margin-bottom: 24px;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__eyebrow,
  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__panel-folio,
  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__ticker,
  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-meta,
  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__book-copy > span,
  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__stories-heading > div > span,
  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__stories-heading small,
  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__story-meta,
  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__bottomline {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__eyebrow {
    display: inline-flex;
    padding: 6px 10px;
    border: 1px solid var(--ara-fc-text);
    border-radius: 5px;
    background: var(--ara-fc-gold);
    color: var(--ara-fc-text);
    font-size: var(--ara-fc-label-desktop);
    box-shadow: 3px 3px 0 var(--ara-fc-text);
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__topline h2 {
    margin: 20px 0 0;
    font-family: var(--font-heading-family);
    font-size: var(--ara-fc-heading-desktop);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__topline > p {
    margin: 0;
    color: var(--ara-fc-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-fc-body-desktop);
    line-height: 1.6;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__frame {
    display: grid;
    grid-template-columns: minmax(280px, 0.82fr) minmax(250px, 0.68fr) minmax(480px, 1.5fr);
    border: 2px solid var(--ara-fc-text);
    border-radius: 17px;
    overflow: hidden;
    background: var(--ara-fc-paper);
    box-shadow:
      7px 7px 0 var(--ara-fc-text),
      12px 12px 0 var(--ara-fc-gold);
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-panel,
  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__book-panel,
  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__stories-panel {
    min-width: 0;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-panel {
    display: flex;
    flex-direction: column;
    padding: 25px;
    background:
      radial-gradient(circle at 82% 18%, color-mix(in srgb, var(--ara-fc-mint) 16%, transparent), transparent 28%),
      var(--ara-fc-paper);
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-body {
    transition: opacity 380ms ease;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-body.ara-fc-fading {
    opacity: 0;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__logo-badge {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    background: var(--ara-fc-mint);
    color: #FFFFFF;
    font-family: var(--font-heading-family);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__book-panel,
  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__stories-panel {
    border-left: 2px solid var(--ara-fc-text);
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__book-panel {
    display: grid;
    grid-template-rows: auto minmax(280px, 1fr) auto;
    background: color-mix(in srgb, var(--ara-fc-gold) 15%, var(--ara-fc-paper));
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__stories-panel {
    display: flex;
    flex-direction: column;
    background: var(--ara-fc-paper);
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__panel-folio {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: -25px -25px 23px;
    padding: 11px 15px;
    border-bottom: 1px solid var(--ara-fc-text);
    background: var(--ara-fc-deep);
    color: #FFFFFF;
    font-size: var(--ara-fc-label-desktop);
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__book-panel .ara-featured-company__panel-folio {
    margin: 0;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-header {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__logo {
    display: grid;
    width: 74px;
    height: 74px;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--ara-fc-border);
    border-radius: 12px;
    background: #FFFFFF;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__logo-image {
    display: block;
    width: 78%;
    height: 78%;
    object-fit: contain;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__ticker {
    display: grid;
    min-width: 88px;
    gap: 4px;
    padding: 10px 12px;
    border: 1px solid var(--ara-fc-text);
    border-radius: 8px;
    background: var(--ara-fc-mint);
    color: #FFFFFF;
    font-size: var(--ara-fc-label-desktop);
    text-align: right;
    box-shadow: 3px 3px 0 var(--ara-fc-text);
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__ticker small {
    font: inherit;
    opacity: 0.72;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-panel > h3,
  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-body > h3 {
    margin: 30px 0 0;
    font-family: var(--font-heading-family);
    font-size: var(--ara-fc-company-desktop);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-subtitle {
    margin: 12px 0 0;
    color: var(--ara-fc-mint);
    font-family: var(--font-body-family);
    font-size: var(--ara-fc-label-desktop);
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-summary {
    margin-top: 21px;
    color: var(--ara-fc-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-fc-body-desktop);
    line-height: 1.62;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-summary p {
    margin: 0;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 25px;
    padding-top: 18px;
    border-top: 1px dashed var(--ara-fc-border);
    font-size: var(--ara-fc-label-desktop);
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-meta > span {
    display: grid;
    gap: 5px;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-meta small {
    color: var(--ara-fc-muted);
    font: inherit;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__company-meta b {
    font: inherit;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__button {
    display: inline-flex;
    min-height: 45px;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    padding: 11px 15px;
    border: 2px solid var(--ara-fc-text);
    border-radius: 7px;
    font-family: var(--font-body-family);
    font-size: var(--ara-fc-label-desktop);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 3px 3px 0 var(--ara-fc-text);
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__button--primary {
    background: var(--ara-fc-gold);
    color: var(--ara-fc-text);
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__book-visual {
    display: grid;
    min-height: 300px;
    place-items: center;
    padding: 24px;
    border-bottom: 1px solid var(--ara-fc-text);
    background:
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--ara-fc-gold) 24%, transparent), transparent 40%),
      var(--ara-fc-paper);
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__book-image {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 330px;
    object-fit: contain;
    filter: drop-shadow(10px 12px 12px rgba(22, 27, 46, 0.2));
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__book-placeholder {
    display: grid;
    width: min(100%, 205px);
    aspect-ratio: 3 / 4;
    place-items: center;
    padding: 20px;
    border: 2px solid var(--ara-fc-text);
    background: var(--ara-fc-deep);
    color: var(--ara-fc-gold);
    font-family: var(--font-body-family);
    font-size: var(--ara-fc-label-desktop);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
    box-shadow: 6px 7px 0 var(--ara-fc-gold);
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__book-copy {
    display: grid;
    gap: 10px;
    padding: 20px;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__book-copy > span {
    color: var(--ara-fc-mint);
    font-size: var(--ara-fc-label-desktop);
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__book-copy h3 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(26px, 2.15vw, 38px);
    line-height: 0.98;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__book-copy p {
    margin: 0;
    color: var(--ara-fc-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-fc-body-desktop);
    line-height: 1.48;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__book-copy strong {
    font-family: var(--font-heading-family);
    font-size: 23px;
  }

  #AraFeaturedCompany-{{ section.id }} .ara-featured-company__book-link {
    display: inline-flex;
    justify-content: space-between;
    gap: 14px;
    align-items: center;
    padding-top: 11px;
    border-top: 1px solid var(--ara-fc-text);
    color: var(--ara-fc-text);
