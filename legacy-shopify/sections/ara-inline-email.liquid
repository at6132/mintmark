<section
  id="AraInlineEmail-{{ section.id }}"
  class="ara-inline-email"
  style="
    --ara-email-bg: {{ section.settings.background_color }};
    --ara-email-text: {{ section.settings.text_color }};
    --ara-email-muted: {{ section.settings.muted_text_color }};
    --ara-email-accent: {{ section.settings.accent_color }};
    --ara-email-border: {{ section.settings.border_color }};
    --ara-email-field: {{ section.settings.field_color }};
    --ara-email-button: {{ section.settings.button_color }};
    --ara-email-button-text: {{ section.settings.button_text_color }};
    --ara-email-max: {{ section.settings.max_width }};
    --ara-email-top: {{ section.settings.padding_top }}px;
    --ara-email-bottom: {{ section.settings.padding_bottom }}px;
    --ara-email-heading-size: {{ section.settings.desktop_heading_size }}px;
    --ara-email-description-size: {{ section.settings.desktop_description_size }}px;
    --ara-email-input-size: {{ section.settings.desktop_input_size }}px;
    --ara-email-button-size: {{ section.settings.desktop_button_size }}px;
    --ara-email-message-size: {{ section.settings.desktop_message_size }}px;
    --ara-email-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --ara-email-mobile-description-size: {{ section.settings.mobile_description_size }}px;
    --ara-email-mobile-input-size: {{ section.settings.mobile_input_size }}px;
    --ara-email-mobile-button-size: {{ section.settings.mobile_button_size }}px;
    --ara-email-mobile-message-size: {{ section.settings.mobile_message_size }}px;
  "
>
  <div class="ara-inline-email__inner">
    <div class="ara-inline-email__intro">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p>{{ section.settings.description | escape }}</p>
      {% endif %}
    </div>

    {% form 'customer', class: 'ara-inline-email__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      <label
        class="visually-hidden"
        for="AraInlineEmailField-{{ section.id }}"
      >
        Email address
      </label>

      <input
        id="AraInlineEmailField-{{ section.id }}"
        class="ara-inline-email__input"
        type="email"
        name="contact[email]"
        value="{{ form.email }}"
        placeholder="{{ section.settings.placeholder | escape }}"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        required
      >

      <button
        type="submit"
        class="ara-inline-email__button"
        name="commit"
      >
        {{ section.settings.button_label | escape }}
      </button>

      {% if form.posted_successfully? %}
        <p class="ara-inline-email__message">
          {{ section.settings.success_message | escape }}
        </p>
      {% endif %}

      {% if form.errors %}
        <div class="ara-inline-email__message ara-inline-email__message--error">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
    {% endform %}
  </div>
</section>

<style>
  #AraInlineEmail-{{ section.id }} {
    background: var(--ara-email-bg);
    color: var(--ara-email-text);
  }

  #AraInlineEmail-{{ section.id }} .ara-inline-email__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(480px, 1.1fr);
    gap: clamp(34px, 5vw, 78px);
    align-items: center;
    width: min(100%, var(--ara-email-max));
    margin: 0 auto;
    padding: var(--ara-email-top) 40px var(--ara-email-bottom);
    border: 1px solid var(--ara-email-border);
  }

  #AraInlineEmail-{{ section.id }} .ara-inline-email__intro {
    display: block;
  }

  #AraInlineEmail-{{ section.id }} .ara-inline-email__intro h2 {
    margin: 0;
    color: var(--ara-email-text);
    font-family: var(--font-body-family);
    font-size: var(--ara-email-heading-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.08em;
  }

  #AraInlineEmail-{{ section.id }} .ara-inline-email__intro p {
    margin: 7px 0 0;
    color: var(--ara-email-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-email-description-size);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.45;
  }

  #AraInlineEmail-{{ section.id }} .ara-inline-email__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0;
  }

  #AraInlineEmail-{{ section.id }} .ara-inline-email__input {
    min-height: 52px;
    padding: 12px 16px;
    border: 1px solid var(--ara-email-border);
    border-right: 0;
    border-radius: 0;
    outline: 0;
    background: var(--ara-email-field);
    color: var(--ara-email-text);
    font-family: var(--font-body-family);
    font-size: var(--ara-email-input-size);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
  }

  #AraInlineEmail-{{ section.id }} .ara-inline-email__input::placeholder {
    color: var(--ara-email-muted);
  }

  #AraInlineEmail-{{ section.id }} .ara-inline-email__input:focus {
    border-color: var(--ara-email-accent);
    box-shadow: inset 0 0 0 1px var(--ara-email-accent);
  }

  #AraInlineEmail-{{ section.id }} .ara-inline-email__button {
    min-width: 210px;
    min-height: 52px;
    padding: 12px 24px;
    border: 1px solid var(--ara-email-button);
    border-radius: 0;
    background: var(--ara-email-button);
    color: var(--ara-email-button-text);
    cursor: pointer;
    font-family: var(--font-body-family);
    font-size: var(--ara-email-button-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  #AraInlineEmail-{{ section.id }} .ara-inline-email__message {
    grid-column: 1 / -1;
    margin: 10px 0 0;
    color: var(--ara-email-accent);
    font-family: var(--font-body-family);
    font-size: var(--ara-email-message-size);
    font-style: var(--font-body-style);
    line-height: 1.4;
  }

  #AraInlineEmail-{{ section.id }} .ara-inline-email__message--error {
    color: #B42318;
  }

  @media screen and (max-width: 900px) {
    #AraInlineEmail-{{ section.id }} .ara-inline-email__inner {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    #AraInlineEmail-{{ section.id }} .ara-inline-email__inner {
      width: auto;
      margin: 0 20px;
      padding-right: 20px;
      padding-left: 20px;
    }

    #AraInlineEmail-{{ section.id }} .ara-inline-email__intro h2 {
      font-size: var(--ara-email-mobile-heading-size);
    }

    #AraInlineEmail-{{ section.id }} .ara-inline-email__intro p {
      font-size: var(--ara-email-mobile-description-size);
    }

    #AraInlineEmail-{{ section.id }} .ara-inline-email__form {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    #AraInlineEmail-{{ section.id }} .ara-inline-email__input {
      border-right: 1px solid var(--ara-email-border);
      font-size: var(--ara-email-mobile-input-size);
    }

    #AraInlineEmail-{{ section.id }} .ara-inline-email__button {
      width: 100%;
      font-size: var(--ara-email-mobile-button-size);
    }

    #AraInlineEmail-{{ section.id }} .ara-inline-email__message {
      font-size: var(--ara-email-mobile-message-size);
    }
  }

  /* Contrast fix: force visible heading/description colors regardless of any
     inherited fade/reveal animation state or theme-level heading color rules */
  #AraInlineEmail-{{ section.id }} .ara-inline-email__intro h2 {
    color: #161B2E !important;
    opacity: 1 !important;
  }

  #AraInlineEmail-{{ section.id }} .ara-inline-email__intro p {
    color: #4B4D5C !important;
    opacity: 1 !important;
  }
</style>

{% schema %}
{
  "name": "Ara Inline Email",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One clear idea in your inbox each week."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Short text",
      "default": "No noise. Just understanding."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "JOIN THE PAPER"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You are on the list."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "min": 9,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Desktop heading size",
      "default": 11
    },
    {
      "type": "range",
      "id": "desktop_description_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Desktop description size",
      "default": 12
    },
    {
      "type": "range",
      "id": "desktop_input_size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Desktop input text size",
      "default": 13
    },
    {
      "type": "range",
      "id": "desktop_button_size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Desktop button text size",
      "default": 10
    },
    {
      "type": "range",
      "id": "desktop_message_size",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Desktop message size",
      "default": 11
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 9,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Mobile heading size",
      "default": 11
    },
    {
      "type": "range",
      "id": "mobile_description_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Mobile description size",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_input_size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Mobile input text size",
      "default": 13
    },
    {
      "type": "range",
      "id": "mobile_button_size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Mobile button text size",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_message_size",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Mobile message size",
      "default": 11
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "1700px",
      "options": [
        {
          "value": "1300px",
          "label": "Narrow"
        },
        {
          "value": "1500px",
          "label": "Medium"
        },
        {
          "value": "1700px",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Top spacing",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 30
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F2F8F6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#161B2E"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Secondary text",
      "default": "#646575"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Mint accent",
      "default": "#176D5C"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#176D5C"
    },
    {
      "type": "color",
      "id": "field_color",
      "label": "Field background",
      "default": "#F7FCFA"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#176D5C"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Ara Inline Email"
    }
  ]
}
{% endschema %}
