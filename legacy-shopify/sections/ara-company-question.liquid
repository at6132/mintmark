<section
  id="AraCompanyQuestion-{{ section.id }}"
  class="ara-company-question"
  style="
    --ara-question-bg: {{ section.settings.background_color }};
    --ara-question-text: {{ section.settings.text_color }};
    --ara-question-accent: {{ section.settings.accent_color }};
    --ara-question-border: {{ section.settings.border_color }};
    --ara-question-line: {{ section.settings.line_color }};
    --ara-question-max: {{ section.settings.max_width }};
    --ara-question-top: {{ section.settings.padding_top }}px;
    --ara-question-bottom: {{ section.settings.padding_bottom }}px;
    --ara-question-image-ratio: {{ section.settings.image_ratio }};
    --ara-question-eyebrow-size: {{ section.settings.desktop_eyebrow_size }}px;
    --ara-question-heading-size: {{ section.settings.desktop_heading_size }}px;
    --ara-question-link-size: {{ section.settings.desktop_link_size }}px;
    --ara-question-mobile-eyebrow-size: {{ section.settings.mobile_eyebrow_size }}px;
    --ara-question-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --ara-question-mobile-link-size: {{ section.settings.mobile_link_size }}px;
  "
>
  <div class="ara-company-question__inner">
    <div class="ara-company-question__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="ara-company-question__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="ara-company-question__heading">
          {{ section.settings.heading | escape | newline_to_br }}
        </h2>
      {% endif %}

      {% if section.settings.link_label != blank %}
        <a
          class="ara-company-question__link"
          {% if section.settings.link != blank %}
            href="{{ section.settings.link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.link_label | escape }}
        </a>
      {% endif %}
    </div>

    <div class="ara-company-question__visual">
      {% if section.settings.image != blank %}
        <picture>
          {% if section.settings.mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ section.settings.mobile_image | image_url: width: 700 }} 700w,
                {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w
              "
            >
          {% endif %}

          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '700, 900, 1200, 1600',
              sizes: '(max-width: 749px) 100vw, 44vw',
              loading: 'lazy',
              class: 'ara-company-question__image',
              alt: section.settings.image.alt
          }}
        </picture>
      {% else %}
        <div class="ara-company-question__empty">
          <span>Upload the company question image</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #AraCompanyQuestion-{{ section.id }} {
    overflow: hidden;
    border-top: 1px solid var(--ara-question-border);
    border-bottom: 1px solid var(--ara-question-border);
    background-color: var(--ara-question-bg);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 34px,
      color-mix(in srgb, var(--ara-question-line) 22%, transparent) 34px,
      color-mix(in srgb, var(--ara-question-line) 22%, transparent) 35px
    );
    color: var(--ara-question-text);
  }

  #AraCompanyQuestion-{{ section.id }} .ara-company-question__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(360px, 0.9fr);
    gap: clamp(28px, 4vw, 70px);
    align-items: center;
    width: min(100%, var(--ara-question-max));
    margin: 0 auto;
    padding: var(--ara-question-top) 40px var(--ara-question-bottom);
  }

  #AraCompanyQuestion-{{ section.id }} .ara-company-question__copy {
    position: relative;
    z-index: 1;
  }

  #AraCompanyQuestion-{{ section.id }} .ara-company-question__eyebrow {
    margin: 0 0 22px;
    color: var(--ara-question-accent);
    font-family: var(--font-body-family);
    font-size: var(--ara-question-eyebrow-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  #AraCompanyQuestion-{{ section.id }} .ara-company-question__heading {
    margin: 0;
    color: var(--ara-question-text);
    font-family: var(--font-heading-family);
    font-size: var(--ara-question-heading-size);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 0.98;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  #AraCompanyQuestion-{{ section.id }} .ara-company-question__heading em {
    font-weight: 400;
  }

  #AraCompanyQuestion-{{ section.id }} .ara-company-question__link {
    display: inline-flex;
    align-items: center;
    margin-top: 28px;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--ara-question-accent);
    color: var(--ara-question-accent);
    font-family: var(--font-body-family);
    font-size: var(--ara-question-link-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.13em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #AraCompanyQuestion-{{ section.id }} .ara-company-question__visual {
    width: 100%;
  }

  #AraCompanyQuestion-{{ section.id }} .ara-company-question__visual picture {
    display: block;
    width: 100%;
  }

  #AraCompanyQuestion-{{ section.id }} .ara-company-question__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ara-question-image-ratio);
    object-fit: cover;
    object-position: center;
    border: 0;
    box-shadow: none;
  }

  #AraCompanyQuestion-{{ section.id }} .ara-company-question__empty {
    display: grid;
    width: 100%;
    aspect-ratio: var(--ara-question-image-ratio);
    place-items: center;
    padding: 20px;
    border: 1px dashed var(--ara-question-border);
    background: rgba(255, 255, 255, 0.35);
    color: var(--ara-question-accent);
    font-family: var(--font-body-family);
    font-size: 12px;
    font-style: var(--font-body-style);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    #AraCompanyQuestion-{{ section.id }} .ara-company-question__inner {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    #AraCompanyQuestion-{{ section.id }} .ara-company-question__inner {
      gap: 24px;
      padding-right: 20px;
      padding-left: 20px;
    }

    #AraCompanyQuestion-{{ section.id }} .ara-company-question__eyebrow {
      font-size: var(--ara-question-mobile-eyebrow-size);
    }

    #AraCompanyQuestion-{{ section.id }} .ara-company-question__heading {
      font-size: var(--ara-question-mobile-heading-size);
    }

    #AraCompanyQuestion-{{ section.id }} .ara-company-question__link {
      font-size: var(--ara-question-mobile-link-size);
    }
  }
</style>

{% schema %}
{
  "name": "Ara Company Question",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "COMPANY QUESTION"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main question",
      "default": "Costco makes razor-thin margins.\nSo why can’t anybody beat it?"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "EXPLORE THE QUESTION"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Article link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop right-side image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "16 / 10",
      "options": [
        {
          "value": "16 / 10",
          "label": "Landscape"
        },
        {
          "value": "4 / 3",
          "label": "Classic"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        }
      ]
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "desktop_eyebrow_size",
      "min": 8,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Desktop small heading size",
      "default": 11
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "min": 36,
      "max": 90,
      "step": 2,
      "unit": "px",
      "label": "Desktop main question size",
      "default": 64
    },
    {
      "type": "range",
      "id": "desktop_link_size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Desktop link size",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_eyebrow_size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Mobile small heading size",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 32,
      "max": 70,
      "step": 2,
      "unit": "px",
      "label": "Mobile main question size",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_link_size",
      "min": 8,
      "max": 15,
      "step": 1,
      "unit": "px",
      "label": "Mobile link size",
      "default": 10
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "1700px",
      "options": [
        {
          "value": "1300px",
          "label": "Narrow"
        },
        {
          "value": "1500px",
          "label": "Medium"
        },
        {
          "value": "1700px",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Top spacing",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 70
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F2F8F6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#161B2E"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#176D5C"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#C9BEA8"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Paper lines",
      "default": "#1FA88F"
    }
  ],
  "presets": [
    {
      "name": "Ara Company Question"
    }
  ]
}
{% endschema %}
