<section
  id="AraMintClosingCta-{{ section.id }}"
  class="ara-mint-closing-cta"
  style="
    --ara-cta-bg: {{ section.settings.background_color }};
    --ara-cta-panel: {{ section.settings.panel_color }};
    --ara-cta-text: {{ section.settings.text_color }};
    --ara-cta-muted: {{ section.settings.muted_text_color }};
    --ara-cta-mint: {{ section.settings.mint_color }};
    --ara-cta-gold: {{ section.settings.gold_color }};
    --ara-cta-blue: {{ section.settings.blue_color }};
    --ara-cta-border: {{ section.settings.border_color }};
    --ara-cta-max: {{ section.settings.max_width }};
    --ara-cta-top: {{ section.settings.padding_top }}px;
    --ara-cta-bottom: {{ section.settings.padding_bottom }}px;
    --ara-cta-heading-desktop: {{ section.settings.desktop_heading_size }}px;
    --ara-cta-body-desktop: {{ section.settings.desktop_body_size }}px;
    --ara-cta-label-desktop: {{ section.settings.desktop_label_size }}px;
    --ara-cta-button-desktop: {{ section.settings.desktop_button_size }}px;
    --ara-cta-card-title-desktop: {{ section.settings.desktop_card_title_size }}px;
    --ara-cta-card-text-desktop: {{ section.settings.desktop_card_text_size }}px;
    --ara-cta-heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --ara-cta-body-mobile: {{ section.settings.mobile_body_size }}px;
    --ara-cta-label-mobile: {{ section.settings.mobile_label_size }}px;
    --ara-cta-button-mobile: {{ section.settings.mobile_button_size }}px;
    --ara-cta-card-title-mobile: {{ section.settings.mobile_card_title_size }}px;
    --ara-cta-card-text-mobile: {{ section.settings.mobile_card_text_size }}px;
  "
>
  <div class="ara-mint-closing-cta__grid" aria-hidden="true"></div>

  <div class="ara-mint-closing-cta__inner">
    <div class="ara-mint-closing-cta__frame">
      <div class="ara-mint-closing-cta__panel">
        <div class="ara-mint-closing-cta__copy">
          <div class="ara-mint-closing-cta__meta">
            {% if section.settings.eyebrow != blank %}
              <span class="ara-mint-closing-cta__eyebrow">
                {{ section.settings.eyebrow | escape }}
              </span>
            {% endif %}

            {% if section.settings.folio != blank %}
              <span class="ara-mint-closing-cta__folio">
                {{ section.settings.folio | escape }}
              </span>
            {% endif %}
          </div>

          {% if section.settings.heading != blank %}
            <h2 class="ara-mint-closing-cta__heading">
              {{ section.settings.heading | escape | newline_to_br }}
            </h2>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="ara-mint-closing-cta__description">
              {{ section.settings.description }}
            </div>
          {% endif %}

          <div class="ara-mint-closing-cta__buttons">
            {% if section.settings.primary_button_label != blank %}
              <a
                class="ara-mint-closing-cta__button ara-mint-closing-cta__button--primary"
                {% if section.settings.primary_button_link != blank %}
                  href="{{ section.settings.primary_button_link }}"
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
              >
                {{ section.settings.primary_button_label | escape }}
              </a>
            {% endif %}

            {% if section.settings.secondary_button_label != blank %}
              <a
                class="ara-mint-closing-cta__button ara-mint-closing-cta__button--secondary"
                {% if section.settings.secondary_button_link != blank %}
                  href="{{ section.settings.secondary_button_link }}"
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
              >
                {{ section.settings.secondary_button_label | escape }}
              </a>
            {% endif %}
          </div>

          {% if section.settings.bottom_note != blank %}
            <p class="ara-mint-closing-cta__bottom-note">
              {{ section.settings.bottom_note | escape }}
            </p>
          {% endif %}
        </div>

        <div class="ara-mint-closing-cta__pathways">
          <div class="ara-mint-closing-cta__pathways-head">
            <span>{{ section.settings.pathways_heading | escape }}</span>
            <small>{{ section.settings.pathways_note | escape }}</small>
          </div>

          <div class="ara-mint-closing-cta__cards">
            {% for block in section.blocks %}
              <article
                class="ara-mint-closing-cta__card ara-mint-closing-cta__card--{{ block.settings.style }}"
                {{ block.shopify_attributes }}
              >
                <span class="ara-mint-closing-cta__card-number">
                  {{ forloop.index | prepend: '0' }}
                </span>

                <div class="ara-mint-closing-cta__card-copy">
                  {% if block.settings.title != blank %}
                    <h3>{{ block.settings.title | escape }}</h3>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <p>{{ block.settings.text | escape }}</p>
                  {% endif %}
                </div>

                {% if block.settings.link_label != blank %}
                  <a
                    class="ara-mint-closing-cta__card-link"
                    {% if block.settings.link != blank %}
                      href="{{ block.settings.link }}"
                    {% else %}
                      role="link"
                      aria-disabled="true"
                    {% endif %}
                  >
                    {{ block.settings.link_label | escape }}
                  </a>
                {% endif %}
              </article>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #AraMintClosingCta-{{ section.id }} {
    position: relative;
    overflow: hidden;
    padding: var(--ara-cta-top) 0 var(--ara-cta-bottom);
    background: var(--ara-cta-bg);
    color: var(--ara-cta-text);
    isolation: isolate;
  }

  #AraMintClosingCta-{{ section.id }} * {
    box-sizing: border-box;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.32;
    background-image:
      linear-gradient(
        90deg,
        transparent 0,
        transparent 31px,
        color-mix(in srgb, var(--ara-cta-mint) 18%, transparent) 31px,
        color-mix(in srgb, var(--ara-cta-mint) 18%, transparent) 32px
      ),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 35px,
        color-mix(in srgb, var(--ara-cta-mint) 18%, transparent) 35px,
        color-mix(in srgb, var(--ara-cta-mint) 18%, transparent) 36px
      );
    pointer-events: none;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__inner {
    width: min(100%, var(--ara-cta-max));
    margin: 0 auto;
    padding: 0 40px;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__frame {
    padding: 8px;
    border: 2px solid var(--ara-cta-text);
    border-radius: 26px;
    background: var(--ara-cta-panel);
    box-shadow:
      10px 10px 0 var(--ara-cta-gold),
      18px 18px 0 color-mix(in srgb, var(--ara-cta-mint) 64%, transparent);
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    gap: clamp(34px, 5vw, 82px);
    align-items: center;
    padding: clamp(38px, 5vw, 74px);
    border: 3px solid var(--ara-cta-text);
    border-radius: 17px;
    background:
      radial-gradient(
        circle at 112% 112%,
        color-mix(in srgb, var(--ara-cta-gold) 16%, transparent) 0 29%,
        transparent 30%
      ),
      linear-gradient(
        145deg,
        var(--ara-cta-blue),
        var(--ara-cta-panel)
      );
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__meta,
  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__pathways-head {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: flex-start;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__eyebrow,
  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__folio,
  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__bottom-note,
  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__pathways-head span,
  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__pathways-head small,
  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__card-number,
  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__card-link {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__eyebrow {
    display: inline-flex;
    min-height: 31px;
    align-items: center;
    padding: 6px 11px;
    border: 2px solid var(--ara-cta-text);
    border-radius: 8px;
    background: var(--ara-cta-gold);
    color: var(--ara-cta-panel);
    font-size: var(--ara-cta-label-desktop);
    box-shadow: 3px 3px 0 var(--ara-cta-text);
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__folio {
    color: var(--ara-cta-muted);
    font-size: var(--ara-cta-label-desktop);
    text-align: right;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__heading {
    max-width: 820px;
    margin: 25px 0 0;
    font-family: var(--font-heading-family);
    font-size: var(--ara-cta-heading-desktop);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 0.93;
    letter-spacing: -0.055em;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__description {
    max-width: 700px;
    margin-top: 27px;
    color: var(--ara-cta-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-cta-body-desktop);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.65;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__description p {
    margin: 0;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 32px;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__button {
    display: inline-flex;
    min-width: 190px;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    border: 2px solid currentColor;
    border-radius: 8px;
    font-family: var(--font-body-family);
    font-size: var(--ara-cta-button-desktop);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 currentColor;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__button:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 currentColor;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__button--primary {
    background: var(--ara-cta-gold);
    color: var(--ara-cta-panel);
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__button--secondary {
    background: var(--ara-cta-mint);
    color: #FFFFFF;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__bottom-note {
    margin: 48px 0 0;
    padding-top: 16px;
    border-top: 1px dashed color-mix(in srgb, var(--ara-cta-text) 34%, transparent);
    color: var(--ara-cta-muted);
    font-size: var(--ara-cta-label-desktop);
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__pathways {
    padding: 25px;
    border: 2px solid var(--ara-cta-text);
    border-radius: 16px;
    background: color-mix(in srgb, var(--ara-cta-bg) 96%, white);
    color: var(--ara-cta-panel);
    box-shadow: 7px 7px 0 var(--ara-cta-gold);
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__pathways-head {
    padding-bottom: 15px;
    border-bottom: 2px solid var(--ara-cta-text);
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__pathways-head span,
  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__pathways-head small {
    font-size: var(--ara-cta-label-desktop);
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__pathways-head small {
    color: var(--ara-cta-muted);
    text-align: right;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__cards {
    display: grid;
    gap: 11px;
    margin-top: 18px;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__card {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    padding: 17px;
    border: 2px solid var(--ara-cta-text);
    border-radius: 12px;
    box-shadow: 3px 3px 0 var(--ara-cta-text);
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__card--cream {
    background: var(--ara-cta-bg);
    color: var(--ara-cta-panel);
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__card--gold {
    background: var(--ara-cta-gold);
    color: var(--ara-cta-panel);
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__card--mint {
    background: var(--ara-cta-mint);
    color: #FFFFFF;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__card-number {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 2px solid currentColor;
    border-radius: 50%;
    font-size: var(--ara-cta-label-desktop);
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__card h3 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: var(--ara-cta-card-title-desktop);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 1;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__card p {
    margin: 10px 0 0;
    font-family: var(--font-body-family);
    font-size: var(--ara-cta-card-text-desktop);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.5;
  }

  #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__card-link {
    grid-column: 2;
    display: inline-block;
    width: fit-content;
    margin-top: 4px;
    color: inherit;
    font-size: var(--ara-cta-label-desktop);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media screen and (max-width: 1099px) {
    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__panel {
      grid-template-columns: 1fr;
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__pathways {
      max-width: 760px;
    }
  }

  @media screen and (max-width: 749px) {
    #AraMintClosingCta-{{ section.id }} {
      padding-top: calc(var(--ara-cta-top) * 0.7);
      padding-bottom: calc(var(--ara-cta-bottom) * 0.7);
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__inner {
      padding: 0 20px;
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__frame {
      padding: 5px;
      box-shadow:
        5px 5px 0 var(--ara-cta-gold),
        10px 10px 0 color-mix(in srgb, var(--ara-cta-mint) 64%, transparent);
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__panel {
      padding: 32px 24px 37px;
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__meta {
      align-items: flex-start;
      flex-direction: column;
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__eyebrow,
    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__folio,
    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__bottom-note,
    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__pathways-head span,
    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__pathways-head small,
    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__card-number,
    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__card-link {
      font-size: var(--ara-cta-label-mobile);
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__folio {
      text-align: left;
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__heading {
      font-size: var(--ara-cta-heading-mobile);
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__description {
      font-size: var(--ara-cta-body-mobile);
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__buttons {
      display: grid;
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__button {
      width: 100%;
      font-size: var(--ara-cta-button-mobile);
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__pathways {
      padding: 21px 18px;
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__pathways-head {
      align-items: flex-start;
      flex-direction: column;
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__pathways-head small {
      text-align: left;
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__card h3 {
      font-size: var(--ara-cta-card-title-mobile);
    }

    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__card p {
      font-size: var(--ara-cta-card-text-mobile);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #AraMintClosingCta-{{ section.id }} .ara-mint-closing-cta__button {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "Ara Mint Closing CTA",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "YOUR NEXT STEP"
    },
    {
      "type": "text",
      "id": "folio",
      "label": "Top note",
      "default": "THE MINT · FINAL CHAPTER"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main heading",
      "default": "Turn curiosity into\nlasting understanding."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Choose a company, open the curriculum or continue into the Bookshelf. Every path is designed to make complex business ideas easier to follow.</p>"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "First button text",
      "default": "EXPLORE THE BOOKSHELF"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Second button text",
      "default": "OPEN COMPANY MODULES"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Second button link"
    },
    {
      "type": "text",
      "id": "bottom_note",
      "label": "Bottom note",
      "default": "LEARN CLEARLY · THINK DEEPLY · RETURN OFTEN"
    },
    {
      "type": "text",
      "id": "pathways_heading",
      "label": "Pathways heading",
      "default": "CHOOSE YOUR PATH"
    },
    {
      "type": "text",
      "id": "pathways_note",
      "label": "Pathways note",
      "default": "THREE WAYS FORWARD"
    },
    {
      "type": "header",
      "content": "Desktop typography"
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "min": 44,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Main heading size",
      "default": 72
    },
    {
      "type": "range",
      "id": "desktop_body_size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Body text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_label_size",
      "min": 8,
      "max": 15,
      "step": 1,
      "unit": "px",
      "label": "Small text size",
      "default": 9
    },
    {
      "type": "range",
      "id": "desktop_button_size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Button text size",
      "default": 10
    },
    {
      "type": "range",
      "id": "desktop_card_title_size",
      "min": 22,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Pathway heading size",
      "default": 28
    },
    {
      "type": "range",
      "id": "desktop_card_text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Pathway text size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Mobile typography"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 36,
      "max": 68,
      "step": 2,
      "unit": "px",
      "label": "Main heading size",
      "default": 50
    },
    {
