<section
  id="AraMissionLine-{{ section.id }}"
  class="ara-mission-line"
  style="
    --ara-mission-bg: {{ section.settings.background_color }};
    --ara-mission-text: {{ section.settings.text_color }};
    --ara-mission-muted: {{ section.settings.muted_text_color }};
    --ara-mission-accent: {{ section.settings.accent_color }};
    --ara-mission-border: {{ section.settings.border_color }};
    --ara-mission-line: {{ section.settings.line_color }};
    --ara-mission-max: {{ section.settings.max_width }};
    --ara-mission-top: {{ section.settings.padding_top }}px;
    --ara-mission-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="ara-mission-line__inner">
    <div class="ara-mission-line__content">
      {% if section.settings.eyebrow != blank %}
        <p class="ara-mission-line__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="ara-mission-line__subtext">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    <div class="ara-mission-line__art">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            widths: '320, 480, 720, 960, 1200, 1400',
            sizes: '(max-width: 749px) 60vw, 340px',
            loading: 'lazy',
            class: 'ara-mission-line__image',
            alt: section.settings.image.alt
        }}
      {% else %}
        <div class="ara-mission-line__placeholder" aria-hidden="true">
          <svg viewBox="0 0 460 180" class="ara-mission-line__placeholder-svg" role="presentation">
            <g fill="none" stroke="currentColor" stroke-width="2.2" opacity=".7">
              <path d="M33 143h394"/>
              <path d="M90 142V85l45-38 45 38v57"/>
              <path d="M109 85h52"/>
              <path d="M122 70h25"/>
              <path d="M134 47l19 15"/>
              <path d="M209 142V68l52-45 52 45v74"/>
              <path d="M231 68h60"/>
              <path d="M247 50h28"/>
              <path d="M261 24l23 18"/>
              <path d="M341 142V96l34-28 34 28v46"/>
              <path d="M358 96h34"/>
              <path d="M366 84h18"/>
              <path d="M374 67l14 11"/>
              <path d="M109 110h12M134 110h12M244 97h14M274 97h14M359 114h10M380 114h10"/>
              <path d="M95 143l18-58M175 143l-18-58M223 143l18-75M299 143l-18-75M351 143l12-47M397 143l-12-47"/>
            </g>
          </svg>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #AraMissionLine-{{ section.id }} {
    border-top: 1px solid var(--ara-mission-border);
    border-bottom: 1px solid var(--ara-mission-border);
    background-color: var(--ara-mission-bg);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 34px,
      color-mix(in srgb, var(--ara-mission-line) 20%, transparent) 34px,
      color-mix(in srgb, var(--ara-mission-line) 20%, transparent) 35px
    );
    color: var(--ara-mission-text);
  }

  #AraMissionLine-{{ section.id }} .ara-mission-line__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 320px);
    gap: 30px;
    align-items: stretch;
    width: min(100%, var(--ara-mission-max));
    margin: 0 auto;
    padding: var(--ara-mission-top) 40px var(--ara-mission-bottom);
    min-height: 145px;
  }

  #AraMissionLine-{{ section.id }} .ara-mission-line__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  #AraMissionLine-{{ section.id }} .ara-mission-line__eyebrow {
    margin: 0 0 10px;
    color: var(--ara-mission-accent);
    font-family: var(--font-body-family);
    font-size: 10px;
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #AraMissionLine-{{ section.id }} h2 {
    max-width: 1180px;
    margin: 0;
    color: var(--ara-mission-text);
    font-family: var(--font-heading-family);
    font-size: clamp(24px, 2.4vw, 38px);
    font-style: var(--font-heading-style);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  #AraMissionLine-{{ section.id }} .ara-mission-line__subtext {
    max-width: 860px;
    margin-top: 12px;
    color: var(--ara-mission-muted);
    font-family: var(--font-body-family);
    font-size: 13px;
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.55;
  }

  #AraMissionLine-{{ section.id }} .ara-mission-line__subtext p {
    margin: 0;
  }

  #AraMissionLine-{{ section.id }} .ara-mission-line__art {
    display: flex;
    justify-content: flex-end;
    align-items: stretch;
    height: 100%;
    min-width: 0;
  }

  #AraMissionLine-{{ section.id }} .ara-mission-line__image,
  #AraMissionLine-{{ section.id }} .ara-mission-line__placeholder {
    display: block;
    height: 100%;
    width: auto;
    max-width: 100%;
    opacity: 0.42;
  }

  #AraMissionLine-{{ section.id }} .ara-mission-line__image {
    object-fit: contain;
    object-position: right center;
    mix-blend-mode: multiply;
    filter: saturate(.55) contrast(.95);
  }

  #AraMissionLine-{{ section.id }} .ara-mission-line__placeholder {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    color: color-mix(in srgb, var(--ara-mission-text) 35%, transparent);
  }

  #AraMissionLine-{{ section.id }} .ara-mission-line__placeholder-svg {
    display: block;
    width: auto;
    height: 100%;
    max-width: 100%;
  }

  @media screen and (max-width: 899px) {
    #AraMissionLine-{{ section.id }} .ara-mission-line__inner {
      grid-template-columns: 1fr minmax(140px, 220px);
      gap: 20px;
      min-height: 130px;
    }

    #AraMissionLine-{{ section.id }} h2 {
      font-size: clamp(22px, 3.8vw, 32px);
    }
  }

  @media screen and (max-width: 749px) {
    #AraMissionLine-{{ section.id }} .ara-mission-line__inner {
      grid-template-columns: 1fr;
      gap: 14px;
      min-height: auto;
      padding-right: 20px;
      padding-left: 20px;
    }

    #AraMissionLine-{{ section.id }} .ara-mission-line__art {
      justify-content: flex-start;
      height: auto;
    }

    #AraMissionLine-{{ section.id }} .ara-mission-line__image,
    #AraMissionLine-{{ section.id }} .ara-mission-line__placeholder {
      width: min(72vw, 220px);
      height: auto;
    }

    #AraMissionLine-{{ section.id }} .ara-mission-line__placeholder-svg {
      width: 100%;
      height: auto;
    }

    {% if section.settings.hide_image_mobile %}
      #AraMissionLine-{{ section.id }} .ara-mission-line__art {
        display: none;
      }
    {% endif %}
  }
</style>

{% schema %}
{
  "name": "Ara Mission Line",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "OUR MISSION"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main text",
      "default": "We make financial literacy simple so more people can think clearly, invest wisely, and build a better future."
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Optional subtext",
      "default": "<p></p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right side image"
    },
    {
      "type": "checkbox",
      "id": "hide_image_mobile",
      "label": "Hide image on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "1700px",
      "options": [
        { "value": "1300px", "label": "Narrow" },
        { "value": "1500px", "label": "Medium" },
        { "value": "1700px", "label": "Wide" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 28
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F2F8F6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#161B2E"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Secondary text",
      "default": "#646575"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#176D5C"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#C9BEA8"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Paper lines",
      "default": "#1FA88F"
    }
  ],
  "presets": [
    {
      "name": "Ara Mission Line"
    }
  ]
}
{% endschema %}