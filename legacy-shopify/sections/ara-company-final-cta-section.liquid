  }
</style>


<style>
  #AraCompanyFinalCta-{{ section.id }} .ara-company-file__brand-rule {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    margin-bottom: clamp(24px, 3vw, 38px);
    padding: 10px 0 12px;
    border-top: 2px solid #161B2E;
    border-bottom: 1px solid #161B2E;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-file__brand-rule img {
    display: block;
    width: min(100%, 170px);
    height: auto;
  }

