<section
  id="AraCompanyFinalCta-{{ section.id }}"
  class="ara-company-final-cta"
  style="
    --ara-final-bg: {{ section.settings.background_color }};
    --ara-final-panel: {{ section.settings.panel_color }};
    --ara-final-paper: {{ section.settings.paper_color }};
    --ara-final-text: {{ section.settings.text_color }};
    --ara-final-muted: {{ section.settings.muted_text_color }};
    --ara-final-mint: {{ section.settings.mint_color }};
    --ara-final-gold: {{ section.settings.gold_color }};
    --ara-final-blue: {{ section.settings.blue_color }};
    --ara-final-max: {{ section.settings.max_width }};
    --ara-final-top: {{ section.settings.padding_top }}px;
    --ara-final-bottom: {{ section.settings.padding_bottom }}px;
    --ara-final-heading-desktop: {{ section.settings.desktop_heading_size }}px;
    --ara-final-body-desktop: {{ section.settings.desktop_body_size }}px;
    --ara-final-label-desktop: {{ section.settings.desktop_label_size }}px;
    --ara-final-next-title-desktop: {{ section.settings.desktop_next_title_size }}px;
    --ara-final-path-title-desktop: {{ section.settings.desktop_path_title_size }}px;
    --ara-final-heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --ara-final-body-mobile: {{ section.settings.mobile_body_size }}px;
    --ara-final-label-mobile: {{ section.settings.mobile_label_size }}px;
    --ara-final-next-title-mobile: {{ section.settings.mobile_next_title_size }}px;
    --ara-final-path-title-mobile: {{ section.settings.mobile_path_title_size }}px;
  "
>
  <div class="ara-company-final-cta__lines" aria-hidden="true"></div>

  <div class="ara-company-final-cta__inner">
    <div class="ara-company-file__brand-rule">
      <img
        src="{{ 'mintmark-wordmark-ink.png' | asset_url }}"
        alt="Mintmark"
        width="488"
        height="88"
        loading="lazy"
      >
      <span>COMPANY FILE · MINTMARK</span>
    </div>
    <div class="ara-company-final-cta__frame">
      <div class="ara-company-final-cta__panel">
        <div class="ara-company-final-cta__copy">
          <div class="ara-company-final-cta__meta">
            {% if section.settings.eyebrow != blank %}
              <span class="ara-company-final-cta__eyebrow">
                {{ section.settings.eyebrow | escape }}
              </span>
            {% endif %}

            {% if section.settings.folio != blank %}
              <span class="ara-company-final-cta__folio">
                {{ section.settings.folio | escape }}
              </span>
            {% endif %}
          </div>

          {% if section.settings.heading != blank %}
            <h2 class="ara-company-final-cta__heading">
              {{ section.settings.heading | escape | newline_to_br }}
            </h2>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="ara-company-final-cta__description">
              {{ section.settings.description }}
            </div>
          {% endif %}

          <div class="ara-company-final-cta__buttons">
            {% if section.settings.primary_button_label != blank %}
              <a
                class="ara-company-final-cta__button ara-company-final-cta__button--primary"
                {% if section.settings.primary_button_link != blank %}
                  href="{{ section.settings.primary_button_link }}"
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
              >
                {{ section.settings.primary_button_label | escape }}
              </a>
            {% endif %}

            {% if section.settings.secondary_button_label != blank %}
              <a
                class="ara-company-final-cta__button ara-company-final-cta__button--secondary"
                {% if section.settings.secondary_button_link != blank %}
                  href="{{ section.settings.secondary_button_link }}"
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
              >
                {{ section.settings.secondary_button_label | escape }}
              </a>
            {% endif %}
          </div>

          {% if section.settings.bottom_note != blank %}
            <p class="ara-company-final-cta__bottom-note">
              {{ section.settings.bottom_note | escape }}
            </p>
          {% endif %}
        </div>

        <aside class="ara-company-final-cta__next">
          <div class="ara-company-final-cta__next-head">
            <span>{{ section.settings.next_label | escape }}</span>
            <small>{{ section.settings.next_note | escape }}</small>
          </div>

          <div class="ara-company-final-cta__next-identity">
            {% if section.settings.next_company_logo != blank %}
              <div class="ara-company-final-cta__next-logo-wrap">
                {{
                  section.settings.next_company_logo
                  | image_url: width: 500
                  | image_tag:
                    widths: '120, 180, 260, 360, 500',
                    sizes: '(max-width: 749px) 72px, 92px',
                    loading: 'lazy',
                    class: 'ara-company-final-cta__next-logo',
                    alt: section.settings.next_company_logo.alt
                }}
              </div>
            {% endif %}

            <div>
              {% if section.settings.next_company_name != blank %}
                <h3>{{ section.settings.next_company_name | escape }}</h3>
              {% endif %}

              {% if section.settings.next_company_meta != blank %}
                <p>{{ section.settings.next_company_meta | escape }}</p>
              {% endif %}
            </div>
          </div>

          {% if section.settings.next_company_description != blank %}
            <p class="ara-company-final-cta__next-description">
              {{ section.settings.next_company_description | escape }}
            </p>
          {% endif %}

          {% if section.settings.next_company_button_label != blank %}
            <a
              class="ara-company-final-cta__next-link"
              {% if section.settings.next_company_link != blank %}
                href="{{ section.settings.next_company_link }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              {{ section.settings.next_company_button_label | escape }}
            </a>
          {% endif %}
        </aside>
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="ara-company-final-cta__paths">
        {% for block in section.blocks %}
          <article
            class="ara-company-final-cta__path ara-company-final-cta__path--{{ block.settings.style }}"
            {{ block.shopify_attributes }}
          >
            <span class="ara-company-final-cta__path-number">
              {{ forloop.index | prepend: '0' }}
            </span>

            <div>
              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title | escape }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <p>{{ block.settings.text | escape }}</p>
              {% endif %}

              {% if block.settings.link_label != blank %}
                <a
                  class="ara-company-final-cta__path-link"
                  {% if block.settings.link != blank %}
                    href="{{ block.settings.link }}"
                  {% else %}
                    role="link"
                    aria-disabled="true"
                  {% endif %}
                >
                  {{ block.settings.link_label | escape }}
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #AraCompanyFinalCta-{{ section.id }} {
    position: relative;
    overflow: hidden;
    padding: var(--ara-final-top) 0 var(--ara-final-bottom);
    background: var(--ara-final-bg);
    color: var(--ara-final-text);
    isolation: isolate;
  }

  #AraCompanyFinalCta-{{ section.id }} * {
    box-sizing: border-box;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.34;
    background-image:
      linear-gradient(
        90deg,
        transparent 0,
        transparent 31px,
        color-mix(in srgb, var(--ara-final-mint) 16%, transparent) 31px,
        color-mix(in srgb, var(--ara-final-mint) 16%, transparent) 32px
      ),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 35px,
        color-mix(in srgb, var(--ara-final-mint) 17%, transparent) 35px,
        color-mix(in srgb, var(--ara-final-mint) 17%, transparent) 36px
      );
    pointer-events: none;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__inner {
    width: min(100%, var(--ara-final-max));
    margin: 0 auto;
    padding: 0 40px;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__frame {
    padding: 8px;
    border: 2px solid var(--ara-final-text);
    border-radius: 26px;
    background: var(--ara-final-paper);
    box-shadow:
      10px 10px 0 var(--ara-final-gold),
      18px 18px 0 color-mix(in srgb, var(--ara-final-mint) 64%, transparent);
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(350px, 0.92fr);
    gap: clamp(34px, 5vw, 78px);
    align-items: center;
    padding: clamp(38px, 5vw, 72px);
    border: 3px solid var(--ara-final-text);
    border-radius: 17px;
    background:
      radial-gradient(
        circle at 112% 112%,
        color-mix(in srgb, var(--ara-final-gold) 15%, transparent) 0 29%,
        transparent 30%
      ),
      linear-gradient(
        145deg,
        var(--ara-final-blue),
        var(--ara-final-panel)
      );
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__meta,
  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-head {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    align-items: flex-start;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__eyebrow,
  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__folio,
  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__bottom-note,
  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-head span,
  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-head small,
  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__path-number {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__eyebrow {
    display: inline-flex;
    min-height: 31px;
    align-items: center;
    padding: 6px 11px;
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    background: var(--ara-final-gold);
    color: var(--ara-final-panel);
    font-size: var(--ara-final-label-desktop);
    box-shadow: 3px 3px 0 #FFFFFF;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__folio {
    color: rgba(255, 255, 255, 0.66);
    font-size: var(--ara-final-label-desktop);
    text-align: right;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__heading {
    max-width: 790px;
    margin: 25px 0 0;
    color: #FFFFFF;
    font-family: var(--font-heading-family);
    font-size: var(--ara-final-heading-desktop);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 0.93;
    letter-spacing: -0.055em;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__description {
    max-width: 690px;
    margin-top: 26px;
    color: rgba(255, 255, 255, 0.82);
    font-family: var(--font-body-family);
    font-size: var(--ara-final-body-desktop);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.65;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__description p {
    margin: 0;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 31px;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__button {
    display: inline-flex;
    min-width: 188px;
    min-height: 49px;
    align-items: center;
    justify-content: center;
    padding: 11px 20px;
    border: 2px solid currentColor;
    border-radius: 8px;
    font-family: var(--font-body-family);
    font-size: var(--ara-final-label-desktop);
    font-weight: 800;
    letter-spacing: 0.11em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 currentColor;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__button--primary {
    background: var(--ara-final-gold);
    color: var(--ara-final-panel);
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__button--secondary {
    background: var(--ara-final-mint);
    color: #FFFFFF;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__bottom-note {
    margin: 46px 0 0;
    padding-top: 16px;
    border-top: 1px dashed rgba(255, 255, 255, 0.34);
    color: rgba(255, 255, 255, 0.66);
    font-size: var(--ara-final-label-desktop);
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next {
    padding: 25px;
    border: 2px solid #FFFFFF;
    border-radius: 16px;
    background: var(--ara-final-paper);
    color: var(--ara-final-panel);
    box-shadow: 7px 7px 0 var(--ara-final-gold);
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-head {
    padding-bottom: 15px;
    border-bottom: 2px solid var(--ara-final-panel);
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-head span,
  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-head small {
    font-size: var(--ara-final-label-desktop);
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-head span {
    color: var(--ara-final-mint);
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-head small {
    color: var(--ara-final-muted);
    text-align: right;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-identity {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 17px;
    align-items: center;
    margin-top: 23px;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-logo-wrap {
    display: grid;
    width: 92px;
    height: 92px;
    place-items: center;
    padding: 11px;
    border: 2px solid var(--ara-final-panel);
    border-radius: 14px;
    background: #FFFFFF;
    box-shadow: 4px 4px 0 var(--ara-final-blue);
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-logo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next h3 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: var(--ara-final-next-title-desktop);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 1;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-identity p,
  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-description {
    color: var(--ara-final-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-final-body-desktop);
    line-height: 1.5;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-identity p {
    margin: 8px 0 0;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-description {
    margin: 22px 0 0;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-link {
    display: inline-flex;
    min-height: 47px;
    align-items: center;
    justify-content: center;
    margin-top: 23px;
    padding: 11px 17px;
    border: 2px solid var(--ara-final-panel);
    border-radius: 8px;
    background: var(--ara-final-gold);
    color: var(--ara-final-panel);
    font-family: var(--font-body-family);
    font-size: var(--ara-final-label-desktop);
    font-weight: 800;
    letter-spacing: 0.11em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 3px 3px 0 var(--ara-final-panel);
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 42px;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__path {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 15px;
    align-items: start;
    min-height: 185px;
    padding: 22px;
    border: 2px solid var(--ara-final-text);
    border-radius: 15px;
    box-shadow: 5px 5px 0 var(--ara-final-text);
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__path--cream {
    background: var(--ara-final-paper);
    color: var(--ara-final-text);
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__path--gold {
    background: var(--ara-final-gold);
    color: var(--ara-final-panel);
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__path--mint {
    background: var(--ara-final-mint);
    color: #FFFFFF;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__path-number {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 2px solid currentColor;
    border-radius: 50%;
    font-size: var(--ara-final-label-desktop);
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__path h3 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: var(--ara-final-path-title-desktop);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 1;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__path p {
    margin: 11px 0 0;
    font-family: var(--font-body-family);
    font-size: var(--ara-final-body-desktop);
    line-height: 1.5;
  }

  #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__path-link {
    display: inline-flex;
    margin-top: 18px;
    color: inherit;
    font-family: var(--font-body-family);
    font-size: var(--ara-final-label-desktop);
    font-weight: 800;
    letter-spacing: 0.11em;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-transform: uppercase;
  }

  @media screen and (max-width: 1099px) {
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__panel {
      grid-template-columns: 1fr;
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next {
      max-width: 760px;
    }
  }

  @media screen and (max-width: 899px) {
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__paths {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    #AraCompanyFinalCta-{{ section.id }} {
      padding-top: calc(var(--ara-final-top) * 0.7);
      padding-bottom: calc(var(--ara-final-bottom) * 0.7);
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__inner {
      padding: 0 20px;
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__frame {
      padding: 5px;
      box-shadow:
        5px 5px 0 var(--ara-final-gold),
        10px 10px 0 color-mix(in srgb, var(--ara-final-mint) 64%, transparent);
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__panel {
      padding: 32px 24px 37px;
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__meta,
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-head {
      align-items: flex-start;
      flex-direction: column;
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__heading {
      font-size: var(--ara-final-heading-mobile);
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__description,
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-identity p,
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-description,
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__path p {
      font-size: var(--ara-final-body-mobile);
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__eyebrow,
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__folio,
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__bottom-note,
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-head span,
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-head small,
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__path-number,
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__button,
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-link,
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__path-link {
      font-size: var(--ara-final-label-mobile);
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__folio,
    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-head small {
      text-align: left;
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__buttons {
      display: grid;
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__button {
      width: 100%;
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next {
      padding: 21px 18px;
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-identity {
      grid-template-columns: 72px minmax(0, 1fr);
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next-logo-wrap {
      width: 72px;
      height: 72px;
      padding: 9px;
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__next h3 {
      font-size: var(--ara-final-next-title-mobile);
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__path {
      min-height: 0;
    }

    #AraCompanyFinalCta-{{ section.id }} .ara-company-final-cta__path h3 {
      font-size: var(--ara-final-path-title-mobile);
    }
  }
</style>

<style>
