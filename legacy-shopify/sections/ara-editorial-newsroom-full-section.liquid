  @media (max-width: 989px) {
    #AraEditorialFrontPage-{{ S }} .ara-nr-band3 > .ara-nr-col + .ara-nr-col,
    #AraEditorialFrontPage-{{ S }} .ara-nr-band4 > .ara-nr-col + .ara-nr-col { border-left: 0; padding-left: 0; }
    #AraEditorialFrontPage-{{ S }} .ara-nr-band3 > .ara-nr-col:first-child,
    #AraEditorialFrontPage-{{ S }} .ara-nr-band4 > .ara-nr-col:first-child { padding-right: 0; }
  }
  /* mint hairline accent joining the strip column head */
  #AraEditorialFrontPage-{{ S }} .ara-nr-strip .ara-nr-flip__front { border-top: 3px solid var(--sec, var(--ara-news-mint)); }
  #AraEditorialFrontPage-{{ S }} .ara-nr-sq .ara-nr-flip__front { border-top: 3px solid var(--sec, var(--ara-news-mint)); }

  /* --- per-section colour suite: section colour rides the trim --- */
  #AraEditorialFrontPage-{{ S }} .ara-editorial-front-page__section-heading span { color: var(--sec, var(--ara-news-mint)); }
  #AraEditorialFrontPage-{{ S }} .ara-nr-sq__num span { color: var(--sec, var(--ara-news-mint)); }
  #AraEditorialFrontPage-{{ S }} .ara-nr-strip .ara-nr-flip__front .ara-nr-strip__tick b { color: var(--sec, var(--ara-news-mint)); }
  #AraEditorialFrontPage-{{ S }} .ara-nr-map__foot a { color: var(--sec, var(--ara-news-mint)); }

  /* --- hover life (shadow/colour only, no transform → no motion clash) --- */
  #AraEditorialFrontPage-{{ S }} .ara-nr-map__chip,
  #AraEditorialFrontPage-{{ S }} .ara-editorial-front-page__featured-story,
  #AraEditorialFrontPage-{{ S }} .ara-editorial-front-page__lead-media { transition: box-shadow .25s ease, border-color .25s ease, background .25s ease; }
  #AraEditorialFrontPage-{{ S }} .ara-nr-map__chip:hover { background: color-mix(in srgb, var(--sec, var(--ara-news-mint)) 10%, var(--ara-news-bg)); border-color: var(--sec, var(--ara-news-mint)); }
  #AraEditorialFrontPage-{{ S }} .ara-editorial-front-page__lead-media:hover { box-shadow: 0 20px 46px rgba(22,27,46,.14); }
  #AraEditorialFrontPage-{{ S }} .ara-nr-ticker__item { transition: color .2s ease; }
  #AraEditorialFrontPage-{{ S }} .ara-nr-ticker__item:hover span { color: var(--ara-news-gold); }

  /* --- scroll / touch reveal (staggered) --- */
  #AraEditorialFrontPage-{{ S }}.is-animate .ara-nr-reveal {
    opacity: 0; transform: translateY(16px);
    transition: opacity .6s ease, transform .6s cubic-bezier(.2,.7,.2,1);
    will-change: opacity, transform;
  }
  #AraEditorialFrontPage-{{ S }}.is-animate .ara-nr-reveal.is-in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    #AraEditorialFrontPage-{{ S }}.is-animate .ara-nr-reveal { opacity: 1 !important; transform: none !important; transition: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('AraEditorialFrontPage-{{ section.id }}');
    if (!root) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    root.classList.add('is-animate');

    var sel = '.ara-editorial-front-page__lead, .ara-nr-strip, .ara-editorial-front-page__question,'
            + '.ara-nr-sq, .ara-editorial-front-page__featured-story, .ara-nr-map__chip,'
            + '.ara-editorial-front-page__section-heading';
    var targets = Array.prototype.slice.call(root.querySelectorAll(sel));
    targets.forEach(function (el) { el.classList.add('ara-nr-reveal'); });

    if (reduce || !('IntersectionObserver' in window)) {
      targets.forEach(function (el) { el.classList.add('is-in'); });
      return;
    }

    // stagger within each visual group
    ['.ara-nr-strip', '.ara-nr-band3 .ara-nr-sq', '.ara-nr-map__chip', '.ara-editorial-front-page__featured-story']
      .forEach(function (g) {
        Array.prototype.slice.call(root.querySelectorAll(g)).forEach(function (el, i) {
          el.setAttribute('data-rd', (i % 6) * 70);
        });
      });

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var el = e.target;
        el.style.transitionDelay = (el.getAttribute('data-rd') || 0) + 'ms';
        el.classList.add('is-in');
        io.unobserve(el);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

    targets.forEach(function (el) { io.observe(el); });
  })();
</script>


