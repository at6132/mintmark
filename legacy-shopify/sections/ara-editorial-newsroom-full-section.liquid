<script>
  (function () {
    var root = document.getElementById('AraEditorialFrontPage-{{ section.id }}');
    if (!root) return;
    root.querySelectorAll('.ara-nr-flip').forEach(function (el) {
      el.addEventListener('click', function (e) {
        var link = e.target.closest('a');
        if (link && link.getAttribute('href')) return; // let real links work
        e.preventDefault();
        el.classList.toggle('is-flipped');
      });
      el.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); el.classList.toggle('is-flipped'); }
      });
    });
  })();
</script>


