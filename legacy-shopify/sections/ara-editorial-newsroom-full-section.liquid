{% liquid
  assign lead_blocks = section.blocks | where: 'type', 'lead_story'
  assign lead_block = lead_blocks.first
  assign featured_blocks = section.blocks | where: 'type', 'featured_story'
  assign market_blocks = section.blocks | where: 'type', 'market_news'
  assign quick_blocks = section.blocks | where: 'type', 'quick_take'
  assign report_blocks = section.blocks | where: 'type', 'stock_report'
  assign question_blocks = section.blocks | where: 'type', 'question'
  assign question_block = question_blocks.first

  # Auto-fill from blog if requested
  if section.settings.auto_fill_from_blog != blank
    assign auto_blog = blogs[section.settings.auto_fill_from_blog]
    if auto_blog != blank
      assign auto_articles = auto_blog.articles
    endif
  endif
%}

<section
  id="AraEditorialFrontPage-{{ section.id }}"
  class="ara-editorial-front-page"
  style="
    --ara-news-bg: {{ section.settings.background_color }};
    --ara-news-paper: {{ section.settings.paper_color }};
    --ara-news-text: {{ section.settings.text_color }};
    --ara-news-muted: {{ section.settings.muted_text_color }};
    --ara-news-mint: {{ section.settings.mint_color }};
    --ara-news-gold: {{ section.settings.gold_color }};
    --ara-news-blue: {{ section.settings.blue_color }};
    --ara-news-border: {{ section.settings.border_color }};
    --ara-news-line: {{ section.settings.line_color }};
    --ara-news-rise: {{ section.settings.rise_color }};
    --ara-news-fall: {{ section.settings.fall_color }};
    --ara-news-max: {{ section.settings.max_width }};
    --ara-news-top: {{ section.settings.padding_top }}px;
    --ara-news-bottom: {{ section.settings.padding_bottom }}px;
    --ara-news-lead-title: {{ section.settings.desktop_main_title_size }}px;
    --ara-news-feature-title: {{ section.settings.desktop_side_title_size }}px;
    --ara-news-row-title: {{ section.settings.desktop_row_title_size }}px;
    --ara-news-body: {{ section.settings.desktop_body_size }}px;
    --ara-news-label: {{ section.settings.desktop_label_size }}px;
    --ara-news-mobile-lead-title: {{ section.settings.mobile_main_title_size }}px;
    --ara-news-mobile-feature-title: {{ section.settings.mobile_side_title_size }}px;
    --ara-news-mobile-row-title: {{ section.settings.mobile_row_title_size }}px;
    --ara-news-mobile-body: {{ section.settings.mobile_body_size }}px;
    --ara-news-mobile-label: {{ section.settings.mobile_label_size }}px;
  "
>
  <div class="ara-editorial-front-page__inner">

    {% assign mp = section.settings.masthead_position | default: 'above_ticker' %}
    {% capture ara_masthead %}
    <header class="ara-editorial-front-page__masthead">
      <div class="ara-editorial-front-page__edition">
        <span>{{ section.settings.edition_label | escape }}</span>
        <span>{{ 'now' | date: '%A, %B %d, %Y' }}</span>
        <span>{{ section.settings.edition_note | escape }}</span>
      </div>

      <div class="ara-editorial-front-page__title-row">
        <div>
          {% if section.settings.eyebrow != blank %}
            <p class="ara-editorial-front-page__eyebrow">
              {{ section.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2>{{ section.settings.heading | escape }}</h2>
          {% endif %}
        </div>

        {% if section.settings.header_note != blank %}
          <p class="ara-editorial-front-page__intro">
            {{ section.settings.header_note | escape }}
          </p>
        {% endif %}
      </div>
    </header>
    {% endcapture %}
    {% if mp == 'above_ticker' %}{{ ara_masthead }}{% endif %}

    {% if section.settings.show_ticker != false %}
      {% capture ara_ticker_items %}
        {% if lead_block != blank %}
          {% assign tk_lead_title = lead_block.settings.heading %}
          {% assign tk_lead_url = lead_block.settings.link %}
          {% if lead_block.settings.article != blank %}
            {% assign tk_lead_title = lead_block.settings.article.title %}
            {% assign tk_lead_url = lead_block.settings.article.url %}
          {% endif %}
          {% if tk_lead_title != blank %}
            <a class="ara-nr-ticker__item"{% if tk_lead_url != blank %} href="{{ tk_lead_url }}"{% endif %}><b>LEAD</b><span>{{ tk_lead_title | escape }}</span></a>
          {% endif %}
        {% endif %}
        {% for block in market_blocks %}
          {% assign tk_t = block.settings.ticker %}
          {% assign tk_h = block.settings.heading %}
          {% assign tk_u = block.settings.link %}
          {% if block.settings.article != blank %}
            {% assign tk_h = block.settings.article.title %}
            {% assign tk_u = block.settings.article.url %}
            {% for tag in block.settings.article.tags %}{% assign tv = tag | downcase %}{% if tv contains 'ticker-' %}{% assign tk_t = tv | remove_first: 'ticker-' | upcase %}{% endif %}{% endfor %}
          {% endif %}
          {% if tk_h != blank %}
            <a class="ara-nr-ticker__item"{% if tk_u != blank %} href="{{ tk_u }}"{% endif %}>{% if tk_t != blank %}<b>{{ tk_t | escape }}</b>{% endif %}<span>{{ tk_h | escape }}</span></a>
          {% endif %}
        {% endfor %}
      {% endcapture %}

      {% if ara_ticker_items != blank %}
        <div class="ara-nr-ticker" style="--ara-ticker-speed: {{ section.settings.ticker_speed | default: 45 }}s;" role="marquee" aria-label="Latest headlines">
          <div class="ara-nr-ticker__label"><span class="ara-nr-ticker__dot" aria-hidden="true"></span>{{ section.settings.ticker_label | default: 'LATEST' | escape }}</div>
          <div class="ara-nr-ticker__win">
            <div class="ara-nr-ticker__track">
              <div class="ara-nr-ticker__set">{{ ara_ticker_items }}</div>
              <div class="ara-nr-ticker__set" aria-hidden="true">{{ ara_ticker_items }}</div>
            </div>
          </div>
        </div>
      {% endif %}
    {% endif %}

    {% if mp == 'below_ticker' %}{{ ara_masthead }}{% endif %}

    <!-- ============ BAND 1: lead hero + market-news flip strips ============ -->
    <section class="ara-nr-band1">
      {% if lead_block != blank %}
        {% liquid
          assign lead_article = lead_block.settings.article
          if lead_article == blank and auto_articles != blank
            assign lead_article = auto_articles[0]
          endif
          assign lead_title = lead_block.settings.heading
          assign lead_url = lead_block.settings.link
          assign lead_image = lead_block.settings.image
          assign lead_mobile_image = lead_block.settings.mobile_image
          assign lead_excerpt = lead_block.settings.description
          assign lead_company = lead_block.settings.company
          assign lead_ticker = lead_block.settings.ticker
          assign lead_type = lead_block.settings.story_type
          assign lead_domain = lead_block.settings.domain
          assign lead_date = blank
          if lead_article != blank
            assign lead_title = lead_article.title
            assign lead_url = lead_article.url
            assign lead_image = lead_article.image
            assign lead_mobile_image = lead_article.image
            assign lead_excerpt = lead_article.excerpt_or_content
            assign lead_date = lead_article.published_at | date: '%B %d, %Y'
            for tag in lead_article.tags
              assign tag_value = tag | downcase
              if tag_value contains 'company-'
                assign lead_company = tag_value | remove_first: 'company-' | replace: '-', ' ' | capitalize
              elsif tag_value contains 'ticker-'
                assign lead_ticker = tag_value | remove_first: 'ticker-' | upcase
              elsif tag_value contains 'type-'
                assign lead_type = tag_value | remove_first: 'type-' | replace: '-', ' ' | upcase
              elsif tag_value contains 'domain-'
                assign lead_domain = tag_value | remove_first: 'domain-' | replace: '-', ' ' | upcase
              endif
            endfor
          endif
        %}

        <article
          class="ara-editorial-front-page__lead ara-nr-hero"
          style="--ara-story-accent: {{ lead_block.settings.accent_color }};"
          {{ lead_block.shopify_attributes }}
        >
          <a
            class="ara-editorial-front-page__lead-media"
            {% if lead_url != blank %}href="{{ lead_url }}"{% else %}role="link" aria-disabled="true"{% endif %}
          >
            {% if lead_image != blank %}
              <picture>
                {% if lead_mobile_image != blank %}
                  <source media="(max-width: 749px)" srcset="{{ lead_mobile_image | image_url: width: 700 }} 700w, {{ lead_mobile_image | image_url: width: 1100 }} 1100w">
                {% endif %}
                {{ lead_image | image_url: width: 1800 | image_tag: widths: '720, 1000, 1400, 1800', sizes: '(max-width: 989px) calc(100vw - 40px), 58vw', loading: 'lazy', class: 'ara-editorial-front-page__lead-image', alt: lead_image.alt }}
              </picture>
            {% else %}
              <div class="ara-editorial-front-page__lead-placeholder">
                <span>{{ lead_block.settings.placeholder_text | escape }}</span>
              </div>
            {% endif %}
            <span class="ara-editorial-front-page__lead-label">{{ lead_block.settings.article_number | escape }}</span>
          </a>

          <div class="ara-editorial-front-page__lead-copy">
            <div class="ara-editorial-front-page__meta">
              {% if lead_type != blank %}<span>{{ lead_type | escape }}</span>{% endif %}
              {% if lead_company != blank %}<span>{{ lead_company | escape }}</span>{% endif %}
              {% if lead_ticker != blank %}<span>{{ lead_ticker | escape }}</span>{% endif %}
              {% if lead_domain != blank %}<span>{{ lead_domain | escape }}</span>{% endif %}
              {% if lead_date != blank %}<span>{{ lead_date }}</span>{% endif %}
            </div>
            {% if lead_title != blank %}
              <h3><a {% if lead_url != blank %}href="{{ lead_url }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ lead_title | escape }}</a></h3>
            {% endif %}
            {% if lead_excerpt != blank %}
              <p>{{ lead_excerpt | strip_html | truncatewords: 42 }}</p>
            {% endif %}
            <div class="ara-editorial-front-page__lead-links">
              <a {% if lead_url != blank %}href="{{ lead_url }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ lead_block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>
              {% if lead_block.settings.company_module_link != blank %}
                <a href="{{ lead_block.settings.company_module_link }}">{{ lead_block.settings.company_module_label | escape }}</a>
              {% endif %}
            </div>
          </div>
        </article>
      {% endif %}

      <div class="ara-nr-strips" style="--sec: #176d5c;">
        <div class="ara-editorial-front-page__section-heading">
          <div>
            <h3>{{ section.settings.market_heading | escape }}</h3>
            <span>{{ section.settings.market_note | escape }}</span>
          </div>
          <i></i>
        </div>

        {% assign strip_max = section.settings.market_strip_count | default: 5 %}
        {% for block in market_blocks limit: strip_max %}
          {% liquid
            assign market_article = block.settings.article
            assign market_title = block.settings.heading
            assign market_url = block.settings.link
            assign market_ticker = block.settings.ticker
            assign market_time = block.settings.time_label
            assign market_summary = block.settings.summary
            if market_article != blank
              assign market_title = market_article.title
              assign market_url = market_article.url
              assign market_time = market_article.published_at | date: '%b %d'
              if market_article.excerpt_or_content != blank
                assign market_summary = market_article.excerpt_or_content | strip_html | truncatewords: 22
              endif
              for tag in market_article.tags
                assign tag_value = tag | downcase
                if tag_value contains 'ticker-'
                  assign market_ticker = tag_value | remove_first: 'ticker-' | upcase
                endif
              endfor
            endif
          %}
          <div class="ara-nr-flip ara-nr-strip" tabindex="0" role="button" aria-label="Flip market news tile" {{ block.shopify_attributes }}>
            <div class="ara-nr-flip__inner">
              <div class="ara-nr-flip__face ara-nr-flip__front">
                <div class="ara-nr-strip__tick">
                  {% if market_ticker != blank %}<b>{{ market_ticker | escape }}</b>{% endif %}
                  {% if market_time != blank %}<small>{{ market_time | escape }}</small>{% endif %}
                </div>
                <h4>{{ market_title | escape }}</h4>
              </div>
              <div class="ara-nr-flip__face ara-nr-flip__back">
                <div class="ara-nr-strip__tick">{% if market_ticker != blank %}<b>{{ market_ticker | escape }}</b>{% endif %}</div>
                <p>{% if market_summary != blank %}{{ market_summary | escape }}{% else %}Tap to read the full story.{% endif %}</p>
                <a class="ara-nr-strip__go" {% if market_url != blank %}href="{{ market_url }}"{% else %}role="link" aria-disabled="true"{% endif %}>Read <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- ============ BAND 2: company question (full width) ============ -->
    {% if question_block != blank %}
      {% liquid
        assign question_article = question_block.settings.article
        assign question_title = question_block.settings.heading
        assign question_url = question_block.settings.link
        assign question_text = question_block.settings.description
        assign question_image = question_block.settings.image
        assign question_mobile_image = question_block.settings.mobile_image
        if question_article != blank
          assign question_title = question_article.title
          assign question_url = question_article.url
          assign question_text = question_article.excerpt_or_content
          if question_article.image != blank
            assign question_image = question_article.image
            assign question_mobile_image = question_article.image
          endif
        endif
      %}
      <section class="ara-nr-band2">
        <article
          class="ara-editorial-front-page__question"
          style="--ara-question-bg: {{ question_block.settings.background_color }}; --ara-question-text: {{ question_block.settings.text_color }}; --ara-question-ratio: {{ question_block.settings.image_ratio }};"
          {{ question_block.shopify_attributes }}
        >
          <div class="ara-editorial-front-page__question-copy">
            <div class="ara-editorial-front-page__question-label">
              <span>{{ question_block.settings.label | escape }}</span>
              <i></i>
            </div>
            {% if question_title != blank %}<h3>{{ question_title | escape | newline_to_br }}</h3>{% endif %}
            {% if question_text != blank %}<p>{{ question_text | strip_html | truncatewords: 30 }}</p>{% endif %}
            <a class="ara-editorial-front-page__question-link" {% if question_url != blank %}href="{{ question_url }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ question_block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>
          </div>
          <a class="ara-editorial-front-page__question-media" {% if question_url != blank %}href="{{ question_url }}"{% else %}role="link" aria-disabled="true"{% endif %} aria-label="{{ question_block.settings.link_label | escape }}">
            {% if question_image != blank %}
              <picture>
                {% if question_mobile_image != blank %}
                  <source media="(max-width: 749px)" srcset="{{ question_mobile_image | image_url: width: 700 }} 700w, {{ question_mobile_image | image_url: width: 1000 }} 1000w">
                {% endif %}
                {{ question_image | image_url: width: 1500 | image_tag: widths: '600, 900, 1200, 1500', sizes: '(max-width: 749px) calc(100vw - 40px), 35vw', loading: 'lazy', class: 'ara-editorial-front-page__question-image', alt: question_image.alt }}
              </picture>
            {% else %}
              <div class="ara-editorial-front-page__question-placeholder" aria-hidden="true">
                <span>?</span>
                <svg viewBox="0 0 260 110" preserveAspectRatio="none"><path d="M0 86 C28 76 45 88 69 69 C95 49 118 61 141 42 C166 22 190 38 216 19 C230 9 244 13 260 5"></path></svg>
              </div>
            {% endif %}
          </a>
        </article>
      </section>
    {% endif %}

    {% if mp == 'under_question' %}{{ ara_masthead }}{% endif %}

    <!-- ============ BAND 3: short-take flip squares | pitch flip squares ============ -->
    <section class="ara-nr-band3">
      <div class="ara-nr-col" style="--sec: #c15a3c;">
        <div class="ara-editorial-front-page__section-heading">
          <div>
            <h3>{{ section.settings.quick_heading | escape }}</h3>
            <span>{{ section.settings.quick_note | escape }}</span>
          </div>
          <i></i>
        </div>
        <div class="ara-nr-sqgrid">
          {% for block in quick_blocks limit: 4 %}
            {% liquid
              assign quick_article = block.settings.article
              assign quick_title = block.settings.heading
              assign quick_url = block.settings.link
              assign quick_text = block.settings.summary
              assign quick_ticker = block.settings.ticker
              if quick_article != blank
                assign quick_title = quick_article.title
                assign quick_url = quick_article.url
                assign quick_text = quick_article.excerpt_or_content
                for tag in quick_article.tags
                  assign tag_value = tag | downcase
                  if tag_value contains 'ticker-'
                    assign quick_ticker = tag_value | remove_first: 'ticker-' | upcase
                  endif
                endfor
              endif
            %}
            <div class="ara-nr-flip ara-nr-sq" tabindex="0" role="button" aria-label="Flip short take tile" {{ block.shopify_attributes }}>
              <div class="ara-nr-flip__inner">
                <div class="ara-nr-flip__face ara-nr-flip__front">
                  <div class="ara-nr-sq__num">
                    <span>{{ block.settings.number | escape }}</span>
                    {% if quick_ticker != blank %}<b>{{ quick_ticker | escape }}</b>{% endif %}
                  </div>
                  {% if quick_title != blank %}<h4>{{ quick_title | escape }}</h4>{% endif %}
                  <div class="ara-nr-sq__foot">
                    {% if block.settings.change != blank %}<span class="ara-nr-sq__chg ara-nr-sq__chg--{{ block.settings.direction }}">{{ block.settings.change | escape }}</span>{% else %}<span></span>{% endif %}
                    <span>Tap</span>
                  </div>
                </div>
                <div class="ara-nr-flip__face ara-nr-flip__back">
                  {% if quick_text != blank %}<p>{{ quick_text | strip_html | truncatewords: 24 }}</p>{% endif %}
                  <a class="ara-nr-sq__go" {% if quick_url != blank %}href="{{ quick_url }}"{% else %}role="link" aria-disabled="true"{% endif %}>Read <span aria-hidden="true">→</span></a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="ara-nr-col" style="--sec: #c0881e;">
        <div class="ara-editorial-front-page__section-heading">
          <div>
            <h3>{{ section.settings.reports_heading | escape }}</h3>
            <span>{{ section.settings.reports_note | escape }}</span>
          </div>
          <i></i>
        </div>
        <div class="ara-nr-sqgrid">
          {% for block in report_blocks limit: 4 %}
            {% liquid
              assign report_article = block.settings.article
              assign report_title = block.settings.heading
              assign report_url = block.settings.link
              assign report_text = block.settings.summary
              assign report_ticker = block.settings.ticker
              if report_article != blank
                assign report_title = report_article.title
                assign report_url = report_article.url
                assign report_text = report_article.excerpt_or_content
                for tag in report_article.tags
                  assign tag_value = tag | downcase
                  if tag_value contains 'ticker-'
                    assign report_ticker = tag_value | remove_first: 'ticker-' | upcase
                  endif
                endfor
              endif
            %}
            <div class="ara-nr-flip ara-nr-sq ara-nr-sq--pitch" tabindex="0" role="button" aria-label="Flip pitch tile" {{ block.shopify_attributes }}>
              <div class="ara-nr-flip__inner">
                <div class="ara-nr-flip__face ara-nr-flip__front">
                  <div class="ara-nr-sq__num">
                    <span>{{ forloop.index | prepend: '0' }}</span>
                    {% if report_ticker != blank %}<b>{{ report_ticker | escape }}</b>{% endif %}
                  </div>
                  {% if report_title != blank %}<h4>{{ report_title | escape }}</h4>{% endif %}
                  <div class="ara-nr-sq__foot"><span>Pitch</span><span>Tap</span></div>
                </div>
                <div class="ara-nr-flip__face ara-nr-flip__back">
                  {% if report_text != blank %}<p>{{ report_text | strip_html | truncatewords: 24 }}</p>{% endif %}
                  <a class="ara-nr-sq__go" {% if report_url != blank %}href="{{ report_url }}"{% else %}role="link" aria-disabled="true"{% endif %}>Read the pitch <span aria-hidden="true">→</span></a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- ============ BAND 4: featured module | market map ============ -->
    <section class="ara-nr-band4">
      <div class="ara-nr-col" style="--sec: #7a4e86;">
        <div class="ara-editorial-front-page__section-heading">
          <div>
            <h3>{{ section.settings.featured_heading | default: 'More Stories' | escape }}</h3>
            <span>{{ section.settings.featured_note | escape }}</span>
          </div>
          <i></i>
        </div>
        <div class="ara-nr-featcol">
          {% for block in featured_blocks limit: 3 %}
            {% liquid
              assign featured_article = block.settings.article
              if featured_article == blank and auto_articles != blank
                assign article_index = forloop.index
                assign featured_article = auto_articles[article_index]
              endif
              assign featured_title = block.settings.heading
              assign featured_url = block.settings.link
              assign featured_excerpt = block.settings.summary
              assign featured_image = block.settings.image
              assign featured_company = block.settings.company
              assign featured_ticker = block.settings.ticker
              assign featured_type = block.settings.story_type
              assign featured_date = blank
              if featured_article != blank
                assign featured_title = featured_article.title
                assign featured_url = featured_article.url
                assign featured_excerpt = featured_article.excerpt_or_content
                assign featured_image = featured_article.image
                assign featured_date = featured_article.published_at | date: '%b %d, %Y'
                for tag in featured_article.tags
                  assign tag_value = tag | downcase
                  if tag_value contains 'company-'
                    assign featured_company = tag_value | remove_first: 'company-' | replace: '-', ' ' | capitalize
                  elsif tag_value contains 'ticker-'
                    assign featured_ticker = tag_value | remove_first: 'ticker-' | upcase
                  elsif tag_value contains 'type-'
                    assign featured_type = tag_value | remove_first: 'type-' | replace: '-', ' ' | upcase
                  endif
                endfor
              endif
            %}
            <article class="ara-editorial-front-page__featured-story" style="--ara-story-accent: {{ block.settings.accent_color }};" {{ block.shopify_attributes }}>
              {% if block.settings.show_image %}
                <a class="ara-editorial-front-page__featured-media" {% if featured_url != blank %}href="{{ featured_url }}"{% else %}role="link" aria-disabled="true"{% endif %}>
                  {% if featured_image != blank %}
                    {{ featured_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(max-width: 989px) calc(100vw - 40px), 30vw', loading: 'lazy', class: 'ara-editorial-front-page__featured-image', alt: featured_image.alt }}
                  {% else %}
                    <div class="ara-editorial-front-page__featured-placeholder">{{ block.settings.number | escape }}</div>
                  {% endif %}
                </a>
              {% endif %}
              <div class="ara-editorial-front-page__featured-copy">
                <div class="ara-editorial-front-page__featured-number">
                  <span>{{ block.settings.number | escape }}</span>
                  {% if featured_ticker != blank %}<strong>{{ featured_ticker | escape }}</strong>{% endif %}
                </div>
                <div class="ara-editorial-front-page__meta">
                  {% if featured_type != blank %}<span>{{ featured_type | escape }}</span>{% endif %}
                  {% if featured_company != blank %}<span>{{ featured_company | escape }}</span>{% endif %}
                  {% if featured_date != blank %}<span>{{ featured_date }}</span>{% endif %}
                </div>
                {% if featured_title != blank %}
                  <h4><a {% if featured_url != blank %}href="{{ featured_url }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ featured_title | escape }}</a></h4>
                {% endif %}
                {% if featured_excerpt != blank and block.settings.show_excerpt %}
                  <p>{{ featured_excerpt | strip_html | truncatewords: 18 }}</p>
                {% endif %}
                <div class="ara-editorial-front-page__story-links">
                  <a {% if featured_url != blank %}href="{{ featured_url }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>
                  {% if block.settings.company_module_link != blank %}
                    <a href="{{ block.settings.company_module_link }}">{{ block.settings.company_module_label | escape }}</a>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>

      <div class="ara-nr-col" style="--sec: #2f7e8c;">
        <div class="ara-editorial-front-page__section-heading">
          <div>
            <h3>{{ section.settings.map_heading | default: 'Market Map' | escape }}</h3>
            <span>{{ section.settings.map_note | escape }}</span>
          </div>
          <i></i>
        </div>
        <div class="ara-nr-map">
          <div class="ara-nr-map__grid">
            {% assign map_blocks = quick_blocks | concat: report_blocks %}
            {% assign map_count = 0 %}
            {% for block in map_blocks %}
              {% if map_count >= 9 %}{% break %}{% endif %}
              {% assign chip_ticker = block.settings.ticker %}
              {% if chip_ticker == blank and block.settings.article != blank %}
                {% for tag in block.settings.article.tags %}
                  {% assign tv = tag | downcase %}
                  {% if tv contains 'ticker-' %}{% assign chip_ticker = tv | remove_first: 'ticker-' | upcase %}{% endif %}
                {% endfor %}
              {% endif %}
              {% if chip_ticker == blank %}{% continue %}{% endif %}
              {% assign map_count = map_count | plus: 1 %}
              <a class="ara-nr-map__chip ara-nr-map__chip--{{ block.settings.direction | default: 'up' }}" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
                <b>{{ chip_ticker | escape }}</b>
                {% if block.settings.change != blank %}<small>{{ block.settings.change | escape }}</small>{% endif %}
              </a>
            {% endfor %}
          </div>
          <div class="ara-nr-map__foot">
            <span class="ara-editorial-front-page__eyebrow">{{ section.settings.map_caption | default: 'U.S. companies' | escape }}</span>
            {% if section.settings.map_link != blank %}
              <a href="{{ section.settings.map_link }}">{{ section.settings.map_link_label | default: 'Open the full map' | escape }} <span aria-hidden="true">→</span></a>
            {% endif %}
          </div>
        </div>
      </div>
    </section>

  </div>
</section>

