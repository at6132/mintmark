<style>
  /* ============================================================
     ARA-NR POLISH KIT + MOTION  (soft cards · accents · reveal)
     ============================================================ */
  {%- assign S = section.id -%}
  #AraEditorialFrontPage-{{ S }} .ara-nr-ticker { border-radius: 12px; }

  /* --- soft rounded corners on every content surface --- */
  #AraEditorialFrontPage-{{ S }} .ara-nr-strip,
  #AraEditorialFrontPage-{{ S }} .ara-nr-strip .ara-nr-flip__face,
  #AraEditorialFrontPage-{{ S }} .ara-nr-sq,
  #AraEditorialFrontPage-{{ S }} .ara-nr-sq .ara-nr-flip__face,
  #AraEditorialFrontPage-{{ S }} .ara-nr-flip__inner { border-radius: 12px; }
  #AraEditorialFrontPage-{{ S }} .ara-editorial-front-page__lead-media { border-radius: 14px; overflow: hidden; }
  #AraEditorialFrontPage-{{ S }} .ara-editorial-front-page__featured-media { border-radius: 10px; overflow: hidden; }
  #AraEditorialFrontPage-{{ S }} .ara-editorial-front-page__question { border-radius: 16px; overflow: hidden; }
  #AraEditorialFrontPage-{{ S }} .ara-nr-map { border-radius: 14px; }
  #AraEditorialFrontPage-{{ S }} .ara-nr-map__chip { border-radius: 8px; }

  /* --- one soft shadow system --- */
  #AraEditorialFrontPage-{{ S }} .ara-nr-strip .ara-nr-flip__face { box-shadow: 0 8px 20px rgba(22,27,46,.06); }
  #AraEditorialFrontPage-{{ S }} .ara-nr-sq .ara-nr-flip__face { box-shadow: 0 10px 24px rgba(22,27,46,.06); }
  #AraEditorialFrontPage-{{ S }} .ara-editorial-front-page__lead-media { box-shadow: 0 14px 34px rgba(22,27,46,.08); }
  #AraEditorialFrontPage-{{ S }} .ara-editorial-front-page__question { box-shadow: 0 16px 40px rgba(22,27,46,.10); }
  #AraEditorialFrontPage-{{ S }} .ara-nr-map { box-shadow: 0 10px 26px rgba(22,27,46,.06); }

  /* --- accent nuance: gold tab under every section heading --- */
  #AraEditorialFrontPage-{{ S }} .ara-editorial-front-page__section-heading { position: relative; }
  #AraEditorialFrontPage-{{ S }} .ara-editorial-front-page__section-heading::after {
    content: ""; position: absolute; left: 0; bottom: -2px; width: 46px; height: 3px;
    background: var(--sec, var(--ara-news-gold)); border-radius: 3px;
  }
  /* --- WSJ-style rules: kill the misaligned floating hairline, add a clean thin rule
         above each kicker + breathing room below, and vertical column dividers --- */
  #AraEditorialFrontPage-{{ S }} .ara-editorial-front-page__section-heading { margin: 6px 0 22px; padding-bottom: 10px; }
  #AraEditorialFrontPage-{{ S }} .ara-editorial-front-page__section-heading i { display: none; }
  #AraEditorialFrontPage-{{ S }} .ara-editorial-front-page__section-heading::before {
    content: ""; position: absolute; top: -12px; left: 0; right: 0; height: 1px;
    background: var(--ara-news-border);
  }
  #AraEditorialFrontPage-{{ S }} .ara-nr-band3,
  #AraEditorialFrontPage-{{ S }} .ara-nr-band4 { gap: 0; }
  #AraEditorialFrontPage-{{ S }} .ara-nr-band3 > .ara-nr-col + .ara-nr-col,
  #AraEditorialFrontPage-{{ S }} .ara-nr-band4 > .ara-nr-col + .ara-nr-col { border-left: 1px solid var(--ara-news-border); padding-left: 34px; }
