<section
  id="AraContactEditorial-{{ section.id }}"
  class="ara-contact-editorial"
  style="
    --ara-contact-bg: {{ section.settings.background_color }};
    --ara-contact-paper: {{ section.settings.paper_color }};
    --ara-contact-ink: {{ section.settings.text_color }};
    --ara-contact-muted: {{ section.settings.muted_text_color }};
    --ara-contact-mint: {{ section.settings.mint_color }};
    --ara-contact-gold: {{ section.settings.gold_color }};
    --ara-contact-rule: {{ section.settings.border_color }};
    --ara-contact-max: {{ section.settings.max_width }};
    --ara-contact-top: {{ section.settings.padding_top }}px;
    --ara-contact-bottom: {{ section.settings.padding_bottom }}px;
    --ara-contact-heading-desktop: {{ section.settings.desktop_heading_size }}px;
    --ara-contact-body-desktop: {{ section.settings.desktop_body_size }}px;
    --ara-contact-label-desktop: {{ section.settings.desktop_label_size }}px;
    --ara-contact-heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --ara-contact-body-mobile: {{ section.settings.mobile_body_size }}px;
    --ara-contact-label-mobile: {{ section.settings.mobile_label_size }}px;
  "
>
  <div class="ara-contact-editorial__inner">
    <header class="ara-contact-editorial__intro">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ara-contact-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1>{{ section.settings.heading | escape | newline_to_br }}</h1>
        {% endif %}
      </div>

      {% if section.settings.description != blank %}
        <div class="ara-contact-editorial__description">{{ section.settings.description }}</div>
      {% endif %}
    </header>

    <div class="ara-contact-editorial__layout">
      <aside class="ara-contact-editorial__desk">
        <div class="ara-contact-editorial__desk-head">
          <span>{{ section.settings.desk_label | escape }}</span>
          <strong>{{ section.settings.response_time | escape }}</strong>
        </div>

        <div class="ara-contact-editorial__channels">
          {% for block in section.blocks %}
            <article class="ara-contact-editorial__channel" {{ block.shopify_attributes }}>
              <span>{{ forloop.index | prepend: '0' }}</span>
              <div>
                <h2>{{ block.settings.heading | escape }}</h2>
                <p>{{ block.settings.text | escape }}</p>

                {% if block.settings.link_label != blank %}
                  <a
                    {% if block.settings.link != blank %}
                      href="{{ block.settings.link }}"
                    {% else %}
                      role="link"
                      aria-disabled="true"
                    {% endif %}
                  >
                    {{ block.settings.link_label | escape }}
                    <span aria-hidden="true">→</span>
                  </a>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>

        {% if section.settings.note != blank %}
          <p class="ara-contact-editorial__note">{{ section.settings.note | escape }}</p>
        {% endif %}
      </aside>

      <div class="ara-contact-editorial__form-panel">
        <div class="ara-contact-editorial__form-head">
          <span>{{ section.settings.form_eyebrow | escape }}</span>
          <h2>{{ section.settings.form_heading | escape }}</h2>
        </div>

        {% form 'contact', class: 'ara-contact-editorial__form' %}
          {% if form.posted_successfully? %}
            <div class="ara-contact-editorial__success" tabindex="-1" autofocus>
              {{ section.settings.success_message | escape }}
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="ara-contact-editorial__errors">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="ara-contact-editorial__row">
            <label>
              <span>{{ section.settings.name_label | escape }}</span>
              <input
                type="text"
                name="contact[name]"
                value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
                autocomplete="name"
                required
              >
            </label>

            <label>
              <span>{{ section.settings.email_label | escape }}</span>
              <input
                type="email"
                name="contact[email]"
                value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
              >
            </label>
          </div>

          <div class="ara-contact-editorial__row">
            <label>
              <span>{{ section.settings.phone_label | escape }}</span>
              <input
                type="tel"
                name="contact[phone]"
                value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"
                autocomplete="tel"
              >
            </label>

            <label>
              <span>{{ section.settings.topic_label | escape }}</span>
              <select name="contact[topic]">
                <option value="General question">{{ section.settings.topic_general | escape }}</option>
                <option value="Books and fulfilment">{{ section.settings.topic_books | escape }}</option>
                <option value="Educational content">{{ section.settings.topic_content | escape }}</option>
                <option value="Press and partnerships">{{ section.settings.topic_partnerships | escape }}</option>
              </select>
            </label>
          </div>

          <label>
            <span>{{ section.settings.message_label | escape }}</span>
            <textarea name="contact[body]" rows="7" required>{{ form.body | escape }}</textarea>
          </label>

          <button type="submit">
            {{ section.settings.button_label | escape }}
            <span aria-hidden="true">→</span>
          </button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

<style>
  #AraContactEditorial-{{ section.id }} {
    position: relative;
    overflow: hidden;
    padding: var(--ara-contact-top) 0 var(--ara-contact-bottom);
    background-color: var(--ara-contact-bg);
    background-image: repeating-linear-gradient(to bottom, transparent 0 35px, color-mix(in srgb, var(--ara-contact-mint) 9%, transparent) 35px 36px);
    color: var(--ara-contact-ink);
  }

  #AraContactEditorial-{{ section.id }} * {
    box-sizing: border-box;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__inner {
    width: min(100%, var(--ara-contact-max));
    margin: 0 auto;
    padding: 0 40px;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(330px, 0.9fr);
    gap: 55px;
    align-items: end;
    padding: 25px 0 30px;
    border-top: 4px solid var(--ara-contact-ink);
    border-bottom: 1px solid var(--ara-contact-ink);
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__eyebrow,
  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__desk-head span,
  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__form-head > span,
  #AraContactEditorial-{{ section.id }} label > span {
    margin: 0;
    color: var(--ara-contact-mint);
    font-family: var(--font-body-family);
    font-size: var(--ara-contact-label-desktop);
    font-weight: 900;
    letter-spacing: 0.15em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__intro h1 {
    margin: 12px 0 0;
    font-family: var(--font-heading-family);
    font-size: var(--ara-contact-heading-desktop);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    letter-spacing: -0.055em;
    line-height: 0.93;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__description {
    color: var(--ara-contact-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-contact-body-desktop);
    line-height: 1.65;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__description p {
    margin: 0;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__layout {
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
    gap: 24px;
    margin-top: 35px;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__desk,
  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__form-panel {
    border: 1px solid var(--ara-contact-ink);
    border-radius: 14px;
    background: var(--ara-contact-paper);
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__desk {
    display: flex;
    flex-direction: column;
    padding: 25px;
    box-shadow: 7px 7px 0 color-mix(in srgb, var(--ara-contact-mint) 22%, transparent);
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__desk-head {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding-bottom: 17px;
    border-bottom: 1px solid var(--ara-contact-ink);
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__desk-head strong {
    font-family: var(--font-body-family);
    font-size: var(--ara-contact-label-desktop);
    font-weight: 900;
    letter-spacing: 0.1em;
    text-align: right;
    text-transform: uppercase;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__channels {
    display: grid;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__channel {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 15px;
    padding: 24px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ara-contact-ink) 22%, transparent);
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__channel > span {
    color: var(--ara-contact-gold);
    font-family: var(--font-heading-family);
    font-size: 21px;
    line-height: 1;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__channel h2 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 25px;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__channel p,
  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__note {
    margin: 9px 0 0;
    color: var(--ara-contact-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-contact-body-desktop);
    line-height: 1.55;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__channel a {
    display: inline-flex;
    gap: 8px;
    margin-top: 12px;
    color: var(--ara-contact-ink);
    font-family: var(--font-body-family);
    font-size: var(--ara-contact-label-desktop);
    font-weight: 900;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__note {
    margin-top: auto;
    padding-top: 23px;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__form-panel {
    overflow: hidden;
    box-shadow: 7px 7px 0 color-mix(in srgb, var(--ara-contact-gold) 26%, transparent);
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__form-head {
    padding: 24px 27px;
    border-bottom: 1px solid var(--ara-contact-ink);
    background: var(--ara-contact-ink);
    color: #FFFFFF;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__form-head h2 {
    margin: 8px 0 0;
    font-family: var(--font-heading-family);
    font-size: 35px;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__form {
    display: grid;
    gap: 19px;
    padding: 28px;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 17px;
  }

  #AraContactEditorial-{{ section.id }} label {
    display: grid;
    gap: 8px;
  }

  #AraContactEditorial-{{ section.id }} input,
  #AraContactEditorial-{{ section.id }} select,
  #AraContactEditorial-{{ section.id }} textarea {
    width: 100%;
    min-width: 0;
    border: 1px solid var(--ara-contact-rule);
    border-radius: 8px;
    background: #FFFFFF;
    color: var(--ara-contact-ink);
    font: inherit;
    font-family: var(--font-body-family);
    font-size: var(--ara-contact-body-desktop);
  }

  #AraContactEditorial-{{ section.id }} input,
  #AraContactEditorial-{{ section.id }} select {
    min-height: 49px;
    padding: 11px 13px;
  }

  #AraContactEditorial-{{ section.id }} textarea {
    min-height: 170px;
    padding: 13px;
    resize: vertical;
  }

  #AraContactEditorial-{{ section.id }} input:focus-visible,
  #AraContactEditorial-{{ section.id }} select:focus-visible,
  #AraContactEditorial-{{ section.id }} textarea:focus-visible {
    outline: 2px solid var(--ara-contact-mint);
    outline-offset: 2px;
  }

  #AraContactEditorial-{{ section.id }} button {
    display: inline-flex;
    width: fit-content;
    min-height: 47px;
    gap: 10px;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border: 1px solid var(--ara-contact-ink);
    border-radius: 7px;
    background: var(--ara-contact-ink);
    color: #FFFFFF;
    font-family: var(--font-body-family);
    font-size: var(--ara-contact-label-desktop);
    font-weight: 900;
    letter-spacing: 0.1em;
    cursor: pointer;
    text-transform: uppercase;
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__success,
  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__errors {
    padding: 13px 15px;
    border: 1px solid var(--ara-contact-ink);
    border-radius: 8px;
    font-family: var(--font-body-family);
    font-size: var(--ara-contact-body-desktop);
  }

  #AraContactEditorial-{{ section.id }} .ara-contact-editorial__success {
    background: color-mix(in srgb, var(--ara-contact-mint) 14%, #FFFFFF);
  }

  @media screen and (max-width: 989px) {
    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__intro,
    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__layout {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__inner {
      padding: 0 18px;
    }

    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__intro {
      gap: 19px;
    }

    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__intro h1 {
      font-size: var(--ara-contact-heading-mobile);
    }

    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__description,
    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__channel p,
    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__note,
    #AraContactEditorial-{{ section.id }} input,
    #AraContactEditorial-{{ section.id }} select,
    #AraContactEditorial-{{ section.id }} textarea,
    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__success,
    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__errors {
      font-size: var(--ara-contact-body-mobile);
    }

    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__eyebrow,
    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__desk-head span,
    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__desk-head strong,
    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__form-head > span,
    #AraContactEditorial-{{ section.id }} label > span,
    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__channel a,
    #AraContactEditorial-{{ section.id }} button {
      font-size: var(--ara-contact-label-mobile);
    }

    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__desk,
    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__form-panel {
      border-radius: 10px;
      box-shadow: 4px 4px 0 color-mix(in srgb, var(--ara-contact-mint) 18%, transparent);
    }

    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__row {
      grid-template-columns: 1fr;
    }

    #AraContactEditorial-{{ section.id }} .ara-contact-editorial__form {
      padding: 20px;
    }

    #AraContactEditorial-{{ section.id }} button {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Ara Contact",
  "max_blocks": 4,
  "settings": [
    {"type":"text","id":"eyebrow","label":"Small heading","default":"CONTACT MINTMARK"},
    {"type":"textarea","id":"heading","label":"Heading","default":"Questions belong\nhere."},
    {"type":"richtext","id":"description","label":"Introduction","default":"<p>Ask about a company module, a physical digest, fulfilment or the wider Mintmark project.</p>"},
    {"type":"text","id":"desk_label","label":"Information heading","default":"READER DESK"},
    {"type":"text","id":"response_time","label":"Response time","default":"REPLIES WITHIN 2 BUSINESS DAYS"},
    {"type":"textarea","id":"note","label":"Additional note","default":"For an order question, include the email address used at checkout and the order number when available."},
    {"type":"text","id":"form_eyebrow","label":"Form small heading","default":"SEND A NOTE"},
    {"type":"text","id":"form_heading","label":"Form heading","default":"Write to the team."},
    {"type":"text","id":"name_label","label":"Name field","default":"NAME"},
    {"type":"text","id":"email_label","label":"Email field","default":"EMAIL"},
    {"type":"text","id":"phone_label","label":"Phone field","default":"PHONE · OPTIONAL"},
    {"type":"text","id":"topic_label","label":"Topic field","default":"TOPIC"},
    {"type":"text","id":"message_label","label":"Message field","default":"MESSAGE"},
    {"type":"text","id":"topic_general","label":"General topic","default":"General question"},
    {"type":"text","id":"topic_books","label":"Books topic","default":"Books and fulfilment"},
    {"type":"text","id":"topic_content","label":"Content topic","default":"Educational content"},
    {"type":"text","id":"topic_partnerships","label":"Partnership topic","default":"Press and partnerships"},
    {"type":"text","id":"button_label","label":"Send button","default":"SEND MESSAGE"},
    {"type":"text","id":"success_message","label":"Success message","default":"Thank you. Your message has been received."},
    {"type":"range","id":"desktop_heading_size","label":"Desktop heading size","min":44,"max":92,"step":2,"unit":"px","default":72},
    {"type":"range","id":"desktop_body_size","label":"Desktop body size","min":13,"max":20,"step":1,"unit":"px","default":16},
    {"type":"range","id":"desktop_label_size","label":"Desktop label size","min":8,"max":14,"step":1,"unit":"px","default":10},
    {"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":34,"max":62,"step":2,"unit":"px","default":48},
    {"type":"range","id":"mobile_body_size","label":"Mobile body size","min":13,"max":18,"step":1,"unit":"px","default":15},
    {"type":"range","id":"mobile_label_size","label":"Mobile label size","min":8,"max":13,"step":1,"unit":"px","default":9},
    {"type":"select","id":"max_width","label":"Page width","default":"1500px","options":[{"value":"1200px","label":"Narrow"},{"value":"1500px","label":"Wide"},{"value":"1700px","label":"Extra wide"}]},
    {"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":160,"step":5,"unit":"px","default":75},
    {"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":160,"step":5,"unit":"px","default":100},
    {"type":"color","id":"background_color","label":"Background","default":"#F5EFE1"},
    {"type":"color","id":"paper_color","label":"Panel","default":"#FBF7EC"},
    {"type":"color","id":"text_color","label":"Text","default":"#161B2E"},
    {"type":"color","id":"muted_text_color","label":"Secondary text","default":"#646575"},
    {"type":"color","id":"mint_color","label":"Mint","default":"#1FA88F"},
    {"type":"color","id":"gold_color","label":"Gold","default":"#E0A526"},
    {"type":"color","id":"border_color","label":"Borders","default":"#C9BEA8"}
  ],
  "blocks": [
    {
      "type":"channel",
      "name":"Contact option",
      "settings":[
        {"type":"text","id":"heading","label":"Heading","default":"General questions"},
        {"type":"textarea","id":"text","label":"Description","default":"Questions about Mintmark, the curriculum or company modules."},
        {"type":"text","id":"link_label","label":"Link label","default":"SEND A MESSAGE"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name":"Ara Contact",
      "blocks":[
        {"type":"channel","settings":{"heading":"General questions","text":"Questions about Mintmark, the curriculum or company modules.","link_label":"USE THE FORM"}},
        {"type":"channel","settings":{"heading":"Books and fulfilment","text":"Questions about physical digests, orders, shipping or Lulu Direct fulfilment.","link_label":"USE THE FORM"}},
        {"type":"channel","settings":{"heading":"Press and partnerships","text":"Editorial, education and partnership enquiries.","link_label":"USE THE FORM"}}
      ]
    }
  ]
}
{% endschema %}
