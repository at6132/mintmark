<section
  id="AraMissionHero-{{ section.id }}"
  class="ara-mission-hero"
  style="
    --ara-mission-bg: {{ section.settings.background_color }};
    --ara-mission-paper: {{ section.settings.paper_color }};
    --ara-mission-text: {{ section.settings.text_color }};
    --ara-mission-muted: {{ section.settings.muted_text_color }};
    --ara-mission-mint: {{ section.settings.mint_color }};
    --ara-mission-gold: {{ section.settings.gold_color }};
    --ara-mission-blue: {{ section.settings.blue_color }};
    --ara-mission-border: {{ section.settings.border_color }};
    --ara-mission-max: {{ section.settings.max_width }};
    --ara-mission-top: {{ section.settings.padding_top }}px;
    --ara-mission-bottom: {{ section.settings.padding_bottom }}px;
    --ara-mission-heading-desktop: {{ section.settings.desktop_heading_size }}px;
    --ara-mission-body-desktop: {{ section.settings.desktop_body_size }}px;
    --ara-mission-label-desktop: {{ section.settings.desktop_label_size }}px;
    --ara-mission-button-desktop: {{ section.settings.desktop_button_size }}px;
    --ara-mission-value-title-desktop: {{ section.settings.desktop_value_title_size }}px;
    --ara-mission-value-text-desktop: {{ section.settings.desktop_value_text_size }}px;
    --ara-mission-heading-mobile: {{ section.settings.mobile_heading_size }}px;
    --ara-mission-body-mobile: {{ section.settings.mobile_body_size }}px;
    --ara-mission-label-mobile: {{ section.settings.mobile_label_size }}px;
    --ara-mission-button-mobile: {{ section.settings.mobile_button_size }}px;
    --ara-mission-value-title-mobile: {{ section.settings.mobile_value_title_size }}px;
    --ara-mission-value-text-mobile: {{ section.settings.mobile_value_text_size }}px;
  "
>
  <div class="ara-mission-hero__lines" aria-hidden="true"></div>

  <div class="ara-mission-hero__inner">
    <div class="ara-mission-hero__frame">
      <div class="ara-mission-hero__panel">
        <div class="ara-mission-hero__copy">
          <div class="ara-mission-hero__meta">
            {% if section.settings.eyebrow != blank %}
              <span class="ara-mission-hero__eyebrow">
                {{ section.settings.eyebrow | escape }}
              </span>
            {% endif %}

            {% if section.settings.folio != blank %}
              <span class="ara-mission-hero__folio">
                {{ section.settings.folio | escape }}
              </span>
            {% endif %}
          </div>

          {% if section.settings.heading != blank %}
            <h1 class="ara-mission-hero__heading">
              {{ section.settings.heading | escape | newline_to_br }}
            </h1>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="ara-mission-hero__description">
              {{ section.settings.description }}
            </div>
          {% endif %}

          <div class="ara-mission-hero__buttons">
            {% if section.settings.primary_button_label != blank %}
              <a
                class="ara-mission-hero__button ara-mission-hero__button--primary"
                {% if section.settings.primary_button_link != blank %}
                  href="{{ section.settings.primary_button_link }}"
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
              >
                {{ section.settings.primary_button_label | escape }}
              </a>
            {% endif %}

            {% if section.settings.secondary_button_label != blank %}
              <a
                class="ara-mission-hero__button ara-mission-hero__button--secondary"
                {% if section.settings.secondary_button_link != blank %}
                  href="{{ section.settings.secondary_button_link }}"
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
              >
                {{ section.settings.secondary_button_label | escape }}
              </a>
            {% endif %}
          </div>

          {% if section.settings.bottom_note != blank %}
            <p class="ara-mission-hero__bottom-note">
              {{ section.settings.bottom_note | escape }}
            </p>
          {% endif %}
        </div>

        <div class="ara-mission-hero__visual">
          <div class="ara-mission-hero__visual-frame">
            {% if section.settings.image != blank %}
              {{
                section.settings.image
                | image_url: width: 1800
                | image_tag:
                  widths: '500, 750, 1000, 1400, 1800',
                  sizes: '(max-width: 749px) 100vw, 48vw',
                  loading: 'eager',
                  class: 'ara-mission-hero__image',
                  alt: section.settings.image.alt
              }}
            {% else %}
              <div class="ara-mission-hero__placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'ara-mission-hero__placeholder-svg' }}
              </div>
            {% endif %}

            {% if section.settings.image_label != blank %}
              <span class="ara-mission-hero__image-label">
                {{ section.settings.image_label | escape }}
              </span>
            {% endif %}
          </div>

          {% if section.settings.quote != blank %}
            <blockquote class="ara-mission-hero__quote">
              <p>{{ section.settings.quote | escape }}</p>

              {% if section.settings.quote_label != blank %}
                <cite>{{ section.settings.quote_label | escape }}</cite>
              {% endif %}
            </blockquote>
          {% endif %}
        </div>
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="ara-mission-hero__values">
        {% for block in section.blocks %}
          <article
            class="ara-mission-hero__value ara-mission-hero__value--{{ block.settings.style }}"
            {{ block.shopify_attributes }}
          >
            <span class="ara-mission-hero__value-number">
              {{ forloop.index | prepend: '0' }}
            </span>

            <div>
              {% if block.settings.title != blank %}
                <h2>{{ block.settings.title | escape }}</h2>
              {% endif %}

              {% if block.settings.text != blank %}
                <p>{{ block.settings.text | escape }}</p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #AraMissionHero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    padding: var(--ara-mission-top) 0 var(--ara-mission-bottom);
    background: var(--ara-mission-bg);
    color: var(--ara-mission-text);
    isolation: isolate;
  }

  #AraMissionHero-{{ section.id }} * {
    box-sizing: border-box;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.46;
    background-image:
      linear-gradient(
        90deg,
        transparent 0,
        transparent 31px,
        color-mix(in srgb, var(--ara-mission-mint) 12%, transparent) 31px,
        color-mix(in srgb, var(--ara-mission-mint) 12%, transparent) 32px
      ),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 35px,
        color-mix(in srgb, var(--ara-mission-mint) 22%, transparent) 35px,
        color-mix(in srgb, var(--ara-mission-mint) 22%, transparent) 36px
      );
    pointer-events: none;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__inner {
    width: min(100%, var(--ara-mission-max));
    margin: 0 auto;
    padding: 0 40px;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__frame {
    padding: 8px;
    border: 2px solid var(--ara-mission-text);
    border-radius: 26px;
    background: var(--ara-mission-paper);
    box-shadow:
      10px 10px 0 var(--ara-mission-gold),
      18px 18px 0 color-mix(in srgb, var(--ara-mission-mint) 68%, transparent);
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
    gap: clamp(36px, 5vw, 82px);
    align-items: center;
    padding: clamp(38px, 5vw, 76px);
    border: 3px solid var(--ara-mission-text);
    border-radius: 17px;
    background:
      radial-gradient(
        circle at 112% 112%,
        color-mix(in srgb, var(--ara-mission-mint) 15%, transparent) 0 29%,
        transparent 30%
      ),
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--ara-mission-paper) 96%, white),
        color-mix(in srgb, var(--ara-mission-bg) 92%, transparent)
      );
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__meta {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: flex-start;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__eyebrow,
  #AraMissionHero-{{ section.id }} .ara-mission-hero__folio,
  #AraMissionHero-{{ section.id }} .ara-mission-hero__bottom-note,
  #AraMissionHero-{{ section.id }} .ara-mission-hero__image-label,
  #AraMissionHero-{{ section.id }} .ara-mission-hero__quote cite,
  #AraMissionHero-{{ section.id }} .ara-mission-hero__value-number {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__eyebrow {
    display: inline-flex;
    min-height: 31px;
    align-items: center;
    padding: 6px 11px;
    border: 2px solid var(--ara-mission-text);
    border-radius: 8px;
    background: var(--ara-mission-gold);
    color: var(--ara-mission-text);
    font-size: var(--ara-mission-label-desktop);
    box-shadow: 3px 3px 0 var(--ara-mission-text);
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__folio {
    color: var(--ara-mission-muted);
    font-size: var(--ara-mission-label-desktop);
    text-align: right;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__heading {
    max-width: 860px;
    margin: 26px 0 0;
    font-family: var(--font-heading-family);
    font-size: var(--ara-mission-heading-desktop);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 0.93;
    letter-spacing: -0.055em;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__description {
    max-width: 720px;
    margin-top: 27px;
    color: var(--ara-mission-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-mission-body-desktop);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.65;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__description p {
    margin: 0;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 32px;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__button {
    display: inline-flex;
    min-width: 188px;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    border: 2px solid currentColor;
    border-radius: 8px;
    font-family: var(--font-body-family);
    font-size: var(--ara-mission-button-desktop);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 currentColor;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__button:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 currentColor;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__button--primary {
    background: var(--ara-mission-mint);
    color: #FFFFFF;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__button--secondary {
    background: var(--ara-mission-gold);
    color: var(--ara-mission-text);
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__bottom-note {
    margin: 48px 0 0;
    padding-top: 16px;
    border-top: 1px dashed color-mix(in srgb, var(--ara-mission-text) 34%, transparent);
    color: var(--ara-mission-muted);
    font-size: var(--ara-mission-label-desktop);
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__visual {
    position: relative;
    min-width: 0;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__visual-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    padding: 7px;
    border: 2px solid var(--ara-mission-text);
    border-radius: 22px;
    background: var(--ara-mission-paper);
    box-shadow:
      8px 8px 0 var(--ara-mission-blue),
      14px 14px 0 color-mix(in srgb, var(--ara-mission-gold) 72%, transparent);
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__image,
  #AraMissionHero-{{ section.id }} .ara-mission-hero__placeholder,
  #AraMissionHero-{{ section.id }} .ara-mission-hero__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__image,
  #AraMissionHero-{{ section.id }} .ara-mission-hero__placeholder-svg {
    border: 3px solid var(--ara-mission-text);
    border-radius: 14px;
    object-fit: cover;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__placeholder-svg {
    background: var(--ara-mission-paper);
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__image-label {
    position: absolute;
    right: 18px;
    bottom: 18px;
    left: 18px;
    padding: 8px 12px;
    border: 2px solid var(--ara-mission-text);
    border-radius: 8px;
    background: var(--ara-mission-gold);
    color: var(--ara-mission-text);
    font-size: var(--ara-mission-label-desktop);
    text-align: center;
    box-shadow: 3px 3px 0 var(--ara-mission-text);
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__quote {
    position: absolute;
    right: -26px;
    bottom: -30px;
    width: min(88%, 360px);
    margin: 0;
    padding: 20px;
    border: 2px solid var(--ara-mission-text);
    border-radius: 14px;
    background: var(--ara-mission-blue);
    color: #FFFFFF;
    box-shadow: 5px 5px 0 var(--ara-mission-gold);
    transform: rotate(2deg);
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__quote p {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(24px, 2.4vw, 36px);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 1.05;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__quote cite {
    display: block;
    margin-top: 16px;
    color: var(--ara-mission-gold);
    font-size: var(--ara-mission-label-desktop);
    font-style: normal;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 42px;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__value {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 16px;
    min-height: 170px;
    align-content: start;
    padding: 24px;
    border: 2px solid var(--ara-mission-text);
    border-radius: 16px;
    box-shadow: 5px 5px 0 var(--ara-mission-text);
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__value--cream {
    background: var(--ara-mission-paper);
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__value--gold {
    background: var(--ara-mission-gold);
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__value--blue {
    background: var(--ara-mission-blue);
    color: #FFFFFF;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__value-number {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 2px solid currentColor;
    border-radius: 50%;
    font-size: var(--ara-mission-label-desktop);
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__value h2 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: var(--ara-mission-value-title-desktop);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 1;
  }

  #AraMissionHero-{{ section.id }} .ara-mission-hero__value p {
    margin: 12px 0 0;
    font-family: var(--font-body-family);
    font-size: var(--ara-mission-value-text-desktop);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.5;
  }

  @media screen and (max-width: 1099px) {
    #AraMissionHero-{{ section.id }} .ara-mission-hero__panel {
      grid-template-columns: 1fr;
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__visual {
      max-width: 760px;
    }
  }

  @media screen and (max-width: 899px) {
    #AraMissionHero-{{ section.id }} .ara-mission-hero__values {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    #AraMissionHero-{{ section.id }} {
      padding-top: calc(var(--ara-mission-top) * 0.7);
      padding-bottom: calc(var(--ara-mission-bottom) * 0.7);
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__inner {
      padding: 0 20px;
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__frame {
      padding: 5px;
      box-shadow:
        5px 5px 0 var(--ara-mission-gold),
        10px 10px 0 color-mix(in srgb, var(--ara-mission-mint) 68%, transparent);
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__panel {
      padding: 32px 24px 40px;
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__meta {
      align-items: flex-start;
      flex-direction: column;
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__eyebrow,
    #AraMissionHero-{{ section.id }} .ara-mission-hero__folio,
    #AraMissionHero-{{ section.id }} .ara-mission-hero__bottom-note,
    #AraMissionHero-{{ section.id }} .ara-mission-hero__image-label,
    #AraMissionHero-{{ section.id }} .ara-mission-hero__quote cite,
    #AraMissionHero-{{ section.id }} .ara-mission-hero__value-number {
      font-size: var(--ara-mission-label-mobile);
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__folio {
      text-align: left;
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__heading {
      font-size: var(--ara-mission-heading-mobile);
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__description {
      font-size: var(--ara-mission-body-mobile);
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__buttons {
      display: grid;
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__button {
      width: 100%;
      font-size: var(--ara-mission-button-mobile);
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__visual-frame {
      box-shadow:
        5px 5px 0 var(--ara-mission-blue),
        10px 10px 0 color-mix(in srgb, var(--ara-mission-gold) 72%, transparent);
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__quote {
      position: relative;
      right: auto;
      bottom: auto;
      width: calc(100% - 24px);
      margin: -20px auto 0;
      transform: rotate(1deg);
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__values {
      margin-top: 32px;
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__value {
      min-height: 0;
      padding: 22px;
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__value h2 {
      font-size: var(--ara-mission-value-title-mobile);
    }

    #AraMissionHero-{{ section.id }} .ara-mission-hero__value p {
      font-size: var(--ara-mission-value-text-mobile);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #AraMissionHero-{{ section.id }} .ara-mission-hero__button {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "Ara Mission Hero",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "OUR MISSION"
    },
    {
      "type": "text",
      "id": "folio",
      "label": "Top note",
      "default": "WHY MINTMARK EXISTS"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main heading",
      "default": "Financial literacy\nshould feel possible."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Mintmark exists to make business and finance easier to understand. We turn complicated company stories, financial ideas and market language into clear learning experiences people can return to again and again.</p>"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "First button text",
      "default": "EXPLORE THE MINT"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Second button text",
      "default": "VISIT THE BOOKSHELF"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Second button link"
    },
    {
      "type": "text",
      "id": "bottom_note",
      "label": "Bottom note",
      "default": "CLEAR IDEAS · REAL COMPANIES · BETTER FINANCIAL CONFIDENCE"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Mission graphic"
    },
    {
      "type": "text",
      "id": "image_label",
      "label": "Image label",
      "default": "UNDERSTANDING STARTS WITH A CLEARER VIEW"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Featured quote",
      "default": "The goal is not to make finance simple. It is to make it understandable."
    },
    {
      "type": "text",
      "id": "quote_label",
      "label": "Quote label",
      "default": "THE MINTMARK PRINCIPLE"
    },
    {
      "type": "header",
      "content": "Desktop typography"
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "min": 44,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Main heading size",
      "default": 76
    },
    {
      "type": "range",
      "id": "desktop_body_size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 17
    },
    {
      "type": "range",
      "id": "desktop_label_size",
      "min": 8,
