<section
  id="AraMintDomains-{{ section.id }}"
  class="ara-mint-domains"
  style="
    --ara-mint-bg: {{ section.settings.background_color }};
    --ara-mint-deep-bg: {{ section.settings.deep_background_color }};
    --ara-mint-card: {{ section.settings.card_color }};
    --ara-mint-text: {{ section.settings.text_color }};
    --ara-mint-muted: {{ section.settings.muted_text_color }};
    --ara-mint-accent: {{ section.settings.accent_color }};
    --ara-mint-gold: {{ section.settings.gold_color }};
    --ara-mint-blue: {{ section.settings.blue_color }};
    --ara-mint-blue-deep: {{ section.settings.blue_deep_color }};
    --ara-mint-border: {{ section.settings.border_color }};
    --ara-mint-line: {{ section.settings.line_color }};
    --ara-mint-max: {{ section.settings.max_width }};
    --ara-mint-top: {{ section.settings.padding_top }}px;
    --ara-mint-bottom: {{ section.settings.padding_bottom }}px;
    --ara-card-min-height: {{ section.settings.card_height }}px;
    --ara-card-gap: {{ section.settings.card_gap }}px;
    --ara-icon-height: {{ section.settings.icon_height }}px;
    --ara-mint-columns: {{ section.settings.desktop_columns }};
    --ara-mint-eyebrow-size: {{ section.settings.desktop_eyebrow_size }}px;
    --ara-mint-heading-size: {{ section.settings.desktop_heading_size }}px;
    --ara-mint-description-size: {{ section.settings.desktop_description_size }}px;
    --ara-mint-link-size: {{ section.settings.desktop_link_size }}px;
    --ara-domain-title-size: {{ section.settings.desktop_card_title_size }}px;
    --ara-domain-description-size: {{ section.settings.desktop_card_description_size }}px;
    --ara-domain-number-size: {{ section.settings.desktop_card_number_size }}px;
    --ara-domain-placeholder-size: {{ section.settings.desktop_placeholder_size }}px;
    --ara-domain-tab-size: {{ section.settings.desktop_tab_size }}px;
    --ara-domain-footer-size: {{ section.settings.desktop_footer_size }}px;
    --ara-mint-mobile-eyebrow-size: {{ section.settings.mobile_eyebrow_size }}px;
    --ara-mint-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --ara-mint-mobile-description-size: {{ section.settings.mobile_description_size }}px;
    --ara-mint-mobile-link-size: {{ section.settings.mobile_link_size }}px;
    --ara-mint-eyebrow-media-width: {{ section.settings.desktop_small_heading_media_width }}px;
    --ara-mint-mobile-eyebrow-media-width: {{ section.settings.mobile_small_heading_media_width }}px;
    --ara-domain-mobile-title-size: {{ section.settings.mobile_card_title_size }}px;
    --ara-domain-mobile-description-size: {{ section.settings.mobile_card_description_size }}px;
    --ara-domain-mobile-number-size: {{ section.settings.mobile_card_number_size }}px;
    --ara-domain-mobile-placeholder-size: {{ section.settings.mobile_placeholder_size }}px;
    --ara-domain-mobile-tab-size: {{ section.settings.mobile_tab_size }}px;
    --ara-domain-mobile-footer-size: {{ section.settings.mobile_footer_size }}px;
  "
>
  <div class="ara-mint-domains__inner">
    <div class="ara-mint-domains__intro-frame">
      <div class="ara-mint-domains__intro">
        {% case section.settings.small_heading_type %}
          {% when 'image' %}
            {% if section.settings.small_heading_image != blank %}
              <div class="ara-mint-domains__eyebrow-media ara-mint-domains__eyebrow-media--image">
                {{
                  section.settings.small_heading_image
                  | image_url: width: 700
                  | image_tag:
                    widths: '120, 180, 240, 360, 500, 700',
                    sizes: '(max-width: 749px) var(--ara-mint-mobile-eyebrow-media-width), var(--ara-mint-eyebrow-media-width)',
                    loading: 'lazy',
                    class: 'ara-mint-domains__eyebrow-image',
                    alt: section.settings.small_heading_image.alt
                }}
              </div>
            {% elsif section.settings.eyebrow != blank %}
              <p class="ara-mint-domains__eyebrow">
                {{ section.settings.eyebrow | escape }}
              </p>
            {% endif %}

          {% when 'svg' %}
            {% if section.settings.small_heading_svg != blank %}
              <div
                class="ara-mint-domains__eyebrow-media ara-mint-domains__eyebrow-media--svg"
                role="img"
                aria-label="{{ section.settings.small_heading_alt | default: section.settings.eyebrow | escape }}"
              >
                {{ section.settings.small_heading_svg }}
              </div>
            {% elsif section.settings.eyebrow != blank %}
              <p class="ara-mint-domains__eyebrow">
                {{ section.settings.eyebrow | escape }}
              </p>
            {% endif %}

          {% else %}
            {% if section.settings.eyebrow != blank %}
              <p class="ara-mint-domains__eyebrow">
                {{ section.settings.eyebrow | escape }}
              </p>
            {% endif %}
        {% endcase %}

        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="ara-mint-domains__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            class="ara-mint-domains__link"
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            {{ section.settings.button_label | escape }}
          </a>
        {% endif %}

        {% if section.settings.intro_note != blank %}
          <span class="ara-mint-domains__intro-note">
            {{ section.settings.intro_note | escape }}
          </span>
        {% endif %}
      </div>
    </div>

    <div class="ara-mint-domains__cards">
      {% for block in section.blocks %}
        {% liquid
          assign card_background = section.settings.card_color
          assign card_text = section.settings.text_color
          assign card_muted = section.settings.muted_text_color
          assign card_accent = block.settings.domain_color
          assign card_trim = block.settings.rule_color

          case block.settings.card_style
            when 'gold'
              assign card_background = section.settings.gold_color
              assign card_text = section.settings.text_color
              assign card_muted = section.settings.text_color
              assign card_accent = section.settings.text_color
              assign card_trim = block.settings.rule_color
            when 'blue'
              assign card_background = section.settings.blue_color
              assign card_text = '#FFFFFF'
              assign card_muted = '#FFFFFF'
              assign card_accent = section.settings.gold_color
              assign card_trim = section.settings.blue_deep_color
            when 'ink'
              assign card_background = section.settings.text_color
              assign card_text = section.settings.background_color
              assign card_muted = section.settings.background_color
              assign card_accent = section.settings.gold_color
              assign card_trim = section.settings.accent_color
            when 'mint'
              assign card_background = section.settings.accent_color
              assign card_text = '#FFFFFF'
              assign card_muted = '#FFFFFF'
              assign card_accent = section.settings.gold_color
              assign card_trim = section.settings.text_color
            when 'custom'
              assign card_background = block.settings.card_background
              assign card_text = block.settings.card_text_color
              assign card_muted = block.settings.card_text_color
              assign card_accent = block.settings.domain_color
              assign card_trim = block.settings.rule_color
          endcase
        %}

        {% if block.settings.link != blank %}
          <a
            href="{{ block.settings.link }}"
            class="ara-mint-domains__card-shell ara-mint-domains__card-shell--{{ block.settings.card_style }}"
            style="
              --ara-domain-bg: {{ card_background }};
              --ara-domain-text: {{ card_text }};
              --ara-domain-muted: {{ card_muted }};
              --ara-domain-color: {{ card_accent }};
              --ara-domain-rule: {{ card_trim }};
            "
            {{ block.shopify_attributes }}
          >
        {% else %}
          <article
            class="ara-mint-domains__card-shell ara-mint-domains__card-shell--{{ block.settings.card_style }}"
            style="
              --ara-domain-bg: {{ card_background }};
              --ara-domain-text: {{ card_text }};
              --ara-domain-muted: {{ card_muted }};
              --ara-domain-color: {{ card_accent }};
              --ara-domain-rule: {{ card_trim }};
            "
            {{ block.shopify_attributes }}
          >
        {% endif %}

          <div class="ara-mint-domains__card">
            {% if block.settings.tab_label != blank %}
              <span class="ara-mint-domains__tab">
                {{ block.settings.tab_label | escape }}
              </span>
            {% endif %}

            <span class="ara-mint-domains__corner-trim" aria-hidden="true"></span>

            <div class="ara-mint-domains__icon-frame">
              <div class="ara-mint-domains__icon-wrap">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 700
                    | image_tag:
                      widths: '180, 260, 360, 520, 700',
                      sizes: '(max-width: 749px) 110px, 140px',
                      loading: 'lazy',
                      class: 'ara-mint-domains__icon',
                      alt: block.settings.image.alt
                  }}
                {% else %}
                  <div class="ara-mint-domains__icon-placeholder">
                    <span>Upload image</span>
                  </div>
                {% endif %}
              </div>
            </div>

            <div class="ara-mint-domains__card-copy">
              <span class="ara-mint-domains__card-rule" aria-hidden="true"></span>

              <h3>{{ block.settings.title | escape }}</h3>

              {% if block.settings.description != blank %}
                <p>{{ block.settings.description | escape }}</p>
              {% endif %}
            </div>

            <div class="ara-mint-domains__footer">
              <span class="ara-mint-domains__number">
                {{ block.settings.number | escape }}
              </span>

              {% if block.settings.footer_label != blank %}
                <span class="ara-mint-domains__footer-label">
                  {{ block.settings.footer_label | escape }}
                </span>
              {% endif %}
            </div>
          </div>

        {% if block.settings.link != blank %}
          </a>
        {% else %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #AraMintDomains-{{ section.id }} {
    overflow: hidden;
    border-top: 1px solid var(--ara-mint-border);
    border-bottom: 1px solid var(--ara-mint-border);
    background-color: var(--ara-mint-bg);
    background-image:
      linear-gradient(
        90deg,
        transparent 0,
        transparent 31px,
        color-mix(in srgb, var(--ara-mint-line) 15%, transparent) 31px,
        color-mix(in srgb, var(--ara-mint-line) 15%, transparent) 32px
      ),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 34px,
        color-mix(in srgb, var(--ara-mint-line) 34%, transparent) 34px,
        color-mix(in srgb, var(--ara-mint-line) 34%, transparent) 35px
      );
    color: var(--ara-mint-text);
  }

  #AraMintDomains-{{ section.id }} * {
    box-sizing: border-box;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__inner {
    display: grid;
    grid-template-columns: minmax(300px, 0.72fr) minmax(0, 2.28fr);
    gap: clamp(38px, 4.5vw, 76px);
    align-items: stretch;
    width: min(100%, var(--ara-mint-max));
    margin: 0 auto;
    padding: var(--ara-mint-top) 40px var(--ara-mint-bottom);
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__intro-frame {
    position: relative;
    align-self: start;
    padding: 7px;
    border: 2px solid var(--ara-mint-text);
    border-radius: 22px;
    background: var(--ara-mint-bg);
    box-shadow:
      8px 8px 0 var(--ara-mint-gold),
      14px 14px 0 color-mix(in srgb, var(--ara-mint-accent) 70%, transparent);
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__intro {
    position: relative;
    display: flex;
    min-height: 100%;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding: clamp(34px, 4vw, 58px);
    border: 3px solid var(--ara-mint-text);
    border-radius: 15px;
    background:
      radial-gradient(
        circle at 105% 110%,
        color-mix(in srgb, var(--ara-mint-accent) 16%, transparent) 0 30%,
        transparent 31%
      ),
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--ara-mint-deep-bg) 82%, white),
        var(--ara-mint-bg)
      );
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__intro::before {
    content: "";
    position: absolute;
    top: 17px;
    right: 17px;
    width: 58px;
    height: 9px;
    border-top: 2px solid var(--ara-mint-text);
    border-bottom: 2px solid var(--ara-mint-text);
    opacity: 0.55;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__intro::after {
    content: "";
    position: absolute;
    right: 22px;
    bottom: 22px;
    width: 36px;
    height: 36px;
    border-right: 3px solid var(--ara-mint-accent);
    border-bottom: 3px solid var(--ara-mint-accent);
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__eyebrow {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-self: flex-start;
    margin: 0 0 22px;
    padding: 6px 11px;
    border: 2px solid var(--ara-mint-text);
    border-radius: 8px;
    background: var(--ara-mint-gold);
    color: var(--ara-mint-text);
    font-family: var(--font-body-family);
    font-size: var(--ara-mint-eyebrow-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    box-shadow: 3px 3px 0 var(--ara-mint-text);
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__eyebrow-media {
    position: relative;
    z-index: 1;
    display: block;
    width: var(--ara-mint-eyebrow-media-width);
    max-width: 100%;
    margin: 0 0 22px;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__eyebrow-image,
  #AraMintDomains-{{ section.id }} .ara-mint-domains__eyebrow-media svg {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__eyebrow-media--svg svg {
    overflow: visible;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__intro h2 {
    position: relative;
    z-index: 1;
    max-width: 470px;
    margin: 0;
    color: var(--ara-mint-text);
    font-family: var(--font-heading-family);
    font-size: var(--ara-mint-heading-size);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 0.94;
    letter-spacing: -0.05em;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__description {
    position: relative;
    z-index: 1;
    max-width: 390px;
    margin-top: 25px;
    color: var(--ara-mint-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-mint-description-size);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.65;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__description p {
    margin: 0;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-self: flex-start;
    margin-top: 31px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--ara-mint-accent);
    color: var(--ara-mint-accent);
    font-family: var(--font-body-family);
    font-size: var(--ara-mint-link-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.13em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__intro-note {
    position: relative;
    z-index: 1;
    display: block;
    margin-top: 60px;
    padding-top: 16px;
    border-top: 1px dashed color-mix(in srgb, var(--ara-mint-text) 35%, transparent);
    color: var(--ara-mint-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-domain-footer-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__cards {
    display: grid;
    grid-template-columns: repeat(var(--ara-mint-columns), minmax(0, 1fr));
    gap: var(--ara-card-gap);
    align-content: start;
    min-width: 0;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__card-shell {
    position: relative;
    min-width: 0;
    padding: 6px;
    border: 2px solid var(--ara-mint-text);
    border-radius: 19px;
    background: var(--ara-mint-bg);
    color: var(--ara-domain-text);
    text-decoration: none;
    box-shadow: 7px 7px 0 var(--ara-domain-rule);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__card-shell:hover {
    transform: translate(-3px, -3px);
    box-shadow: 10px 10px 0 var(--ara-domain-rule);
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__card {
    position: relative;
    display: flex;
    min-height: var(--ara-card-min-height);
    flex-direction: column;
    overflow: hidden;
    padding: 46px 24px 22px;
    border: 3px solid var(--ara-mint-text);
    border-radius: 13px;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--ara-domain-color) 10%, transparent),
        transparent 42%
      ),
      var(--ara-domain-bg);
    color: var(--ara-domain-text);
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__card::before {
    content: "";
    position: absolute;
    inset: 10px;
    border: 1px solid color-mix(in srgb, var(--ara-domain-text) 18%, transparent);
    border-radius: 7px;
    pointer-events: none;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__tab {
    position: absolute;
    z-index: 3;
    top: -1px;
    right: 20px;
    padding: 6px 12px 7px;
    border: 2px solid var(--ara-mint-text);
    border-top: 0;
    border-radius: 0 0 8px 8px;
    background: var(--ara-domain-color);
    color: var(--ara-domain-text);
    font-family: var(--font-body-family);
    font-size: var(--ara-domain-tab-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__card-shell--paper .ara-mint-domains__tab,
  #AraMintDomains-{{ section.id }} .ara-mint-domains__card-shell--gold .ara-mint-domains__tab {
    color: var(--ara-mint-text);
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__card-shell--blue .ara-mint-domains__tab,
  #AraMintDomains-{{ section.id }} .ara-mint-domains__card-shell--ink .ara-mint-domains__tab,
  #AraMintDomains-{{ section.id }} .ara-mint-domains__card-shell--mint .ara-mint-domains__tab {
    color: var(--ara-mint-text);
    background: var(--ara-mint-gold);
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__corner-trim {
    position: absolute;
    z-index: 2;
    top: 17px;
    left: 17px;
    width: 35px;
    height: 35px;
    border-top: 3px solid var(--ara-domain-color);
    border-left: 3px solid var(--ara-domain-color);
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__icon-frame {
    position: relative;
    z-index: 1;
    padding: 5px;
    border: 2px solid var(--ara-mint-text);
    border-radius: 15px;
    background: color-mix(in srgb, var(--ara-domain-bg) 85%, white);
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__icon-wrap {
    display: grid;
    min-height: calc(var(--ara-icon-height) + 28px);
    place-items: center;
    padding: 14px;
    border: 2px dashed color-mix(in srgb, var(--ara-domain-text) 45%, transparent);
    border-radius: 10px;
    background:
      repeating-linear-gradient(
        45deg,
        color-mix(in srgb, var(--ara-domain-color) 9%, transparent) 0 1px,
        transparent 1px 12px
      );
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__icon {
    display: block;
    width: auto;
    max-width: 140px;
    height: var(--ara-icon-height);
    object-fit: contain;
    object-position: center;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__icon-placeholder {
    display: grid;
    width: 110px;
    height: var(--ara-icon-height);
    place-items: center;
    border: 1px dashed var(--ara-domain-color);
    border-radius: 6px;
    color: var(--ara-domain-color);
    font-family: var(--font-body-family);
    font-size: var(--ara-domain-placeholder-size);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__card-copy {
    position: relative;
    z-index: 1;
    padding: 0 4px;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__card-rule {
    display: block;
    width: 74px;
    height: 3px;
    margin: 23px 0 18px;
    border-radius: 4px;
    background: var(--ara-domain-color);
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__card h3 {
    margin: 0;
    color: var(--ara-domain-text);
    font-family: var(--font-body-family);
    font-size: var(--ara-domain-title-size);
    font-style: var(--font-body-style);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__card p {
    margin: 14px 0 0;
    color: var(--ara-domain-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-domain-description-size);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.55;
    opacity: 0.78;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__footer {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-end;
    margin-top: auto;
    padding: 25px 4px 0;
    border-top: 1px dashed color-mix(in srgb, var(--ara-domain-text) 38%, transparent);
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__number {
    color: var(--ara-domain-color);
    font-family: var(--font-heading-family);
    font-size: var(--ara-domain-number-size);
    font-style: var(--font-heading-style);
    font-weight: 800;
    line-height: 0.9;
  }

  #AraMintDomains-{{ section.id }} .ara-mint-domains__footer-label {
    max-width: 120px;
    color: var(--ara-domain-muted);
    font-family: var(--font-body-family);
    font-size: var(--ara-domain-footer-size);
    font-style: var(--font-body-style);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.1em;
    text-align: right;
    text-transform: uppercase;
    opacity: 0.72;
  }

  @media screen and (max-width: 1240px) {
    #AraMintDomains-{{ section.id }} .ara-mint-domains__inner {
      grid-template-columns: 1fr;
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__intro-frame {
      max-width: 720px;
    }
  }

  @media screen and (max-width: 989px) {
    #AraMintDomains-{{ section.id }} .ara-mint-domains__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #AraMintDomains-{{ section.id }} .ara-mint-domains__inner {
      gap: 38px;
      padding-right: 20px;
      padding-left: 20px;
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__intro-frame {
      box-shadow:
        5px 5px 0 var(--ara-mint-gold),
        10px 10px 0 color-mix(in srgb, var(--ara-mint-accent) 65%, transparent);
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__intro {
      padding: 34px 26px 38px;
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__eyebrow {
      font-size: var(--ara-mint-mobile-eyebrow-size);
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__eyebrow-media {
      width: var(--ara-mint-mobile-eyebrow-media-width);
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__intro h2 {
      font-size: var(--ara-mint-mobile-heading-size);
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__description {
      font-size: var(--ara-mint-mobile-description-size);
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__link {
      font-size: var(--ara-mint-mobile-link-size);
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__intro-note {
      margin-top: 44px;
      font-size: var(--ara-domain-mobile-footer-size);
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__cards {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__card-shell {
      box-shadow: 5px 5px 0 var(--ara-domain-rule);
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__card {
      min-height: 0;
      padding: 44px 21px 21px;
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__icon {
      max-width: 120px;
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__icon-placeholder {
      font-size: var(--ara-domain-mobile-placeholder-size);
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__tab {
      font-size: var(--ara-domain-mobile-tab-size);
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__card h3 {
      font-size: var(--ara-domain-mobile-title-size);
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__card p {
      font-size: var(--ara-domain-mobile-description-size);
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__number {
      font-size: var(--ara-domain-mobile-number-size);
    }

    #AraMintDomains-{{ section.id }} .ara-mint-domains__footer-label {
      font-size: var(--ara-domain-mobile-footer-size);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #AraMintDomains-{{ section.id }} .ara-mint-domains__card-shell {
      transition: none;
    }
  }
</style>

