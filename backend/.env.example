# --- Railway Postgres ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mintmark

# --- Service ---
NODE_ENV=development
PORT=3001
SERVICE=api
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (use a restricted key rk_test_ / rk_live_, not a full sk_ key) ---
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Lulu Print API (sandbox: https://api.sandbox.lulu.com) ---
LULU_API_BASE=https://api.sandbox.lulu.com
LULU_CLIENT_KEY=replace_me
LULU_CLIENT_SECRET=replace_me
LULU_CONTACT_EMAIL=ops@example.com

# Optional: HMAC uses LULU_CLIENT_SECRET by default
# LULU_WEBHOOK_SECRET=

# Optional: extra handling cents added on top of Lulu shipping when quoting
# SHIPPING_HANDLING_CENTS=0
