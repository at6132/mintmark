# --- Postgres ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mintmark
DB_POOL_MAX=

# --- Service ---
NODE_ENV=development
PORT=3001
SERVICE=api
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# --- Stripe ---
# Optional until checkout testing. Restricted key (rk_test_ / rk_live_), not a full sk_ key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Lulu Print API ---
# Optional until shipping/print testing. Sandbox: https://api.sandbox.lulu.com  Production: https://api.lulu.com
# Host must be api.lulu.com or api.sandbox.lulu.com
LULU_API_BASE=https://api.sandbox.lulu.com
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_CONTACT_EMAIL=
# Lulu signs webhooks with your API client secret. Optional override if you store a copy separately.
LULU_WEBHOOK_SECRET=
LULU_FALLBACK_PHONE=

SHIPPING_HANDLING_CENTS=0

# --- Railway / S3-compatible bucket (interior + cover PDFs) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Admin desk (/admin + /v1/admin) ---
# PIN is checked first. If it matches, both operator phones get a WhatsApp
# from the Meta Cloud API test number. Either phone replies /allow or /deny.
ADMIN_PIN=
# Optional break-glass bearer token for scripts. Leave empty in normal use.
ADMIN_API_TOKEN=
# E.164, comma-separated. ONLY these WhatsApp accounts can /allow.
ADMIN_WHATSAPP_NUMBERS=+15555550100,+15555550101

# Meta WhatsApp Cloud API (free test number, up to 5 recipients)
# developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Random string you invent. Meta sends it on webhook GET to prove the URL is yours.
WHATSAPP_VERIFY_TOKEN=
# App secret from App settings → Basic. Signs inbound webhook POSTs.
WHATSAPP_APP_SECRET=
# Webhook callback URL (must be public https):
# https://<backend-host>/v1/webhooks/whatsapp
# Subscribe to the "messages" field.
